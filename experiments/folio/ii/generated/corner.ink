ine":[{"kind":"text","text":"• Review"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Repository"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Archive"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b6-0-ii-style/bold-11","type":"style/bold","start":0,"end":6}]},"inline":[{"kind":"text","text":"Licence"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b7-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Authors of JOSS papers retain copyright and release the work un-der a Creative Commons Attri-bution 4.0 International License (CC-BY)."}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"corner.py: Scatterplot matrices in Python"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b9-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b9-0-ii-style/bold-2","type":"style/bold","start":0,"end":21}]},"inline":[{"kind":"text","text":"Daniel Foreman-Mackey1"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b10-0-ii-style/bold-4","type":"style/bold","start":0,"end":39}]},"inline":[{"kind":"text","text":"1 Sagan Fellow, University of Washington"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b11-0-ii-style/bold-7","type":"style/bold","start":0,"end":6}]},"inline":[{"kind":"text","text":"Summary"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-ii-style/italics-21","type":"style/italics","start":230,"end":263}]},"inline":[{"kind":"text","text":"This Python module uses matplotlib (Hunter 2007) to visualize multidimensional samples using a scatterplot matrix. In these visualizations, each one- and two-dimensional pro-jection of the sample is plotted to reveal covariances. corner was originally conceived to display the results of Markov Chain Monte Carlo simulations and the defaults are chosen with this application in mind but it can be used for displaying many qualitatively different samples."}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-ii-style/italics-38","type":"style/italics","start":98,"end":103}]},"inline":[{"kind":"text","text":"Development of corner happens on GitHub and any issues can be raised there (Foreman-Mackey 2016). corner has been used extensively in the astronomical literature and it has occasionally been cited as corner.py or using its previous name triangle.py. The source code for corner has been archived to Zenodo and it has the DOI (Zenodo Archive 2016)"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-2-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The following is a simple demonstration of a visualization made with corner:"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b13-0-ii-style/bold-49","type":"style/bold","start":0,"end":9}]},"inline":[{"kind":"text","text":"References"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b14-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Foreman-Mackey, Daniel. 2016. \"Corner.py on Github.\" https://github.com/dfm/corner. py."}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b15-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b15-0-ii-style/italics-53","type":"style/italics","start":63,"end":82},{"id":"folio-0569cd3d34fd1dcab25b-p1-b15-0-ii-style/italics-54","type":"style/italics","start":84,"end":138}]},"inline":[{"kind":"text","text":"Hunter, John D. 2007. \"Matplotlib: A 2d Graphics Environment.\" Computing in Science and Engineering 9 (3): 90-95. doi:10.1109/MCSE.2007.55."}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b15-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Zenodo Archive. 2016. \"Corner.py: Scatterplot Matrices in Python.\" http://dx.doi.org/ 10.5281/zenodo.53155. doi:10.5281/zenodo.53155."}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b17-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Foreman-Mackey, (2016). corner.py: Scatterplot matrices in Python. Journal of Open Source Software, 1(2), 24, doi:10.21105/joss.00024 1"}]},{"id":"folio-0569cd3d34fd1dcab25b-p2-p2_1-ii","type":"image-block","properties":{"metadata":{"url":"/experiments/folio/generated/images/2828f3c81cf2392e90a07d528e5cee2acc550fd8dd3df1930f3e3147af4e98cd.png","alt":"Extracted image p2_1","folio":{"$codexHistoryValue":["undefined"]}},"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}]}},{"id":"folio-0569cd3d34fd1dcab25b-p2-p2_2-ii","type":"image-block","properties":{"metadata":{"url":"/experiments/folio/generated/images/3c7e37e331c4d422ad8879d0ccbb2b6d31c8d8a47d0bcba5b56ec4e1e2e084de.png","alt":"Extracted image p2_2","folio":{"$codexHistoryValue":["undefined"]}},"blockProperties":[{"type":"block/size","metadata":{"width":"515px"}}]}},{"id":"folio-0569cd3d34fd1dcab25b-p2-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p2-b2-0-ii-style/bold-0","type":"style/bold","start":0,"end":8}]},"inline":[{"kind":"text","text":"Figure 1: A scatterplot matrix generated by corner."}]},{"id":"folio-0569cd3d34fd1dcab25b-p2-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Foreman-Mackey, (2016). corner.py: Scatterplot matrices in Python. Journal of Open Source Software, 1(2), 24, doi:10.21105/joss.00024 2"}]}]},"definitionOwnerBlockIds":[]}
