-987545ffb087f1ece898-p16-b6-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b7-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b7-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b8-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b8-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b10-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b10-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b11-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b11-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b12-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b12-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b14-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b14-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b15-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b15-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b16-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b16-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b17-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b17-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b18-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b18-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b19-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b19-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b20-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b20-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b21-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b21-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b22-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b22-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b23-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b23-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b23-1-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b23-1-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b24-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b24-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b25-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b25-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b26-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b26-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b27-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b27-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b28-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b28-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p16-b22-1-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p16-b22-1-ii"}}]},{"id":"folio-987545ffb087f1ece898-p1-b0-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p1-b0-0-ii-style/bold-0","type":"style/bold","start":0,"end":56},{"id":"folio-987545ffb087f1ece898-p1-b0-0-ii-style/bold-1","type":"style/bold","start":58,"end":79}]},"inline":[{"kind":"text","text":"BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding"}]},{"id":"folio-987545ffb087f1ece898-p1-b1-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p1-b1-0-ii-style/bold-2","type":"style/bold","start":0,"end":11},{"id":"folio-987545ffb087f1ece898-p1-b1-0-ii-style/bold-3","type":"style/bold","start":13,"end":26},{"id":"folio-987545ffb087f1ece898-p1-b1-0-ii-style/bold-4","type":"style/bold","start":28,"end":37},{"id":"folio-987545ffb087f1ece898-p1-b1-0-ii-style/bold-5","type":"style/bold","start":39,"end":56}]},"inline":[{"kind":"text","text":"Jacob Devlin Ming-Wei Chang Kenton Lee Kristina Toutanova"}]},{"id":"folio-987545ffb087f1ece898-p1-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Google AI Language {jacobdevlin,mingweichang,kentonl,kristout}@google.com"}]},{"id":"folio-987545ffb087f1ece898-p1-b3-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p1-b3-0-ii-style/bold-8","type":"style/bold","start":0,"end":7}]},"inline":[{"kind":"text","text":"Abstract"}]},{"id":"folio-987545ffb087f1ece898-p1-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We introduce a new language representa-tion model called BERT, which stands for Bidirectional Encoder Representations from Transformers. Unlike recent language repre-sentation models (Peters et al., 2018a; Rad-ford et al., 2018), BERT is designed to pre-train deep bidirectional representations from unlabeled text by jointly conditioning on both left and right context in all layers. As a re-sult, the pre-trained BERT model can be fine-tuned with just one additional output layer to create state-of-the-art models for a wide range of tasks, such as question answering and language inference, without substantial task-specific architecture modifications. BERT is conceptually simple and empirically powerful. It obtains new state-of-the-art re-sults on eleven natural language processing tasks, including pushing the GLUE score to 80.5% (7.7% point absolute improvement), MultiNLI accuracy to 86.7% (4.6% absolute improvement), SQuAD v1.1 question answer-ing Test F1 to 93.2 (1.5 point absolute im-provement) and SQuAD v2.0 Test F1 to 83.1 (5.1 point absolute improvement)."}]},{"id":"folio-987545ffb087f1ece898-p1-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p1-b5-0-ii-style/bold-146","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p1-b5-0-ii-style/bold-147","type":"style/bold","start":2,"end":13}]},"inline":[{"kind":"text","text":"1 Introduction"}]},{"id":"folio-987545ffb087f1ece898-p1-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Language model pre-training has been shown to be effective for improving many natural language processing tasks (Dai and Le, 2015; Peters et al., 2018a; Radford et al., 2018; Howard and Ruder, 2018). These include sentence-level tasks such as natural language inference (Bowman et al., 2015; Williams et al., 2018) and paraphrasing (Dolan and Brockett, 2005), which aim to predict the re-lationships between sentences by analyzing them holistically, as well as token-level tasks such as named entity recognition and question answering, where models are required to produce fine-grained output at the token level (Tjong Kim Sang and De Meulder, 2003; Rajpurkar et al., 2016)."}]},{"id":"folio-987545ffb087f1ece898-p1-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"There are two existing strategies for apply-ing pre-trained language representations to down-stream tasks: feature-based and fine-tuning. The feature-based approach, such as ELMo (Peters et al., 2018a), uses task-specific architectures that include the pre-trained representations as addi-tional features. The fine-tuning approach, such as the Generative Pre-trained Transformer (OpenAI GPT) (Radford et al., 2018), introduces minimal task-specific parameters, and is trained on the downstream tasks by simply fine-tuning all pre-trained parameters. The two approaches share the same objective function during pre-training, where they use unidirectional language models to learn general language representations."}]},{"id":"folio-987545ffb087f1ece898-p1-b14-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We argue that current techniques restrict the power of the pre-trained representations, especially for the fine-tuning approaches. The ma-jor limitation is that standard language models are unidirectional, and this limits the choice of archi-tectures that can be used during pre-training. For example, in OpenAI GPT, the authors use a left-to-right architecture, where every token can only at-tend to previous tokens in the self-attention layers of the Transformer (Vaswani et al., 2017). Such re-strictions are sub-optimal for sentence-level tasks, and could be very harmful when applying fine-tuning based approaches to token-level tasks such as question answering, where it is crucial to incor-porate context from both directions."}]},{"id":"folio-987545ffb087f1ece898-p1-b15-0-ii-part1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In this paper, we improve the fine-tuning based approaches by proposing BERT: Bidirectional Encoder Representations from Transformers. BERT alleviates the previously mentioned unidi-rectionality constraint by using a \"masked lan-guage model\" (MLM) pre-training objective, in-spired by the Cloze task (Taylor, 1953). The masked language model randomly masks some of the tokens from the input, and the objective is to predict the original vocabulary id of the masked word based only on its context. Unlike left-to-right language model pre-training, the MLM ob-jective enables the representation to fuse the left and the right context, which allows us to pre-train a deep bidirectional Transformer. In addi-tion to the masked language model, we also use a \"next sentence prediction\" task that jointly pre-trains text-pair representations. The contributions of our paper are as follows:"}]},{"id":"folio-987545ffb087f1ece898-p1-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4171"}]},{"id":"folio-987545ffb087f1ece898-p1-b16-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Proceedings of NAACL-HLT 2019, pages 4171-4186"}]},{"id":"folio-987545ffb087f1ece898-p1-b17-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Minneapolis, Minnesota, June 2 - June 7, 2019. c 2019 Association for Computational Linguistics"}]},{"id":"folio-987545ffb087f1ece898-p2-b1-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• We demonstrate the importance of bidirectional pre-training for language representations. Un-like Radford et al. (2018), which uses unidirec-tional language models for pre-training, BERT uses masked language models to enable pre-trained deep bidirectional representations. This is also in contrast to Peters et al. (2018a), which uses a shallow concatenation of independently trained left-to-right and right-to-left LMs."}]},{"id":"folio-987545ffb087f1ece898-p2-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• We show that pre-trained representations reduce the need for many heavily-engineered task-specific architectures. BERT is the first fine-tuning based representation model that achieves state-of-the-art performance on a large suite of sentence-level and token-level tasks, outper-forming many task-specific architectures."}]},{"id":"folio-987545ffb087f1ece898-p2-b3-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• BERT advances the state of the art for eleven NLP tasks. The code and pre-trained mod-els are available at https://github.com/ google-research/bert."}]},{"id":"folio-987545ffb087f1ece898-p2-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b4-0-ii-style/bold-139","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p2-b4-0-ii-style/bold-140","type":"style/bold","start":2,"end":13}]},"inline":[{"kind":"text","text":"2 Related Work"}]},{"id":"folio-987545ffb087f1ece898-p2-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"There is a long history of pre-training general lan-guage representations, and we briefly review the most widely-used approaches in this section."}]},{"id":"folio-987545ffb087f1ece898-p2-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b6-0-ii-style/bold-154","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p2-b6-0-ii-style/bold-155","type":"style/bold","start":4,"end":40}]},"inline":[{"kind":"text","text":"2.1 Unsupervised Feature-based Approaches"}]},{"id":"folio-987545ffb087f1ece898-p2-b7-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Learning widely applicable representations of words has been an active area of research for decades, including non-neural (Brown et al., 1992; Ando and Zhang, 2005; Blitzer et al., 2006) and neural (Mikolov et al., 2013; Pennington et al., 2014) methods. Pre-trained word embeddings are an integral part of modern NLP systems, of-fering significant improvements over embeddings learned from scratch (Turian et al., 2010). To pre-train word embedding vectors, left-to-right lan-guage modeling objectives have been used (Mnih and Hinton, 2009), as well as objectives to dis-criminate correct from incorrect words in left and right context (Mikolov et al., 2013)."}]},{"id":"folio-987545ffb087f1ece898-p2-b9-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"These approaches have been generalized to coarser granularities, such as sentence embed-dings (Kiros et al., 2015; Logeswaran and Lee, 2018) or paragraph embeddings (Le and Mikolov, 2014). To train sentence representations, prior work has used objectives to rank candidate next sentences (Jernite et al., 2017; Logeswaran and Lee, 2018), left-to-right generation of next sen-tence words given a representation of the previous sentence (Kiros et al., 2015), or denoising auto-encoder derived objectives (Hill et al., 2016). ELMo and its predecessor (Peters et al., 2017, 2018a) generalize traditional word embedding re-search along a different dimension. They extract context-sensitive features from a left-to-right and a right-to-left language model. The contextual rep-resentation of each token is the concatenation of the left-to-right and right-to-left representations."}]},{"id":"folio-987545ffb087f1ece898-p2-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"When integrating contextual word embeddings with existing task-specific architectures, ELMo advances the state of the art for several major NLP benchmarks (Peters et al., 2018a) including ques-tion answering (Rajpurkar et al., 2016), sentiment analysis (Socher et al., 2013), and named entity recognition (Tjong Kim Sang and De Meulder, 2003). Melamud et al. (2016) proposed learning contextual representations through a task to pre-dict a single word from both left and right context using LSTMs. Similar to ELMo, their model is feature-based and not deeply bidirectional. Fedus et al. (2018) shows that the cloze task can be used to improve the robustness of text generation mod-els."}]},{"id":"folio-987545ffb087f1ece898-p2-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b12-0-ii-style/bold-145","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p2-b12-0-ii-style/bold-146","type":"style/bold","start":4,"end":38}]},"inline":[{"kind":"text","text":"2.2 Unsupervised Fine-tuning Approaches"}]},{"id":"folio-987545ffb087f1ece898-p2-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"As with the feature-based approaches, the first works in this direction only pre-trained word em-bedding parameters from unlabeled text (Col-lobert and Weston, 2008). More recently, sentence or document encoders which produce contextual token representations have been pre-trained from unlabeled text and fine-tuned for a supervised downstream task (Dai and Le, 2015; Howard and Ruder, 2018; Radford et al., 2018). The advantage of these approaches is that few parameters need to be learned from scratch. At least partly due to this advantage, OpenAI GPT (Radford et al., 2018) achieved pre-viously state-of-the-art results on many sentence-level tasks from the GLUE benchmark (Wang et al., 2018a). Left-to-right language model-"}]},{"id":"folio-987545ffb087f1ece898-p2-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4172"}]},{"id":"folio-987545ffb087f1ece898-ii-figure-1","type":"image-block","properties":{"asset":{"kind":"managed","cavernId":"folio-ii-study","assetId":"sha256:6e9894570d421c151e7dd0d2a47f6031ff1f85304e13d4f1b19497012e29fbbf"},"metadata":{"alt":"BERT pre-training and fine-tuning architectures","captionId":"folio-987545ffb087f1ece898-p3-b2-0-ii","labels":["NSP Mask LM Mask LM MNLI NER SQuAD Start/End Span C T1 ... T N T[SEP] T1' ... T M' C T1 ... T N T[SEP] T1' ... T M' BERT BERT BERT E[CLS] E1 ... EN E[SEP] E1' ... EM' E[CLS] E1 ... EN E[SEP] E1' ... EM'","[CLS] Tok 1 ... Tok N [SEP] Tok 1 ... TokM [CLS] Tok 1 ... Tok N [SEP] Tok 1 ... TokM Masked Sentence A Masked Sentence B Question Paragraph Unlabeled Sentence A and B Pair Question Answer Pair","Pre-training Fine-Tuning"]},"blockProperties":[{"type":"block/size","metadata":{"width":"608px"}}]}},{"id":"folio-987545ffb087f1ece898-p3-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Figure 1: Overall pre-training and fine-tuning procedures for BERT. Apart from output layers, the same architec-tures are used in both pre-training and fine-tuning. The same pre-trained model parameters are used to initialize models for different down-stream tasks. During fine-tuning, all parameters are fine-tuned. [CLS] is a special symbol added in front of every input example, and [SEP] is a special separator token (e.g. separating ques-tions/answers)."}]},{"id":"folio-987545ffb087f1ece898-p3-b3-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"ing and auto-encoder objectives have been used for pre-training such models (Howard and Ruder, 2018; Radford et al., 2018; Dai and Le, 2015)."}]},{"id":"folio-987545ffb087f1ece898-p3-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p3-b4-0-ii-style/bold-86","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p3-b4-0-ii-style/bold-87","type":"style/bold","start":4,"end":41}]},"inline":[{"kind":"text","text":"2.3 Transfer Learning from Supervised Data"}]},{"id":"folio-987545ffb087f1ece898-p3-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"There has also been work showing effective trans-fer from supervised tasks with large datasets, such as natural language inference (Conneau et al., 2017) and machine translation (McCann et al., 2017). Computer vision research has also demon-strated the importance of transfer learning from large pre-trained models, where an effective recipe is to fine-tune models pre-trained with Ima-geNet (Deng et al., 2009; Yosinski et al., 2014)."}]},{"id":"folio-987545ffb087f1ece898-p3-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p3-b6-0-ii-style/bold-139","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p3-b6-0-ii-style/bold-140","type":"style/bold","start":2,"end":5}]},"inline":[{"kind":"text","text":"3 BERT"}]},{"id":"folio-987545ffb087f1ece898-p3-b7-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We introduce BERT and its detailed implementa-tion in this section. There are two steps in our framework: pre-training and fine-tuning. Dur-ing pre-training, the model is trained on unlabeled data over different pre-training tasks. For fine-tuning, the BERT model is first initialized with the pre-trained parameters, and all of the param-eters are fine-tuned using labeled data from the downstream tasks. Each downstream task has sep-arate fine-tuned models, even though they are ini-tialized with the same pre-trained parameters. The question-answering example in Figure 1 will serve as a running example for this section. A distinctive feature of BERT is its unified ar-chitecture across different tasks. There is mini-"}]},{"id":"folio-987545ffb087f1ece898-p3-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"mal difference between the pre-trained architec-ture and the final downstream architecture."}]},{"id":"folio-987545ffb087f1ece898-p3-b8-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Model Architecture BERT's model architec-ture is a multi-layer bidirectional Transformer en-coder based on the original implementation de-scribed in Vaswani et al. (2017) and released in the tensor2tensor library.1 Because the use of Transformers has become common and our im-plementation is almost identical to the original, we will omit an exhaustive background descrip-tion of the model architecture and refer readers to Vaswani et al. (2017) as well as excellent guides such as \"The Annotated Transformer.\"2 In this work, we denote the number of layers (i.e., Transformer blocks) as L, the hidden size as H, and the number of self-attention heads as A.3 We primarily report results on two model sizes: BERT BASE (L=12, H=768, A=12, Total Param-eters=110M) and BERT LARGE (L=24, H=1024, A=16, Total Parameters=340M). BERT BASE was chosen to have the same model size as OpenAI GPT for comparison purposes. Critically, however, the BERT Transformer uses bidirectional self-attention, while the GPT Trans-former uses constrained self-attention where every token can only attend to context to its left.4"}]},{"id":"folio-987545ffb087f1ece898-p3-b9-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1https://github.com/tensorflow/tensor2tensor"}]},{"id":"folio-987545ffb087f1ece898-p3-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"2http://nlp.seas.harvard.edu/2018/04/03/attention.html 3In all cases we set the feed-forward/filter size to be 4H, i.e., 3072 for the H = 768 and 4096 for the H = 1024."}]},{"id":"folio-987545ffb087f1ece898-p3-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4We note that in the literature the bidirectional Trans-"}]},{"id":"folio-987545ffb087f1ece898-p3-b8-2-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4173"}]},{"id":"folio-987545ffb087f1ece898-p4-b0-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Input/Output Representations To make BERT handle a variety of down-stream tasks, our input representation is able to unambiguously represent both a single sentence and a pair of sentences (e.g., h Question, Answeri) in one token sequence. Throughout this work, a \"sentence\" can be an arbi-trary span of contiguous text, rather than an actual linguistic sentence. A \"sequence\" refers to the in-put token sequence to BERT, which may be a sin-gle sentence or two sentences packed together."}]},{"id":"folio-987545ffb087f1ece898-p4-b1-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We use WordPiece embeddings (Wu et al., 2016) with a 30,000 token vocabulary. The first token of every sequence is always a special clas-sification token ([CLS]). The final hidden state corresponding to this token is used as the ag-gregate sequence representation for classification tasks. Sentence pairs are packed together into a single sequence. We differentiate the sentences in two ways. First, we separate them with a special token ([SEP]). Second, we add a learned embed-ding to every token indicating whether it belongs to sentence A or sentence B. As shown in Figure 1, we denote input embedding as E, the final hidden vector of the special [CLS] token as $C\\in \\mathbb{R}^{H}$, and the final hidden vector for the $i^{th}$ input token as $T_{i}\\in \\mathbb{R}^{H}$ ."}]},{"id":"folio-987545ffb087f1ece898-p4-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"For a given token, its input representation is constructed by summing the corresponding token, segment, and position embeddings. A visualiza-tion of this construction can be seen in Figure 2."}]},{"id":"folio-987545ffb087f1ece898-p4-b3-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p4-b3-0-ii-style/bold-114","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p4-b3-0-ii-style/bold-115","type":"style/bold","start":4,"end":20}]},"inline":[{"kind":"text","text":"3.1 Pre-training BERT"}]},{"id":"folio-987545ffb087f1ece898-p4-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Unlike Peters et al. (2018a) and Radford et al. (2018), we do not use traditional left-to-right or right-to-left language models to pre-train BERT. Instead, we pre-train BERT using two unsuper-vised tasks, described in this section. This step is presented in the left part of Figure 1."}]},{"id":"folio-987545ffb087f1ece898-p4-b4-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Task #1: Masked LM Intuitively, it is reason-able to believe that a deep bidirectional model is strictly more powerful than either a left-to-right model or the shallow concatenation of a left-to-right and a right-to-left model. Unfortunately, standard conditional language models can only be trained left-to-right or right-to-left, since bidirec-tional conditioning would allow each word to in-directly \"see itself\", and the model could trivially predict the target word in a multi-layered context."}]},{"id":"folio-987545ffb087f1ece898-p4-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"former is often referred to as a \"Transformer encoder\" while the left-context-only version is referred to as a \"Transformer decoder\" since it can be used for text generation."}]},{"id":"folio-987545ffb087f1ece898-p4-b7-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In order to train a deep bidirectional representa-tion, we simply mask some percentage of the input tokens at random, and then predict those masked tokens. We refer to this procedure as a \"masked LM\" (MLM), although it is often referred to as a Cloze task in the literature (Taylor, 1953). In this case, the final hidden vectors corresponding to the mask tokens are fed into an output softmax over the vocabulary, as in a standard LM. In all of our experiments, we mask 15% of all WordPiece to-kens in each sequence at random. In contrast to denoising auto-encoders (Vincent et al., 2008), we only predict the masked words rather than recon-structing the entire input."}]},{"id":"folio-987545ffb087f1ece898-p4-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Although this allows us to obtain a bidirec-tional pre-trained model, a downside is that we are creating a mismatch between pre-training and fine-tuning, since the [MASK] token does not ap-pear during fine-tuning. To mitigate this, we do not always replace \"masked\" words with the ac-tual [MASK] token. The training data generator chooses 15% of the token positions at random for prediction. If the i-th token is chosen, we replace the i-th token with (1) the [MASK] token 80% of the time (2) a random token 10% of the time (3) the unchanged i-th token 10% of the time. Then, $T_{i}$ will be used to predict the original token with cross entropy loss. We compare variations of this procedure in Appendix C.2."}]},{"id":"folio-987545ffb087f1ece898-p4-b9-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p4-b9-0-ii-style/bold-108","type":"style/bold","start":0,"end":3},{"id":"folio-987545ffb087f1ece898-p4-b9-0-ii-style/bold-109","type":"style/bold","start":5,"end":7},{"id":"folio-987545ffb087f1ece898-p4-b9-0-ii-style/bold-110","type":"style/bold","start":9,"end":12},{"id":"folio-987545ffb087f1ece898-p4-b9-0-ii-style/bold-111","type":"style/bold","start":14,"end":21},{"id":"folio-987545ffb087f1ece898-p4-b9-0-ii-style/bold-112","type":"style/bold","start":23,"end":32},{"id":"folio-987545ffb087f1ece898-p4-b9-0-ii-style/bold-113","type":"style/bold","start":34,"end":38}]},"inline":[{"kind":"text","text":"Task #2: Next Sentence Prediction (NSP)"}]},{"id":"folio-987545ffb087f1ece898-p4-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Many important downstream tasks such as Ques-tion Answering (QA) and Natural Language Infer-ence (NLI) are based on understanding the rela-tionship between two sentences, which is not di-rectly captured by language modeling. In order to train a model that understands sentence rela-tionships, we pre-train for a binarized next sen-tence prediction task that can be trivially gener-ated from any monolingual corpus. Specifically, when choosing the sentences A and B for each pre-training example, 50% of the time B is the actual next sentence that follows A (labeled as IsNext), and 50% of the time it is a random sentence from the corpus (labeled as NotNext). As we show in Figure 1, C is used for next sentence predic-tion (NSP).5 Despite its simplicity, we demon-strate in Section 5.1 that pre-training towards this task is very beneficial to both QA and NLI. 6"}]},{"id":"folio-987545ffb087f1ece898-p4-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"5The final model achieves 97%-98% accuracy on NSP."}]},{"id":"folio-987545ffb087f1ece898-p4-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"6The vector C is not a meaningful sentence representation without fine-tuning, since it was trained with NSP."}]},{"id":"folio-987545ffb087f1ece898-p4-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4174"}]},{"id":"folio-987545ffb087f1ece898-p5-b0-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Input my dog is cute [SEP] he likes play ##ing [SEP]"}]},{"id":"folio-987545ffb087f1ece898-p5-b1-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"[CLS] E[CLS] E my E dog E is E cute E[SEP] E he E likes E play E## E[SEP] EA E A E A E A E A E A E B E B E B E B E B E0 E1 E2 E3 E4 E5 E6 E7 E8 E9 E10"}]},{"id":"folio-987545ffb087f1ece898-p5-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"TokenEmbeddings ing SegmentEmbeddings"}]},{"id":"folio-987545ffb087f1ece898-p5-b2-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"PositionEmbeddings"}]},{"id":"folio-987545ffb087f1ece898-p5-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Figure 2: BERT input representation. The input embeddings are the sum of the token embeddings, the segmenta-tion embeddings and the position embeddings."}]},{"id":"folio-987545ffb087f1ece898-p5-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The NSP task is closely related to representation-learning objectives used in Jernite et al. (2017) and Logeswaran and Lee (2018). However, in prior work, only sentence embeddings are transferred to down-stream tasks, where BERT transfers all pa-rameters to initialize end-task model parameters."}]},{"id":"folio-987545ffb087f1ece898-p5-b6-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Pre-training data The pre-training procedure largely follows the existing literature on language model pre-training. For the pre-training corpus we use the BooksCorpus (800M words) (Zhu et al., 2015) and English Wikipedia (2,500M words). For Wikipedia we extract only the text passages and ignore lists, tables, and headers. It is criti-cal to use a document-level corpus rather than a shuffled sentence-level corpus such as the Billion Word Benchmark (Chelba et al., 2013) in order to extract long contiguous sequences."}]},{"id":"folio-987545ffb087f1ece898-p5-b7-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b7-0-ii-style/bold-117","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p5-b7-0-ii-style/bold-118","type":"style/bold","start":4,"end":19}]},"inline":[{"kind":"text","text":"3.2 Fine-tuning BERT"}]},{"id":"folio-987545ffb087f1ece898-p5-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Fine-tuning is straightforward since the self-attention mechanism in the Transformer al-lows BERT to model many downstream tasks-whether they involve single text or text pairs-by swapping out the appropriate inputs and outputs. For applications involving text pairs, a common pattern is to independently encode text pairs be-fore applying bidirectional cross attention, such as Parikh et al. (2016); Seo et al. (2017). BERT instead uses the self-attention mechanism to unify these two stages, as encoding a concatenated text pair with self-attention effectively includes bidi-rectional cross attention between two sentences."}]},{"id":"folio-987545ffb087f1ece898-p5-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"For each task, we simply plug in the task-specific inputs and outputs into BERT and fine-tune all the parameters end-to-end. At the in-put, sentence A and sentence B from pre-training are analogous to (1) sentence pairs in paraphras-ing, (2) hypothesis-premise pairs in entailment, (3) question-passage pairs in question answering, and"}]},{"id":"folio-987545ffb087f1ece898-p5-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"(4) a degenerate text-∅ pair in text classification or sequence tagging. At the output, the token rep-resentations are fed into an output layer for token-level tasks, such as sequence tagging or question answering, and the [CLS] representation is fed into an output layer for classification, such as en-tailment or sentiment analysis."}]},{"id":"folio-987545ffb087f1ece898-p5-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Compared to pre-training, fine-tuning is rela-tively inexpensive. All of the results in the pa-per can be replicated in at most 1 hour on a sin-gle Cloud TPU, or a few hours on a GPU, starting from the exact same pre-trained model.7 We de-scribe the task-specific details in the correspond-ing subsections of Section 4. More details can be found in Appendix A.5."}]},{"id":"folio-987545ffb087f1ece898-p5-b14-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b14-0-ii-style/bold-113","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p5-b14-0-ii-style/bold-114","type":"style/bold","start":2,"end":12}]},"inline":[{"kind":"text","text":"4 Experiments"}]},{"id":"folio-987545ffb087f1ece898-p5-b15-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In this section, we present BERT fine-tuning re-sults on 11 NLP tasks."}]},{"id":"folio-987545ffb087f1ece898-p5-b16-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b16-0-ii-style/bold-126","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p5-b16-0-ii-style/bold-127","type":"style/bold","start":4,"end":7}]},"inline":[{"kind":"text","text":"4.1 GLUE"}]},{"id":"folio-987545ffb087f1ece898-p5-b17-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The General Language Understanding Evaluation (GLUE) benchmark (Wang et al., 2018a) is a col-lection of diverse natural language understanding tasks. Detailed descriptions of GLUE datasets are included in Appendix B.1. To fine-tune on GLUE, we represent the input sequence (for single sentence or sentence pairs) as described in Section 3, and use the final hid-den vector $C\\in \\mathbb{R}^{H}$ corresponding to the first input token ([CLS]) as the aggregate representa-tion. The only new parameters introduced during fine-tuning are classification layer weights W ∈ $\\mathbb{R}^{K\\times H}$, where K is the number of labels. We com-pute a standard classification loss with C and W, i.e., log(softmax$(CW^{T})$)."}]},{"id":"folio-987545ffb087f1ece898-p5-b18-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"7For example, the BERT SQuAD model can be trained in around 30 minutes on a single Cloud TPU to achieve a Dev F1 score of 91.0%. 8See (10) in https://gluebenchmark.com/faq."}]},{"id":"folio-987545ffb087f1ece898-p5-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4175"}]},{"id":"folio-987545ffb087f1ece898-p6-b0-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"System MNLI-(m/mm) QQP QNLI SST-2 CoLA STS-B MRPC RTE Average 392k 363k 108k 67k 8.5k 5.7k 3.5k 2.5k -Pre-OpenAI SOTA 80.6/80.1 66.1 82.3 93.2 35.0 81.0 86.0 61.7 74.0 BiLSTM+ELMo+Attn 76.4/76.1 64.8 79.8 90.4 36.0 73.3 84.9 56.8 71.0 OpenAI GPT 82.1/81.4 70.3 87.4 91.3 45.4 80.0 82.3 56.0 75.1 BERTBASE 84.6/83.4 71.2 90.5 93.5 52.1 85.8 88.9 66.4 79.6 BERTLARGE 86.7/85.9 72.1 92.7 94.9 60.5 86.5 89.3 70.1 82.1"}]},{"id":"folio-987545ffb087f1ece898-p6-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Table 1: GLUE Test results, scored by the evaluation server (https://gluebenchmark.com/leaderboard). The number below each task denotes the number of training examples. The \"Average\" column is slightly different than the official GLUE score, since we exclude the problematic WNLI set.8 BERT and OpenAI GPT are single-model, single task. F1 scores are reported for QQP and MRPC, Spearman correlations are reported for STS-B, and accuracy scores are reported for the other tasks. We exclude entries that use BERT as one of their components."}]},{"id":"folio-987545ffb087f1ece898-p6-b3-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We use a batch size of 32 and fine-tune for 3 epochs over the data for all GLUE tasks. For each task, we selected the best fine-tuning learning rate (among 5e-5, 4e-5, 3e-5, and 2e-5) on the Dev set. Additionally, for BERT LARGE we found that fine-tuning was sometimes unstable on small datasets, so we ran several random restarts and selected the best model on the Dev set. With random restarts, we use the same pre-trained checkpoint but per-form different fine-tuning data shuffling and clas-sifier layer initialization.9 Results are presented in Table 1. Both BERT BASE and BERT LARGE outperform all sys-tems on all tasks by a substantial margin, obtaining 4.5% and 7.0% respective average accuracy im-provement over the prior state of the art. Note that BERT BASE and OpenAI GPT are nearly identical in terms of model architecture apart from the at-tention masking. For the largest and most widely reported GLUE task, MNLI, BERT obtains a 4.6% absolute accuracy improvement. On the official GLUE leaderboard10, BERT LARGE obtains a score of 80.5, compared to OpenAI GPT, which obtains 72.8 as of the date of writing. We find that BERT LARGE significantly outper-forms BERT BASE across all tasks, especially those with very little training data. The effect of model size is explored more thoroughly in Section 5.2."}]},{"id":"folio-987545ffb087f1ece898-p6-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p6-b5-0-ii-style/bold-170","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p6-b5-0-ii-style/bold-171","type":"style/bold","start":4,"end":13}]},"inline":[{"kind":"text","text":"4.2 SQuAD v1.1"}]},{"id":"folio-987545ffb087f1ece898-p6-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The Stanford Question Answering Dataset (SQuAD v1.1) is a collection of 100k crowd-sourced question/answer pairs (Rajpurkar et al., 2016). Given a question and a passage from"}]},{"id":"folio-987545ffb087f1ece898-p6-b7-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"9The GLUE data set distribution does not include the Test labels, and we only made a single GLUE evaluation server submission for each of BERTBASE and BERTLARGE."}]},{"id":"folio-987545ffb087f1ece898-p6-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"10https://gluebenchmark.com/leaderboard"}]},{"id":"folio-987545ffb087f1ece898-p6-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Wikipedia containing the answer, the task is to predict the answer text span in the passage. As shown in Figure 1, in the question answer-ing task, we represent the input question and pas-sage as a single packed sequence, with the ques-tion using the A embedding and the passage using the B embedding. We only introduce a start vec-tor $S\\in \\mathbb{R}^{H}$ and an end vector $E\\in \\mathbb{R}^{H}$ during fine-tuning. The probability of word i being the start of the answer span is computed as a dot prod-uct between $T_{i}$ and S followed by a softmax over all of the words in the paragraph$:P_{i}=\\sum ^{e_{S\\cdot Tj}^{S\\cdot Ti}}$ ."}]},{"id":"folio-987545ffb087f1ece898-p6-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"e j"}]},{"id":"folio-987545ffb087f1ece898-p6-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The analogous formula is used for the end of the answer span. The score of a candidate span from position i to position j is defined as $S\\cdot T_{i}+E\\cdot T_{j}$ , and the maximum scoring span where j ≥ i is used as a prediction. The training objective is the sum of the log-likelihoods of the correct start and end positions. We fine-tune for 3 epochs with a learning rate of 5e-5 and a batch size of 32. Table 2 shows top leaderboard entries as well as results from top published systems (Seo et al., 2017; Clark and Gardner, 2018; Peters et al., 2018a; Hu et al., 2018). The top results from the SQuAD leaderboard do not have up-to-date public system descriptions available,11 and are allowed to use any public data when training their systems. We therefore use modest data augmentation in our system by first fine-tuning on TriviaQA (Joshi et al., 2017) befor fine-tuning on SQuAD. Our best performing system outperforms the top leaderboard system by +1.5 F1 in ensembling and +1.3 F1 as a single system. In fact, our single BERT model outperforms the top ensemble sys-tem in terms of F1 score. Without TriviaQA fine-"}]},{"id":"folio-987545ffb087f1ece898-p6-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"11QANet is described in Yu et al. (2018), but the system has improved substantially after publication."}]},{"id":"folio-987545ffb087f1ece898-p6-b9-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4176"}]},{"id":"folio-987545ffb087f1ece898-p7-b0-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"System Dev Test"}]},{"id":"folio-987545ffb087f1ece898-p7-b1-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"EM F1 EM F1"}]},{"id":"folio-987545ffb087f1ece898-p7-b1-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Top Leaderboard Systems (Dec 10th, 2018) Human - - 82.3 91.2 #1 Ensemble - nlnet - - 86.0 91.7 #2 Ensemble - QANet - - 84.5 90.5"}]},{"id":"folio-987545ffb087f1ece898-p7-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Published"}]},{"id":"folio-987545ffb087f1ece898-p7-b3-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"BiDAF+ELMo (Single) - 85.6 - 85.8"}]},{"id":"folio-987545ffb087f1ece898-p7-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Ours"}]},{"id":"folio-987545ffb087f1ece898-p7-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"R.M. Reader (Ensemble) 81.2 87.9 82.3 88.5"}]},{"id":"folio-987545ffb087f1ece898-p7-b5-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"BERTBASE (Single) 80.8 88.5 - -BERTLARGE (Single) 84.1 90.9 - -BERTLARGE (Ensemble) 85.8 91.8 - -BERTLARGE (Sgl.+TriviaQA) 84.2 91.1 85.1 91.8"}]},{"id":"folio-987545ffb087f1ece898-p7-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"BERTLARGE (Ens.+TriviaQA) 86.2 92.2 87.4 93.2"}]},{"id":"folio-987545ffb087f1ece898-p7-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Table 2: SQuAD 1.1 results. The BERT ensemble is 7x systems which use different pre-training check-points and fine-tuning seeds."}]},{"id":"folio-987545ffb087f1ece898-p7-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"System Dev Test"}]},{"id":"folio-987545ffb087f1ece898-p7-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"EM F1 EM F1"}]},{"id":"folio-987545ffb087f1ece898-p7-b11-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Top Leaderboard Systems (Dec 10th, 2018) Human 86.3 89.0 86.9 89.5 #1 Single - MIR-MRC (F-Net) - - 74.8 78.0 #2 Single - nlnet - - 74.2 77.1"}]},{"id":"folio-987545ffb087f1ece898-p7-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Published"}]},{"id":"folio-987545ffb087f1ece898-p7-b14-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"unet (Ensemble) - - 71.4 74.9 SLQA+ (Single) - 71.4 74.4"}]},{"id":"folio-987545ffb087f1ece898-p7-b16-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Ours"}]},{"id":"folio-987545ffb087f1ece898-p7-b17-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"BERTLARGE (Single) 78.7 81.9 80.0 83.1"}]},{"id":"folio-987545ffb087f1ece898-p7-b19-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Table 3: SQuAD 2.0 results. We exclude entries that use BERT as one of their components."}]},{"id":"folio-987545ffb087f1ece898-p7-b20-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"tuning data, we only lose 0.1-0.4 F1, still outper-forming all existing systems by a wide margin.12"}]},{"id":"folio-987545ffb087f1ece898-p7-b21-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p7-b21-0-ii-style/bold-170","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p7-b21-0-ii-style/bold-171","type":"style/bold","start":4,"end":13}]},"inline":[{"kind":"text","text":"4.3 SQuAD v2.0"}]},{"id":"folio-987545ffb087f1ece898-p7-b22-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The SQuAD 2.0 task extends the SQuAD 1.1 problem definition by allowing for the possibility that no short answer exists in the provided para-graph, making the problem more realistic."}]},{"id":"folio-987545ffb087f1ece898-p7-b23-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We use a simple approach to extend the SQuAD v1.1 BERT model for this task. We treat ques-tions that do not have an answer as having an an-swer span with start and end at the [CLS] to-ken. The probability space for the start and end answer span positions is extended to include the position of the [CLS] token. For prediction, we compare the score of the no-answer span$:s_{null}=$ S·C + E·C to the score of the best non-null span"}]},{"id":"folio-987545ffb087f1ece898-p7-b24-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"12The TriviaQA data we used consists of paragraphs from TriviaQA-Wiki formed of the first 400 tokens in documents, that contain at least one of the provided possible answers."}]},{"id":"folio-987545ffb087f1ece898-p7-b25-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"System"}]},{"id":"folio-987545ffb087f1ece898-p7-b25-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"ESIM+GloVe ESIM+ELMo OpenAI GPT"}]},{"id":"folio-987545ffb087f1ece898-p7-b25-2-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"BERTBASE BERTLARGE"}]},{"id":"folio-987545ffb087f1ece898-p7-b25-3-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Human (expert)† Human (5 annotations)†"}]},{"id":"folio-987545ffb087f1ece898-p7-b26-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Dev Test"}]},{"id":"folio-987545ffb087f1ece898-p7-b26-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"51.9 52.7 59.1 59.2"}]},{"id":"folio-987545ffb087f1ece898-p7-b27-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"- 78.0"}]},{"id":"folio-987545ffb087f1ece898-p7-b27-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"81.6 -"}]},{"id":"folio-987545ffb087f1ece898-p7-b28-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"86.6 86.3"}]},{"id":"folio-987545ffb087f1ece898-p7-b29-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"- 85.0"}]},{"id":"folio-987545ffb087f1ece898-p7-b30-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"- 88.0"}]},{"id":"folio-987545ffb087f1ece898-p7-b31-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Table 4: SWAG Dev and Test accuracies$.^{\\dagger}$Human per-formance is measured with 100 samples, as reported in the SWAG paper."}]},{"id":"folio-987545ffb087f1ece898-p7-b32-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"$s_{\\hat{i},j}=\\max _{j\\geq i}S\\cdot T_{i}+E\\cdot T_{j}$. We predict a non-null answer when $s_{\\hat{i},j}>s_{null}+\\tau$, where the thresh-old τ is selected on the dev set to maximize F1. We did not use TriviaQA data for this model. We fine-tuned for 2 epochs with a learning rate of 5e-5 and a batch size of 48. The results compared to prior leaderboard en-tries and top published work (Sun et al., 2018; Wang et al., 2018b) are shown in Table 3, exclud-ing systems that use BERT as one of their com-ponents. We observe a +5.1 F1 improvement over the previous best system."}]},{"id":"folio-987545ffb087f1ece898-p7-b33-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p7-b33-0-ii-style/bold-149","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p7-b33-0-ii-style/bold-150","type":"style/bold","start":4,"end":7}]},"inline":[{"kind":"text","text":"4.4 SWAG"}]},{"id":"folio-987545ffb087f1ece898-p7-b34-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The Situations With Adversarial Generations (SWAG) dataset contains 113k sentence-pair com-pletion examples that evaluate grounded common-sense inference (Zellers et al., 2018). Given a sen-tence, the task is to choose the most plausible con-tinuation among four choices. When fine-tuning on the SWAG dataset, we construct four input sequences, each containing the concatenation of the given sentence (sentence A) and a possible continuation (sentence B). The only task-specific parameters introduced is a vec-tor whose dot product with the [CLS] token rep-resentation C denotes a score for each choice which is normalized with a softmax layer."}]},{"id":"folio-987545ffb087f1ece898-p7-b35-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We fine-tune the model for 3 epochs with a learning rate of 2e-5 and a batch size of 16. Re-sults are presented in Table 4. BERT LARGE out-performs the authors' baseline ESIM+ELMo sys-tem by +27.1% and OpenAI GPT by 8.3%."}]},{"id":"folio-987545ffb087f1ece898-p7-b36-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p7-b36-0-ii-style/bold-225","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p7-b36-0-ii-style/bold-228","type":"style/bold","start":2,"end":17}]},"inline":[{"kind":"text","text":"5 Ablation Studies"}]},{"id":"folio-987545ffb087f1ece898-p7-b37-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In this section, we perform ablation experiments over a number of facets of BERT in order to better understand their relative importance. Additional"}]},{"id":"folio-987545ffb087f1ece898-p7-b38-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4177"}]},{"id":"folio-987545ffb087f1ece898-p8-b0-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Dev Set"}]},{"id":"folio-987545ffb087f1ece898-p8-b1-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Tasks MNLI-m QNLI MRPC SST-2 SQuAD (Acc) (Acc) (Acc) (Acc) (F1)"}]},{"id":"folio-987545ffb087f1ece898-p8-b1-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"BERTBASE 84.4 88.4 86.7 92.7 88.5 No NSP 83.9 84.9 86.5 92.6 87.9 LTR & No NSP 82.1 84.3 77.5 92.1 77.8"}]},{"id":"folio-987545ffb087f1ece898-p8-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"+ BiLSTM 82.1 84.1 75.7 91.6 84.9"}]},{"id":"folio-987545ffb087f1ece898-p8-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Table 5: Ablation over the pre-training tasks using the BERT BASE architecture. \"No NSP\" is trained without the next sentence prediction task. \"LTR & No NSP\" is trained as a left-to-right LM without the next sentence prediction, like OpenAI GPT. \"+ BiLSTM\" adds a ran-domly initialized BiLSTM on top of the \"LTR + No NSP\" model during fine-tuning."}]},{"id":"folio-987545ffb087f1ece898-p8-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"results are still far worse than those of the pre-trained bidirectional models. The BiLSTM hurts performance on the GLUE tasks. We recognize that it would also be possible to train separate LTR and RTL models and represent each token as the concatenation of the two mod-els, as ELMo does. However: (a) this is twice as expensive as a single bidirectional model; (b) this is non-intuitive for tasks like QA, since the RTL model would not be able to condition the answer on the question; (c) this it is strictly less powerful than a deep bidirectional model, since it can use both left and right context at every layer."}]},{"id":"folio-987545ffb087f1ece898-p8-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"ablation studies can be found in Appendix C."}]},{"id":"folio-987545ffb087f1ece898-p8-b7-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p8-b7-0-ii-style/bold-69","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p8-b7-0-ii-style/bold-70","type":"style/bold","start":4,"end":31}]},"inline":[{"kind":"text","text":"5.1 Effect of Pre-training Tasks"}]},{"id":"folio-987545ffb087f1ece898-p8-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We demonstrate the importance of the deep bidi-rectionality of BERT by evaluating two pre-training objectives using exactly the same pre-training data, fine-tuning scheme, and hyperpa-rameters as BERT BASE:"}]},{"id":"folio-987545ffb087f1ece898-p8-b8-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"No NSP: A bidirectional model which is trained using the \"masked LM\" (MLM) but without the \"next sentence prediction\" (NSP) task. LTR & No NSP: A left-context-only model which is trained using a standard Left-to-Right (LTR) LM, rather than an MLM. The left-only constraint was also applied at fine-tuning, because removing it introduced a pre-train/fine-tune mismatch that degraded downstream performance. Additionally, this model was pre-trained without the NSP task. This is directly comparable to OpenAI GPT, but using our larger training dataset, our input repre-sentation, and our fine-tuning scheme. We first examine the impact brought by the NSP task. In Table 5, we show that removing NSP hurts performance significantly on QNLI, MNLI, and SQuAD 1.1. Next, we evaluate the impact of training bidirectional representations by com-paring \"No NSP\" to \"LTR & No NSP\". The LTR model performs worse than the MLM model on all tasks, with large drops on MRPC and SQuAD."}]},{"id":"folio-987545ffb087f1ece898-p8-b9-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"For SQuAD it is intuitively clear that a LTR model will perform poorly at token predictions, since the token-level hidden states have no right-side context. In order to make a good faith at-tempt at strengthening the LTR system, we added a randomly initialized BiLSTM on top. This does significantly improve results on SQuAD, but the"}]},{"id":"folio-987545ffb087f1ece898-p8-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p8-b11-0-ii-style/bold-66","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p8-b11-0-ii-style/bold-67","type":"style/bold","start":4,"end":23}]},"inline":[{"kind":"text","text":"5.2 Effect of Model Size"}]},{"id":"folio-987545ffb087f1ece898-p8-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In this section, we explore the effect of model size on fine-tuning task accuracy. We trained a number of BERT models with a differing number of layers, hidden units, and attention heads, while otherwise using the same hyperparameters and training pro-cedure as described previously. Results on selected GLUE tasks are shown in Table 6. In this table, we report the average Dev Set accuracy from 5 random restarts of fine-tuning. We can see that larger models lead to a strict ac-curacy improvement across all four datasets, even for MRPC which only has 3,600 labeled train-ing examples, and is substantially different from the pre-training tasks. It is also perhaps surpris-ing that we are able to achieve such significant improvements on top of models which are al-ready quite large relative to the existing literature. For example, the largest Transformer explored in Vaswani et al. (2017) is (L=6, H=1024, A=16) with 100M parameters for the encoder, and the largest Transformer we have found in the literature is (L=64, H=512, A=2) with 235M parameters (Al-Rfou et al., 2018). By contrast, BERT BASE contains 110M parameters and BERT LARGE con-tains 340M parameters."}]},{"id":"folio-987545ffb087f1ece898-p8-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"It has long been known that increasing the model size will lead to continual improvements on large-scale tasks such as machine translation and language modeling, which is demonstrated by the LM perplexity of held-out training data shown in Table 6. However, we believe that this is the first work to demonstrate convinc-ingly that scaling to extreme model sizes also leads to large improvements on very small scale tasks, provided that the model has been suffi-ciently pre-trained. Peters et al. (2018b) presented"}]},{"id":"folio-987545ffb087f1ece898-p8-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4178"}]},{"id":"folio-987545ffb087f1ece898-p9-b0-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"mixed results on the downstream task impact of"}]},{"id":"folio-987545ffb087f1ece898-p9-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"increasing the pre-trained bi-LM size from two to four layers and Melamud et al. (2016) men-tioned in passing that increasing hidden dimen-"}]},{"id":"folio-987545ffb087f1ece898-p9-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"sion size from 200 to 600 helped, but increasing further to 1,000 did not bring further improve-ments. Both of these prior works used a feature-"}]},{"id":"folio-987545ffb087f1ece898-p9-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"based approach - we hypothesize that when the model is fine-tuned directly on the downstream tasks and uses only a very small number of ran-domly initialized additional parameters, the task-specific models can benefit from the larger, more"}]},{"id":"folio-987545ffb087f1ece898-p9-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"expressive pre-trained representations even when downstream task data is very small."}]},{"id":"folio-987545ffb087f1ece898-p9-b9-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b9-0-ii-style/bold-80","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p9-b9-0-ii-style/bold-81","type":"style/bold","start":4,"end":35}]},"inline":[{"kind":"text","text":"5.3 Feature-based Approach with BERT"}]},{"id":"folio-987545ffb087f1ece898-p9-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"All of the BERT results presented so far have used the fine-tuning approach, where a simple classifi-cation layer is added to the pre-trained model, and all parameters are jointly fine-tuned on a down-stream task. However, the feature-based approach, where fixed features are extracted from the pre-trained model, has certain advantages. First, not all tasks can be easily represented by a Trans-former encoder architecture, and therefore require a task-specific model architecture to be added. Second, there are major computational benefits to pre-compute an expensive representation of the training data once and then run many experiments with cheaper models on top of this representation. In this section, we compare the two approaches by applying BERT to the CoNLL-2003 Named Entity Recognition (NER) task (Tjong Kim Sang and De Meulder, 2003). In the input to BERT, we use a case-preserving WordPiece model, and we include the maximal document context provided by the data. Following standard practice, we for-mulate this as a tagging task but do not use a CRF"}]},{"id":"folio-987545ffb087f1ece898-p9-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Hyperparams"}]},{"id":"folio-987545ffb087f1ece898-p9-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"#L #H"}]},{"id":"folio-987545ffb087f1ece898-p9-b13-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"3 768 6 768 6 768 12 768 12 1024 24 1024"}]},{"id":"folio-987545ffb087f1ece898-p9-b14-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"#A LM (ppl) MNLI-m"}]},{"id":"folio-987545ffb087f1ece898-p9-b14-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"12 5.84 3 5.24 12 4.68 12 3.99 16 3.54 16 3.23"}]},{"id":"folio-987545ffb087f1ece898-p9-b15-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Dev Set Accuracy"}]},{"id":"folio-987545ffb087f1ece898-p9-b16-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"77.9 80.6 81.9 84.4 85.7 86.6"}]},{"id":"folio-987545ffb087f1ece898-p9-b17-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"MRPC"}]},{"id":"folio-987545ffb087f1ece898-p9-b17-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"79.8 82.2 84.8 86.7 86.9 87.8"}]},{"id":"folio-987545ffb087f1ece898-p9-b18-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"SST-2"}]},{"id":"folio-987545ffb087f1ece898-p9-b18-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"88.4 90.7 91.3 92.9 93.3 93.7"}]},{"id":"folio-987545ffb087f1ece898-p9-b20-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Table 6: Ablation over BERT model size. #L = the number of layers; #H = hidden size; #A = number of at-tention heads. \"LM (ppl)\" is the masked LM perplexity of held-out training data."}]},{"id":"folio-987545ffb087f1ece898-p9-b23-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"System Dev F1 Test F1"}]},{"id":"folio-987545ffb087f1ece898-p9-b23-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"ELMo (Peters et al., 2018a) 95.7 92.2 CVT (Clark et al., 2018) - 92.6 CSE (Akbik et al., 2018) - 93.1"}]},{"id":"folio-987545ffb087f1ece898-p9-b24-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Fine-tuning approach"}]},{"id":"folio-987545ffb087f1ece898-p9-b25-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"BERTLARGE 96.6 92.8 BERTBASE 96.4 92.4"}]},{"id":"folio-987545ffb087f1ece898-p9-b26-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Feature-based approach (BERTBASE)"}]},{"id":"folio-987545ffb087f1ece898-p9-b27-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Embeddings 91.0 -Second-to-Last Hidden 95.6 -Last Hidden 94.9 -Weighted Sum Last Four Hidden 95.9 -Concat Last Four Hidden 96.1 -Weighted Sum All 12 Layers 95.5 -"}]},{"id":"folio-987545ffb087f1ece898-p9-b28-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Table 7: CoNLL-2003 Named Entity Recognition re-sults. Hyperparameters were selected using the Dev set. The reported Dev and Test scores are averaged over 5 random restarts using those hyperparameters."}]},{"id":"folio-987545ffb087f1ece898-p9-b29-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"layer in the output. We use the representation of the first sub-token as the input to the token-level classifier over the NER label set. To ablate the fine-tuning approach, we apply the feature-based approach by extracting the activa-tions from one or more layers without fine-tuning any parameters of BERT. These contextual em-beddings are used as input to a randomly initial-ized two-layer 768-dimensional BiLSTM before the classification layer."}]},{"id":"folio-987545ffb087f1ece898-p9-b30-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Results are presented in Table 7. BERT LARGE performs competitively with state-of-the-art meth-ods. The best performing method concatenates the token representations from the top four hidden lay-ers of the pre-trained Transformer, which is only 0.3 F1 behind fine-tuning the entire model. This demonstrates that BERT is effective for both fine-tuning and feature-based approaches."}]},{"id":"folio-987545ffb087f1ece898-p9-b31-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b31-0-ii-style/bold-157","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p9-b31-0-ii-style/bold-158","type":"style/bold","start":2,"end":11}]},"inline":[{"kind":"text","text":"6 Conclusion"}]},{"id":"folio-987545ffb087f1ece898-p9-b32-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Recent empirical improvements due to transfer learning with language models have demonstrated that rich, unsupervised pre-training is an integral part of many language understanding systems. In particular, these results enable even low-resource tasks to benefit from deep unidirectional architec-tures. Our major contribution is further general-izing these findings to deep bidirectional architec-tures, allowing the same pre-trained model to suc-cessfully tackle a broad set of NLP tasks."}]},{"id":"folio-987545ffb087f1ece898-p9-b22-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4179"}]},{"id":"folio-987545ffb087f1ece898-p10-b0-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p10-b0-0-ii-style/bold-0","type":"style/bold","start":0,"end":9}]},"inline":[{"kind":"text","text":"References"}]},{"id":"folio-987545ffb087f1ece898-p10-b1-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Alan Akbik, Duncan Blythe, and Roland Vollgraf. 2018. Contextual string embeddings for sequence labeling. In Proceedings of the 27th International Conference on Computational Linguistics, pages 1638-1649."}]},{"id":"folio-987545ffb087f1ece898-p10-b2-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Rami Al-Rfou, Dokook Choe, Noah Constant, Mandy"}]},{"id":"folio-987545ffb087f1ece898-p10-b3-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Guo, and Llion Jones. 2018. Character-level lan-guage modeling with deeper self-attention. arXiv preprint arXiv:1808.04444."}]},{"id":"folio-987545ffb087f1ece898-p10-b4-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Rie Kubota Ando and Tong Zhang. 2005. A framework"}]},{"id":"folio-987545ffb087f1ece898-p10-b5-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"for learning predictive structures from multiple tasks and unlabeled data. Journal of Machine Learning Research, 6(Nov):1817-1853."}]},{"id":"folio-987545ffb087f1ece898-p10-b6-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Luisa Bentivogli, Bernardo Magnini, Ido Dagan,"}]},{"id":"folio-987545ffb087f1ece898-p10-b7-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Hoa Trang Dang, and Danilo Giampiccolo. 2009. The fifth PASCAL recognizing textual entailment challenge. In TAC. NIST."}]},{"id":"folio-987545ffb087f1ece898-p10-b8-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"John Blitzer, Ryan McDonald, and Fernando Pereira."}]},{"id":"folio-987545ffb087f1ece898-p10-b9-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"2006. Domain adaptation with structural correspon-dence learning. In Proceedings of the 2006 confer-ence on empirical methods in natural language pro-cessing, pages 120-128. Association for Computa-tional Linguistics."}]},{"id":"folio-987545ffb087f1ece898-p10-b10-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Samuel R. Bowman, Gabor Angeli, Christopher Potts,"}]},{"id":"folio-987545ffb087f1ece898-p10-b11-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"and Christopher D. Manning. 2015. A large anno-tated corpus for learning natural language inference. In EMNLP. Association for Computational Linguis-tics."}]},{"id":"folio-987545ffb087f1ece898-p10-b12-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Peter F Brown, Peter V Desouza, Robert L Mercer,"}]},{"id":"folio-987545ffb087f1ece898-p10-b13-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Vincent J Della Pietra, and Jenifer C Lai. 1992. Class-based n-gram models of natural language. Computational linguistics, 18(4):467-479."}]},{"id":"folio-987545ffb087f1ece898-p10-b14-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Daniel Cer, Mona Diab, Eneko Agirre, Inigo Lopez-"}]},{"id":"folio-987545ffb087f1ece898-p10-b15-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Gazpio, and Lucia Specia. 2017. Semeval-2017 task 1: Semantic textual similarity multilingual and crosslingual focused evaluation. In Proceedings of the 11th International Workshop on Semantic Evaluation (SemEval-2017), pages 1-14, Vancou-ver, Canada. Association for Computational Lin-guistics."}]},{"id":"folio-987545ffb087f1ece898-p10-b16-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Ciprian Chelba, Tomas Mikolov, Mike Schuster, Qi Ge,"}]},{"id":"folio-987545ffb087f1ece898-p10-b17-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Thorsten Brants, Phillipp Koehn, and Tony Robin-son. 2013. One billion word benchmark for measur-ing progress in statistical language modeling. arXiv preprint arXiv:1312.3005."}]},{"id":"folio-987545ffb087f1ece898-p10-b18-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Z. Chen, H. Zhang, X. Zhang, and L. Zhao. 2018."}]},{"id":"folio-987545ffb087f1ece898-p10-b19-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Quora question pairs."}]},{"id":"folio-987545ffb087f1ece898-p10-b20-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Christopher Clark and Matt Gardner. 2018. Simple"}]},{"id":"folio-987545ffb087f1ece898-p10-b21-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"and effective multi-paragraph reading comprehen-sion. In ACL."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Kevin Clark, Minh-Thang Luong, Christopher D Man-ning, and Quoc Le. 2018. Semi-supervised se-quence modeling with cross-view training. In Pro-ceedings of the 2018 Conference on Empirical Meth-ods in Natural Language Processing, pages 1914- 1925."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-1-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Ronan Collobert and Jason Weston. 2008. A unified architecture for natural language processing: Deep neural networks with multitask learning. In Pro-ceedings of the 25th international conference on Machine learning, pages 160-167. ACM."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-2-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Alexis Conneau, Douwe Kiela, Holger Schwenk, Lo¨ıc Barrault, and Antoine Bordes. 2017. Supervised learning of universal sentence representations from natural language inference data. In Proceedings of the 2017 Conference on Empirical Methods in Nat-ural Language Processing, pages 670-680, Copen-hagen, Denmark. Association for Computational Linguistics."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-3-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Andrew M Dai and Quoc V Le. 2015. Semi-supervised sequence learning. In Advances in neural informa-tion processing systems, pages 3079-3087."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-4-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"J. Deng, W. Dong, R. Socher, L.-J. Li, K. Li, and L. Fei-Fei. 2009. ImageNet: A Large-Scale Hierarchical Image Database. In CVPR09."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-5-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"William B Dolan and Chris Brockett. 2005. Automati-cally constructing a corpus of sentential paraphrases. In Proceedings of the Third International Workshop on Paraphrasing (IWP2005)."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-6-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"William Fedus, Ian Goodfellow, and Andrew M Dai. 2018. Maskgan: Better text generation via filling in the . arXiv preprint arXiv:1801.07736."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-7-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Dan Hendrycks and Kevin Gimpel. 2016. Bridging nonlinearities and stochastic regularizers with gaus-sian error linear units. CoRR, abs/1606.08415."}]},{"id":"folio-987545ffb087f1ece898-p10-b23-8-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Felix Hill, Kyunghyun Cho, and Anna Korhonen. 2016."}]},{"id":"folio-987545ffb087f1ece898-p10-b27-0-ii","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Learning distributed representations of sentences from unlabelled data. In Proceedings of the 2016 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies. Association for Computa-tional Linguistics."}]},{"id":"folio-987545ffb087f1ece898-p10-b27-1-ii",