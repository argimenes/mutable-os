ce898-p14-b15-3-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p14-b15-3-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p14-b15-4-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p14-b15-4-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p14-b9-1-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p14-b9-1-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b0-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b0-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b1-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b1-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b2-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b2-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b3-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b3-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b4-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b4-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b5-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b5-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b6-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b6-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b7-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b7-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b8-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p15-b8-0-ii"}},{"placementId":"placement-folio-987545ffb087f1ece898-p15-b9-0-ii","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087