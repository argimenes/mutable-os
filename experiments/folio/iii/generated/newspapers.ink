2-p4-b16-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b16-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b18-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b18-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b20-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b20-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b22-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b22-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b24-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b24-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b26-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b26-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b28-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b28-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b30-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b30-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b32-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b32-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b34-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b34-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b36-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b36-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b38-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b38-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b39-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b39-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b40-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b40-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b41-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b41-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b42-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b42-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b43-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b43-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b44-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b44-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p4-b46-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p4-b46-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b0-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b0-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b1-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b1-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b2-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b2-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b3-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b3-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b4-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b4-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b5-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b5-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b6-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b6-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-p5_1","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-p5_1"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b8-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b8-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b9-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b9-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b10-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b10-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b14-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b14-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b16-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b16-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b17-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b17-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b18-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b18-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b19-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b19-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b20-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b20-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b21-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b21-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p5-b15-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p5-b15-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p6-b0-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p6-b0-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p6-b5-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p6-b5-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p6-b7-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p6-b7-0"}},{"placementId":"placement-folio-18c199992c0706a19592-p6-b8-0","kind":"owned","target":{"kind":"local","blockId":"folio-18c199992c0706a19592-p6-b8-0"}}]},{"id":"folio-18c199992c0706a19592-p1-b0-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p1-b0-0-italics-p1-i0","type":"style/italics","start":0,"end":99}]},"inline":[{"kind":"text","text":"Proceedings of the 13th Conference on Language Resources and Evaluation (LREC 2022), pages 5859-5864 Marseille, 20-25 June 2022 © European Language Resources Association (ELRA), licensed under CC-BY-NC-4.0"}]},{"id":"folio-18c199992c0706a19592-p1-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p1-b1-0-bold-p1-i3","type":"style/bold","start":0,"end":60},{"id":"folio-18c199992c0706a19592-p1-b1-0-bold-p1-i4","type":"style/bold","start":62,"end":76}]},"inline":[{"kind":"text","text":"A Language Modelling Approach to Quality Assessment of OCR'ed Historical Text"}]},{"id":"folio-18c199992c0706a19592-p1-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p1-b2-0-bold-p1-i5","type":"style/bold","start":0,"end":50}]},"inline":[{"kind":"text","text":"Callum W Booth, Robert Shoemaker, Robert Gaizauskas"}]},{"id":"folio-18c199992c0706a19592-p1-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"University of Sheffield, Sheffield, United Kingdom {cwbooth1, r.shoemaker, r.gaizauskas}@sheffield.ac.uk"}]},{"id":"folio-18c199992c0706a19592-p1-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p1-b4-0-bold-p1-i8","type":"style/bold","start":0,"end":7}]},"inline":[{"kind":"text","text":"Abstract"}]},{"id":"folio-18c199992c0706a19592-p1-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We hypothesise and evaluate a language model-based approach for scoring the quality of OCR transcriptions in the British Library Newspapers (BLN) corpus parts 1 and 2, to identify the best quality OCR for use in further natural language processing tasks, with a wider view to link individual newspaper reports of crime in nineteenth-century London to the Digital Panopticon-a structured repository of criminal lives. We mitigate the absence of gold standard transcriptions of the BLN corpus by utilising a corpus of genre-adjacent texts that capture the common and legal parlance of nineteenth-century London-the Proceedings of the Old Bailey Online-with a view to rank the BLN transcriptions by their OCR quality."}]},{"id":"folio-18c199992c0706a19592-p1-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p1-b6-0-bold-p1-i15","type":"style/bold","start":0,"end":89}]},"inline":[{"kind":"text","text":"Keywords: ocr, evaluation, language modelling, information extraction from historical text"}]},{"id":"folio-18c199992c0706a19592-p1-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p1-b7-0-bold-p1-i16","type":"style/bold","start":0,"end":1},{"id":"folio-18c199992c0706a19592-p1-b7-0-bold-p1-i17","type":"style/bold","start":3,"end":14}]},"inline":[{"kind":"text","text":"1. Introduction"}]},{"id":"folio-18c199992c0706a19592-p1-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"This work takes place as part of a larger project to de-tect and link entities from nineteenth-century historical crime records in the London press, to the Digital Panop-ticon (www.digitalpanopticon.org, 2022)-a repository of structured criminal 'life archives'. We target Gale's British Library Newspapers (BLN) parts 1 and 2 datasets (Gale, 2022) as the primary data source. In order to work with these corpora tractably, we must be able to mitigate two limiting factors-dataset size, and transcription quality. Not all of the 14 million doc-uments in the combined corpus will be relevant to the project, or of a high enough quality for downstream tasks. OCR quality within the BLN corpus is highly variable due to factors including original scan qualities (a prod-uct of microfilm/document quality, ink and paper qual-ity, physical degradation along the spine and areas with high hand contact, topology of the paper during scan, scan resolution, etc. (Holley, 2009)), the machine tran-scription process used to create the OCR (a process"}]},{"id":"folio-18c199992c0706a19592-p1-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"used2. Additionally, character level confidence does not equate to accuracy of word transcription-engine-supplied confidence metrics cannot provide confirma-tion that a character is correct in context-verification at the word level requires human intervention (Holley, 2009). Images, formatting, and layout elements in the initial scan image may also potentially be interpreted by the engine as text, which in turn raises the OCR confi-dence, despite adding no information of actual value-a prominent example of this is the transcription of borders and rules as optically-similar characters, such as 1, l, |, and _. Furthermore, Gale's OCR confidence metric is not available for every item in the corpus, and, for documents with a confidence value, the metric is not available in a programmatically accessible form. We devise, therefore-through the use of language mod-elling methodologies-a metric to quantify the quality of a machine transcription in the context of the BLN corpus. This work will provide a re-framing of the OCR quality analysis task as an evaluation of corpus useful-ness, rather than as an intrinsic evaluation method for which varied over the course of corpus creation1), and OCR engine research and development-by formulat-modern typeface biases in OCR engines (most engines ing an OCR quality metric to rank document quality are trained to handle modern typefaces, and are lack- in the British Library Newspapers corpus, without ac-ing for historical documents (Springmann and Lüdeling, cess to a gold standard. We approach the task with a 2017)). historical consideration-nineteenth-century newspaper We wish to address both the corpus size problem and crime reporting and court reports share common genre the OCR quality problem by ranking documents by and historical parlance. We seek to exploit this genre their transcription quality, and then discarding docu- adjacency, by using the Proceedings of the Old Bai-ments below a quality threshold. Gale's BLN platform ley Online (OBP) (Hitchcock et al., 2018) as a source provides an \"OCR Confidence\" metric that could po- of clean, machine-transcribed, human-corrected texts, tentially serve as a candidate quality metric, however from which we can judge the OCR quality of newspaper this would be problematic in this context for a number crime reports, with a view to select high quality tran-of reasons. The OCR confidence metric provided by scriptions for downstream NLP tasks that require the the platform is an aggregation of individual character cleanest entity transcriptions possible. confidence values pulled directly from the OCR engine"}]},{"id":"folio-18c199992c0706a19592-p1-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1Personal communication with Gale representatives, Octo-ber 26, 2020"}]},{"id":"folio-18c199992c0706a19592-p1-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"2Personal communication with Gale representatives, Octo-ber 26, 2020"}]},{"id":"folio-18c199992c0706a19592-p1-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"5859"}]},{"id":"folio-18c199992c0706a19592-p2-b0-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p2-b0-0-bold-p2-i0","type":"style/bold","start":0,"end":1},{"id":"folio-18c199992c0706a19592-p2-b0-0-bold-p2-i1","type":"style/bold","start":3,"end":14}]},"inline":[{"kind":"text","text":"2. Related work"}]},{"id":"folio-18c199992c0706a19592-p2-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The impact of OCR quality on natural language pro-cessing tasks and pipelines in digital humanities con-texts is a widely researched topic (Strange et al., 2014; Traub et al., 2015; van Strien et al., 2020). However, re-search into evaluation of OCR quality post-transcription is more limited. Strange et al. (2014) find that machine transcription quality of historical text suffers in modern OCR engines due to myriad factors, such as degrada-tion of the source material, image bleed, and microfilm exposure issues that require image editing in external software to mitigate-and even given these mitigations, important entities within the text such as names were often mistranscribed repeatedly."}]},{"id":"folio-18c199992c0706a19592-p2-b1-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"van Strein et al. (2020) define a Levenshtein distance-based method of evaluating an OCR transcription against a gold-standard, aligned to the original text in order to assess the impact of OCR quality on NLP tasks. They find that for named entity recognition and infor-mation retrieval tasks, the distance of the OCR from the gold standard not only has a negative impact on the task accuracy, but also causes a wider, more inconsistent range of results."}]},{"id":"folio-18c199992c0706a19592-p2-b1-2","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"OCR quality as a function of edit distance is a fre-quent finding within the literature-Neudecker and"}]},{"id":"folio-18c199992c0706a19592-p2-p2_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"302px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:a9cff5f27bebcf26290aaefa7a9603fcffff53710c698a7fd27d8817dc604943"}}},{"id":"folio-18c199992c0706a19592-p2-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Clausner (2021) cite Stephen V. Rice's (1996) approach to OCR quality calculation using a modified Leven-shtein edit distance calculation, an approach adopted into software packages for OCR quality calculation such as UNLV/ISRI Analytic Tools for OCR Evalu-ation (Neudecker et al., 2021; Rice, 1996; Nartker et al., 2005), which has been used before contextually in histor-ical document transcription methodologies (Springmann and Lüdeling, 2017)."}]},{"id":"folio-18c199992c0706a19592-p2-b3-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We may assess OCR quality through the analysis of proportions of words appearing in a standard dictionary (van Strien et al., 2020; Strange et al., 2014). This however is not an appropriate approach to measuring historical texts where heightened focus is given to entity capture-names and locations for instance, especially short-form names common in nineteenth-century news-papers (for example, the abbreviation of \"William\" to \"Wm.\")."}]},{"id":"folio-18c199992c0706a19592-p2-b3-2","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Machine learning approaches towards OCR quality eval-uation, such as treating the task as a classification tasks, and requiring a gold-standard text for comparison (Schneider, 2021), can also be seen as ineffectual for our use-case, due to the lack of gold standard transcription."}]},{"id":"folio-18c199992c0706a19592-p2-b3-3","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Given these methods require either a gold standard cor-pus, or pre-made lists of entities and dictionaries to compute edit distances, we observe that the field is lack-ing solutions for measuring OCR quality from angles other than intrinsic evaluation of OCR systems. Mea-surement of OCR quality to rank a corpus for historical research purposes is overlooked within the literature."}]},{"id":"folio-18c199992c0706a19592-p2-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p2-b5-0-bold-p2-i2","type":"style/bold","start":0,"end":1},{"id":"folio-18c199992c0706a19592-p2-b5-0-bold-p2-i3","type":"style/bold","start":3,"end":26}]},"inline":[{"kind":"text","text":"3. Analysing the BLN Corpus"}]},{"id":"folio-18c199992c0706a19592-p2-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The BLN corpus parts 1 and 2 comprises 14,060,845 documents of varying length and significance-documents are not segmented into consistent units of information, such as pages or individual articles. Docu-ment content ranges from single character transcriptions, through single sentences, articles, columns, to transcrip-tions spanning half a million characters-where the initial page image and/or full page OCR output was not segmented down to article level. Corpus documents range in length from empty docu-ments, to 553,432 characters, with an average document length of 11,118, and median length 5,628. Document lengths are mostly distributed across a small interquan-tile range close to the minimum length, which may be indicative of an abundance of incomplete documents, or documents scanned via a methodology with different article segmentation logic than the documents at the upper end of the spectrum. These hypotheses are how-ever speculative, as the process used per transcription is unknown. Documents in BLN parts 1 and 2 cover a total of 61 publications, the vast majority are mainly regional and local publications. London-centric papers make up a relatively small proportion of the entire corpus, at only 17 publications."}]},{"id":"folio-18c199992c0706a19592-p2-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Figure 1: Heatmap breakdown of BLN transcription counts over each year and publication."}]},{"id":"folio-18c199992c0706a19592-p2-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Document availability is skewed heavily towards the end of the nineteenth century-as shown by the distribu-tion of available documents per individual publications in figure 1-which we might reason to be in part due to segmentation algorithms ran on later texts creating more individual documents versus longer, unsegmented documents, but may also be due to a higher number of publications in the late nineteenth century. We may corroborate this in figure 2, which shows the counts of unique issues of a paper, independent of doc-ument counts. When we compare figures 1 and 2, we"}]},{"id":"folio-18c199992c0706a19592-p2-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"5860"}]},{"id":"folio-18c199992c0706a19592-p3-p3_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"291px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:7d034dde0f62b734471ec3ca63c67cf968025ce73e21ee5e2d473d6f17f42c3f"}}},{"id":"folio-18c199992c0706a19592-p3-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Figure 2: Heatmap breakdown of BLN issue counts over each year and publication."}]},{"id":"folio-18c199992c0706a19592-p3-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"observe a similar skew towards the end of the century, however we do not observe a comparatively significant increase in publication counts across the space, except in a few publications. From this, we may again hypothe-sise the increase in documents at the end of the century to be a product of the segmentation methodology."}]},{"id":"folio-18c199992c0706a19592-p3-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p3-b3-0-bold-p3-i51","type":"style/bold","start":0,"end":1},{"id":"folio-18c199992c0706a19592-p3-b3-0-bold-p3-i52","type":"style/bold","start":3,"end":35}]},"inline":[{"kind":"text","text":"4. Formulating an OCR Quality Metric"}]},{"id":"folio-18c199992c0706a19592-p3-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We propose a language model-based approach for scor-ing OCR quality, by creating models that serve as semi-authoritative representations of written nineteenth-century English. Assessing OCR quality therefore be-comes a matter of measuring the likelihood of the doc-ument belonging to the language model. To do this, we select a cleaner corpus of nineteenth-century prose to serve as train, test, and development sets: the Pro-ceedings of the Old Bailey Online (OBP)-a digitised collection of the trial accounts from London's central criminal court, that claims a transcription accuracy rate of \"well over 99%\" (Emsley et al., 2018b). Using the Proceedings has advantages in the scoring process-despite being of a different genre to newspaper articles-in that it provides a number of exploitable biases. The nature of its content provides a bias towards technical crime vocabulary, legal vocabulary, and crime-adjacent vocabulary used in common parlance via the inclusion of quoted testimony. As the Old Bailey was the central criminal court for London, the Proceedings also provides an additional bias towards London-centric entities. We structure our language model as an interpolated model of decreasing dimensionality n-gram sub-models, starting at a bigram model and ending at a zeroth order. We take the zeroth order sub-model to be a Lidstone-esque uniform distribution (Hsu, 2007). By treating this as interpolation instead of backoff, the zeroth order sub-model provides Lidstone smoothing independent of the other components."}]},{"id":"folio-18c199992c0706a19592-p3-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"For a transcription document D, we estimate and store sub-model probabilities using maximum likelihood estimation-based language model calculations given in equations 1 and 2, as specified in Jurafsky & Martin (2020). We estimate each sub-model's token proba-bilities independently, using normalised OBP tokens. Tokens are delimited by whitespace and punctuation, transformed to lowercase, and non-alphanumeric tokens are removed."}]},{"id":"folio-18c199992c0706a19592-p3-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"$P_{unigram}(w_{k})=$ (1)"}]},{"id":"folio-18c199992c0706a19592-p3-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"$P_{bigram}(w_{k}|w_{k-1})=$ (2)"}]},{"id":"folio-18c199992c0706a19592-p3-b8-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We calculate ensemble bigram probabilities as a weighted sum of the individual sub-model probabilites in equations 1 and 2, as shown in equation 3."}]},{"id":"folio-18c199992c0706a19592-p3-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"count$(w_{k})$ $\\sum count(w_{k-1},w_{k})$$_{\\in V}count(w)$"}]},{"id":"folio-18c199992c0706a19592-p3-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"w"}]},{"id":"folio-18c199992c0706a19592-p3-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"P $_{\\in V}count(w_{k-1})$"}]},{"id":"folio-18c199992c0706a19592-p3-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"w"}]},{"id":"folio-18c199992c0706a19592-p3-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"$P(w_{k}|w_{k-1})=\\lambda _{1}P_{bigram}(w_{k}|w_{k-1})+$"}]},{"id":"folio-18c199992c0706a19592-p3-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"$\\lambda _{2}P_{unigram}(w_{k})+$ (3) $\\lambda _{3}|$V$|^{-1}$"}]},{"id":"folio-18c199992c0706a19592-p3-b14-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"where $\\lambda _{i}$ are component weights such that $\\sum _{i}$ $\\lambda _{i}=1$, that are to be conditioned on a development set after model training, and |V| represents the vocabulary size. We represent the OCR quality score $S_{D}$ as the average log likelihood of D, as shown by equation 4. We se-lect this evaluation method as it provides normalisation by document length, to avoid a bias towards shorter documents."}]},{"id":"folio-18c199992c0706a19592-p3-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"K"}]},{"id":"folio-18c199992c0706a19592-p3-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"$S_{D}=\\frac{1}{K}\\exp \\sum log(P(w_{k}|w_{k-1}))$ (4)"}]},{"id":"folio-18c199992c0706a19592-p3-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"k=1"}]},{"id":"folio-18c199992c0706a19592-p3-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"where D = {<START$>,w_{1}\\ldots w_{K}\\}$"}]},{"id":"folio-18c199992c0706a19592-p3-b18-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We opt for bigrams as the highest order n-gram sup-ported by the model due to the genre difference between the model training material and the target OCR genre. Higher order n-grams are capable of capturing more genre-specific syntax (Jurafsky and Martin, 2020)-but we wish to capture only the local interactions between tokens, rather than overfitting to OBP syntax. Separate model instances are trained per decade of Pro-ceedings text to account for both linguistic and stylistic changes throughout the nineteenth century, as well as historical legal changes that alter the likelihood of the coverage of some criminal charges3."}]},{"id":"folio-18c199992c0706a19592-p3-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p3-b19-0-bold-p3-i106","type":"style/bold","start":0,"end":1},{"id":"folio-18c199992c0706a19592-p3-b19-0-bold-p3-i107","type":"style/bold","start":3,"end":36},{"id":"folio-18c199992c0706a19592-p3-b19-0-bold-p3-i109","type":"style/bold","start":38,"end":51}]},"inline":[{"kind":"text","text":"5. Model Evaluation and Creation of a Working Corpus"}]},{"id":"folio-18c199992c0706a19592-p3-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We begin by restricting the set of publications down to only London-based newspapers to align with the"}]},{"id":"folio-18c199992c0706a19592-p3-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"3A number of legal changes occurred over the nineteenth century that altered the parlance used to describe certain crimes (Emsley et al., 2018a)"}]},{"id":"folio-18c199992c0706a19592-p3-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"5861"}]},{"id":"folio-18c199992c0706a19592-p4-b0-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"London-centric nature of the Old Bailey Proceedings-"}]},{"id":"folio-18c199992c0706a19592-p4-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"a total of 17 publications out of the initial 61-down to 3,388,092 documents, a 75.9% initial reduction. We carry out this initial alignment as the vast majority of criminal histories present were individuals tried by the London courts, it follows therefore that we restrict news-paper coverage to London-based newspapers to max-imise the probability that a given document in the final corpus will link to the Digital Panopticon."}]},{"id":"folio-18c199992c0706a19592-p4-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p4-b4-0-bold-p4-i21","type":"style/bold","start":0,"end":3},{"id":"folio-18c199992c0706a19592-p4-b4-0-bold-p4-i22","type":"style/bold","start":5,"end":20}]},"inline":[{"kind":"text","text":"5.1. Model Evaluation"}]},{"id":"folio-18c199992c0706a19592-p4-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We sort this London-specific sub-corpus by its OCR quality score, assessed by calculating $S_{D}$ of each docu-ment in the corpus against its relevant decade-specific language model. Quality sorting is performed irrespec-tive of other data dimensions such as publication or decade, to avoid the loss of quality that would result from enforcing equal representation across the decades. We show the lead sentences from the first documents from the top five percentiles containing court related vocabulary, when ranked by $S_{D}$. For this analysis, we consider first names, last names, dates, locations, courts, and organisations as entities."}]},{"id":"folio-18c199992c0706a19592-p4-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1st percentile Gale: R3213129190"}]},{"id":"folio-18c199992c0706a19592-p4-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"A garrison court-martial was beld on Saturday, at the Royal Artillery barracks, for the trial of several prisoners charged with insubordination and desertion."}]},{"id":"folio-18c199992c0706a19592-p4-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"100% correct entities 96% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p4-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"2nd percentile Gale: GS3214952991"}]},{"id":"folio-18c199992c0706a19592-p4-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The Domestic Tragedy at Glasgow.-- William Agnew, a"}]},{"id":"folio-18c199992c0706a19592-p4-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"shoemaker, was at Glasgow"}]},{"id":"folio-18c199992c0706a19592-p4-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"yesterday remitted to the High Court charged with murdering his wife, aged 40, in their house on Sunday last."}]},{"id":"folio-18c199992c0706a19592-p4-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"100% correct entities 100% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p4-b24-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"3rd percentile Gale: R3211750099"}]},{"id":"folio-18c199992c0706a19592-p4-b26-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"W. M \"Millar, an inmate of Prestwich Asylum, was committed to the assizes charged with the"}]},{"id":"folio-18c199992c0706a19592-p4-b28-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"wilful murder of a fellow inmate"}]},{"id":"folio-18c199992c0706a19592-p4-b30-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"named Jones."}]},{"id":"folio-18c199992c0706a19592-p4-b32-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"80% correct entities 96% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p4-b34-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"4th percentile Gale: R3214433610"}]},{"id":"folio-18c199992c0706a19592-p4-b36-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"John James Dewar, a boy, was brought before the Tynemoiith County Magistrates yesterday charged with causing the death of a girl, named Jane O Brady, aged 11, by shooting her with a revolver at Wal!send."}]},{"id":"folio-18c199992c0706a19592-p4-b38-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"63% correct entities 91% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p4-b39-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"5th percentile Gale: R3212509988 On Thursday a man of the name of William Jami- so. , who represented hinis.lfto he a farmer, was brought before the magistrate at the Central Police Court, charged with having endeavoured to impose on Peter Wallace, spirit dealer i<> High-street. 83% correct entities 87% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p4-b40-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"From these examples, we see that the OCR exhibits a va-riety of errors that make automated named entity recog-nition and entity linkage tasks difficult-such as corrup-tion of names (e.g. W. M \"Millar), and locations (Tynemoiith). However, it is possible to capture the vast majority of relevant entities from documents in these quality bands."}]},{"id":"folio-18c199992c0706a19592-p4-b41-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We also assess the quality of lower quality bands as a means to further check the efficacy of the quality metric:"}]},{"id":"folio-18c199992c0706a19592-p4-b42-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"10th percentile Gale: R3214411435 Harry Walker, stoker, 24, of Mirfield, was indicted at Leeds Assizes yesterday for the murder of Mary Ann Chapman, whom he was alleged to have thrown over a bridge into the river at Dewsbury during a drunken nuarreL 100% correct entities 97% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p4-b43-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"25th percentile Gale: R3213557389 A Miser Charged with Theft.--At Belper en Tuesday a miser, named John .Vinson, who is report id to be worth £300, was committed for trial on a charge of stealing a spade. He has been previously convicted, acd seen s to have spent most of his time ia going about v. ith a poveitv-stiicken air begging. 75% correct entities 85% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p4-b44-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"50th percentile Gale: R3213585882 Julius Adolph Deintje was indicted for obtaining on credit and under falsa pretences furniture, value £75 55., from Messrs. Carl-dan and Beaumetz, furniture dealers, of 73, Great Eastern- street, ho haviug been adjudged bankrupt. 66% correct entities 78% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p4-b46-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"5862"}]},{"id":"folio-18c199992c0706a19592-p5-b0-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"75th percentile Gale: BC3207264134 In the .Scond Court, before Mr. Payne, two labtouriig c men, tantied Thauoiata Spickttt and T/tantus Crisp, weore ill-di t ad for .SS.ltiog sad beating George Mauley, a Iolic-constable, in th)e eecution Of hiu duty, in GUspel Vadi k fields, ilalnipstead. 40% correct entities 47% correct tokens 90th percentile Gale: BB3207096330 ' Yesterdaj't Gentleniani was charged vi!vh urossly in. fdulting another at Sadler't Wells, on ui i n;t, in consequence of Pa dispute .fdr a seat in o b); 0% correct entities 50% correct tokens"}]},{"id":"folio-18c199992c0706a19592-p5-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We may, given these additional analyses, consider the OCR metric reasonably effective, as lower rated exam-ples progressively contain comparatively lower amounts of usable information in most cases."}]},{"id":"folio-18c199992c0706a19592-p5-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p5-b2-0-bold-p5-i53","type":"style/bold","start":0,"end":3},{"id":"folio-18c199992c0706a19592-p5-b2-0-bold-p5-i54","type":"style/bold","start":5,"end":19}]},"inline":[{"kind":"text","text":"5.2. Corpus Analysis"}]},{"id":"folio-18c199992c0706a19592-p5-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"On the London-specific sub-corpus of 17 publications, we compute $S_{D}$ for every document D, and select the top 10% as our highest quality \"culled\" working corpus. This culled sub-corpus contains 338,810 documents of London-specific news items, a total reduction of 97.6% from the full, whole-UK corpus. We select the 10% interval as the cut-off as it provides a sufficiently large amount of high accuracy documents to perform down-stream NLP tasks. From the evaluation on the London-specific sub-corpus performed in section 5, we can see that at the 10% threshold, we still have predominantly accurate OCR, with the quality degrading at a much lower threshold."}]},{"id":"folio-18c199992c0706a19592-p5-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The final working corpus shows significant skew to-wards the most document-dense publications as depicted in figure 3, with a similarly depicted skew towards the end of the nineteenth century-an expected result, as these document-rich areas will have a greater capacity to contain higher quality OCR by virtue of volume alone. In this final corpus, the bulk of our high quality data belongs to The Morning Post and The Standard-which constitute 87.2% of our working corpus, in contrast to their initial 17.4% corpus share. Using this model and metric as a culling mechanism to remove noisy OCR has allowed us to produce a working corpus of only 3.4% of the initial BLN corpus-a still substantial corpus of 338,810 documents-that we can now use in later project efforts to perform named entity recognition, entity linkage, and relation extraction."}]},{"id":"folio-18c199992c0706a19592-p5-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p5-b5-0-bold-p5-i39","type":"style/bold","start":0,"end":1},{"id":"folio-18c199992c0706a19592-p5-b5-0-bold-p5-i40","type":"style/bold","start":3,"end":12}]},"inline":[{"kind":"text","text":"6. Conclusion"}]},{"id":"folio-18c199992c0706a19592-p5-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In this paper we have formulated a language model-based OCR transcription quality evaluation methodol-ogy by employing near-gold standard sources of adja-cent genre, to assess the transcription quality of histori-cal sources, where an existing quality metric is either in-appropriate or non-existent. We assess the transcription quality of the British Library Newspapers corpus with a bias towards London-centric crime reports, by creating decade-specific language models of the Proceedings of the Old Bailey Online-a corpus of trial documentation of the Old Bailey, that provides and contextualises legal vocabulary, common parlance, and London-specific en-tities/locations. We apply the scoring models over the entire BLN parts 1 and 2 corpora, and use the resulting quality metric to cull the documents down to the top decile of highest quality OCR, for use in later NLP tasks. Our evaluation shows that the language model-based approach to OCR quality ranking that we have proposed is effective in identifying OCR'ed documents with a high proportion of correct entities and tokens."}]},{"id":"folio-18c199992c0706a19592-p5-p5_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"302px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:bde32eee3758af337da00f571e33735c1efbcd5528a69707502c7cac6f2afa58"}}},{"id":"folio-18c199992c0706a19592-p5-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Figure 3: Heatmap breakdown of document count over each year and publication in working corpus."}]},{"id":"folio-18c199992c0706a19592-p5-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p5-b9-0-bold-p5-i84","type":"style/bold","start":0,"end":1}]},"inline":[{"kind":"text","text":"7."}]},{"id":"folio-18c199992c0706a19592-p5-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Emsley, C., (2018a). the old https://www.oldbaileyonline.org/ static/Crimes.jsp. version 8.0. Emsley, R. (2018b). this project, https://www.oldbaileyonline.org/ static/Project.jsp. version 8.0. Gale. (2022). British library newspapers. https:// www.gale.com/intl/primary-sources/ british-library-newspapers. Hitchcock,"}]},{"id":"folio-18c199992c0706a19592-p5-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"S., and McLaughlin, proceedings oldbaileyonline.org. version 8.0."}]},{"id":"folio-18c199992c0706a19592-p5-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p5-b16-0-bold-p5-i85","type":"style/bold","start":0,"end":25}]},"inline":[{"kind":"text","text":"Bibliographical References"}]},{"id":"folio-18c199992c0706a19592-p5-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Hitchcock, T., and Shoemaker, R. Crime and justice - crimes tried at bailey, old bailey proceedings online."}]},{"id":"folio-18c199992c0706a19592-p5-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"C., Hitchcock, T.,"}]},{"id":"folio-18c199992c0706a19592-p5-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"and Shoemaker, Old bailey online - about old bailey proceedings online."}]},{"id":"folio-18c199992c0706a19592-p5-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"T., Shoemaker, R., Emsley, C., Howard,"}]},{"id":"folio-18c199992c0706a19592-p5-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"J. (2018). The old bailey online, 1674-1913. https://www."}]},{"id":"folio-18c199992c0706a19592-p5-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"5863"}]},{"id":"folio-18c199992c0706a19592-p6-b0-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p6-b0-0-italics-p6-i6","type":"style/italics","start":150,"end":200},{"id":"folio-18c199992c0706a19592-p6-b0-0-italics-p6-i10","type":"style/italics","start":302,"end":349},{"id":"folio-18c199992c0706a19592-p6-b0-0-italics-p6-i13","type":"style/italics","start":423,"end":475},{"id":"folio-18c199992c0706a19592-p6-b0-0-italics-p6-i17","type":"style/italics","start":633,"end":685},{"id":"folio-18c199992c0706a19592-p6-b0-0-italics-p6-i21","type":"style/italics","start":821,"end":869},{"id":"folio-18c199992c0706a19592-p6-b0-0-italics-p6-i26","type":"style/italics","start":975,"end":1026}]},"inline":[{"kind":"text","text":"Holley, R. (2009). How good can it get? Analysing and improving OCR accuracy in large scale historic newspaper digitisation programs. D-Lib Magazine: The Magazine of the Digital Library Forum, 15(3/4). Hsu, B.-J. (2007). Generalized linear interpolation of language models. In 2007 IEEE Workshop on Au-tomatic Speech Recognition Understanding (ASRU), pages 136 - 140. Jurafsky, D. and Martin, J. H., (2020). Speech and Lan-guage Processing, chapter 3. Stanford, third edition. Nartker, T., Rice, S., and Lumos, S. (2005). Software tools and test data for research and testing of page-reading OCR systems. In Document Recognition and Retrieval XII, pages 37-47. International Society for Optics and Photonics, SPIE. Neudecker, C., Baierer, K., Gerber, M., Christian, C., Apostolos, A., and Stefan, P., (2021). A Survey of OCR Evaluation Tools and Metrics, page 13-18. As-sociation for Computing Machinery, New York, NY, USA. Rice, S. V. (1996). Measuring the accuracy of page-reading systems. Ph.D. thesis, University of Nevada, Las Vegas, NV. Schneider, P. (2021). Rerunning OCR: A machine learning approach to quality assessment and enhance-ment prediction. Springmann, U. and Lüdeling, A. (2017). Ocr of his-torical printings with an application to building di-achronic corpora: A case study using the RIDGES herbal corpus. Strange, C., McNamara, D., Wodak, J., and Wood, I. (2014). Mining for the meanings of a murder: the im-pact of OCR quality on the use of digitized historical newspapers. Digital Humanities Quarterly, 8. Traub, M. C., van Ossenbruggen, J., and Hardman, L."}]},{"id":"folio-18c199992c0706a19592-p6-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-18c199992c0706a19592-p6-b5-0-italics-p6-i47","type":"style/italics","start":160,"end":210},{"id":"folio-18c199992c0706a19592-p6-b5-0-italics-p6-i54","type":"style/italics","start":438,"end":491}]},"inline":[{"kind":"text","text":"(2015). Impact analysis of OCR quality on research tasks in digital archives. In Sarantos Kapidakis, et al., editors, Research and Advanced Technology for Digi-tal Libraries, pages 252-263, Cham. Springer Inter-national Publishing. van Strien, D., Beelen, K., Coll Ardanuy, M., Hosseini, K., Mcgillivray, B., and Colavizza, G. (2020). As-sessing the impact of OCR quality on downstream NLP tasks. In Proceedings of the 12th International Conference on Agents and Artificial Intelligence, vol-ume 1. www.digitalpanopticon.org. (2022). The"}]},{"id":"folio-18c199992c0706a19592-p6-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"digital panopticon: Tracing london con-victs in britain and australia, 1780-1925. https://www.digitalpanopticon.org."}]},{"id":"folio-18c199992c0706a19592-p6-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"5864"}]}]},"definitionOwnerBlockIds":[]}
