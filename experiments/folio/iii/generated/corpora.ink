daff46682585f78d70-p3-b1-2"}},{"placementId":"placement-folio-efdaff46682585f78d70-p3-b1-3","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p3-b1-3"}},{"placementId":"placement-folio-efdaff46682585f78d70-p3-b2-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p3-b2-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p3-b2-1","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p3-b2-1"}},{"placementId":"placement-folio-efdaff46682585f78d70-p3-b2-2","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p3-b2-2"}},{"placementId":"placement-folio-efdaff46682585f78d70-p3-b2-3","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p3-b2-3"}},{"placementId":"placement-folio-efdaff46682585f78d70-p3-b2-4","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p3-b2-4"}},{"placementId":"placement-folio-efdaff46682585f78d70-p3-b2-5","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p3-b2-5"}},{"placementId":"placement-folio-efdaff46682585f78d70-p3-b4-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p3-b4-0"}}]},{"id":"folio-efdaff46682585f78d70-p1-p1_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-efdaff46682585f78d70-p1-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"corporaexplorer: An R package for dynamic exploration of text collections"}]},{"id":"folio-efdaff46682585f78d70-p1-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b2-0-bold-p1-i4","type":"style/bold","start":0,"end":23}]},"inline":[{"kind":"text","text":"DOI: 10.21105/joss.01342"}]},{"id":"folio-efdaff46682585f78d70-p1-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b3-0-bold-p1-i5","type":"style/bold","start":0,"end":7}]},"inline":[{"kind":"text","text":"Software"}]},{"id":"folio-efdaff46682585f78d70-p1-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Review"}]},{"id":"folio-efdaff46682585f78d70-p1-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Repository"}]},{"id":"folio-efdaff46682585f78d70-p1-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Archive"}]},{"id":"folio-efdaff46682585f78d70-p1-b6-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b6-1-bold-p1-i12","type":"style/bold","start":0,"end":23},{"id":"folio-efdaff46682585f78d70-p1-b6-1-bold-p1-i15","type":"style/bold","start":25,"end":34}]},"inline":[{"kind":"text","text":"Submitted: 17 March 2019 Published: 13 June 2019"}]},{"id":"folio-efdaff46682585f78d70-p1-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b7-0-bold-p1-i19","type":"style/bold","start":0,"end":6}]},"inline":[{"kind":"text","text":"License"}]},{"id":"folio-efdaff46682585f78d70-p1-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Authors of papers retain copyright and release the work under a Creative Commons Attribution 4.0 International License (CC-BY)."}]},{"id":"folio-efdaff46682585f78d70-p1-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b9-0-bold-p1-i3","type":"style/bold","start":0,"end":22}]},"inline":[{"kind":"text","text":"Kristian Lundby Gjerde1"}]},{"id":"folio-efdaff46682585f78d70-p1-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b10-0-bold-p1-i6","type":"style/bold","start":0,"end":69}]},"inline":[{"kind":"text","text":"1 Research Fellow, Norwegian Institute of International Affairs (NUPI)"}]},{"id":"folio-efdaff46682585f78d70-p1-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b11-0-bold-p1-i8","type":"style/bold","start":0,"end":9}]},"inline":[{"kind":"text","text":"Background"}]},{"id":"folio-efdaff46682585f78d70-p1-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Computer technology has profoundly changed the possibilities for doing research with text as data. Terms such as 'computational social science' (see Lazer et al., 2009) and 'digital human-ities' (see Gold & Klein, 2016) are now firmly established, indicating how new methods have transformed entire fields of scholarly enquiry, enabling researchers to do things unimaginable even a few years ago. For good reasons - computers excel in quantitative tasks - these ad-vances have been predominantly quantitatively oriented, geared towards 'big data' of various sizes. However, developments in software and hardware have also opened up vast fields of immensely helpful - and often untapped - possibilities for many scholars engaged in various forms of qualitative text analysis."}]},{"id":"folio-efdaff46682585f78d70-p1-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b13-0-bold-p1-i33","type":"style/bold","start":0,"end":28}]},"inline":[{"kind":"text","text":"The corporaexplorer R package"}]},{"id":"folio-efdaff46682585f78d70-p1-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"work for dynamic exploration of text collections. The package is designed for use with a wide range of text collections; one example could be a collection of tens of thousands of docu-ments scraped from a governmental website; another example could be the collected works of a novelist; a third example could be the chapters of a single book."}]},{"id":"folio-efdaff46682585f78d70-p1-b14-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The intended primary audience are qualitatively oriented researchers in the social sciences and humanities who rely on close reading of textual documents as part of their academic activity. However, the package should also be useful for those doing quantitative textual research and wishing to have convenient access to the texts under study. The chief aim of"}]},{"id":"folio-efdaff46682585f78d70-p1-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"a typical use case would be an open-ended exploration of text collections in order to identify and extract texts for further scrutiny, the package is above all aimed at flexibility: it does not enforce any given workflow, but may play a small or larger role in many different research designs."}]},{"id":"folio-efdaff46682585f78d70-p1-b16-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The intention is also to encourage mixed methods in text analysis, by using corporaex-"}]},{"id":"folio-efdaff46682585f78d70-p1-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"analysis (for a highly useful review, see Welbers, Van Atteveldt, & Benoit, 2017), and to encourage (licences permitting) the sharing of text collections."}]},{"id":"folio-efdaff46682585f78d70-p1-b18-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The corporaexplorer concept is simple, yet has the potential to enhance research work with text collections in a powerful way. Main elements in the interactive apps:"}]},{"id":"folio-efdaff46682585f78d70-p1-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Input: The ability to filter the corpus and/or highlight documents, based on search patterns (in main text or metadata, including date range)."}]},{"id":"folio-efdaff46682585f78d70-p1-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Corpus visualisation: An interactive heat-map of the corpus, based on the search input (calendar heat-map or heat-map where each tile represents one document, optionally grouped by metadata properties)."}]},{"id":"folio-efdaff46682585f78d70-p1-b23-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"corporaexplorer is an R package that uses the Shiny GUI (graphical user interface) frame-"}]},{"id":"folio-efdaff46682585f78d70-p1-b24-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"corporaexplorer is to facilitate more powerful, transparent, and efficient workflows."}]},{"id":"folio-efdaff46682585f78d70-p1-b25-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"While"}]},{"id":"folio-efdaff46682585f78d70-p1-b26-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"plorer in combination with the excellent R packages that are available for quantitative text"}]},{"id":"folio-efdaff46682585f78d70-p1-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p1-b22-0-italics-p1-i121","type":"style/italics","start":91,"end":135}]},"inline":[{"kind":"text","text":"Gjerde, (2019). corporaexplorer: An R package for dynamic exploration of text collections. Journal of Open Source Software, 4(38), 1342. 1 https://doi.org/10.21105/joss.01342"}]},{"id":"folio-efdaff46682585f78d70-p2-p2_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-efdaff46682585f78d70-p2-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Document visualisation and display: Easy navigation to and within full-text docu-ments with pattern matches highlighted."}]},{"id":"folio-efdaff46682585f78d70-p2-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Document retrieval: Extraction of subsets of the corpus in a format suitable for close reading."}]},{"id":"folio-efdaff46682585f78d70-p2-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The API and GUI of corporaexplorer, as well as the inner workings of the package, are documented more thoroughly in the README file included with the package."}]},{"id":"folio-efdaff46682585f78d70-p2-b3-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"While collecting and preparing the text collections to be explored requires some familiarity with R programming, using the Shiny apps for exploring and extracting documents from the corpus should be fairly intuitive also for those with no programming knowledge, once the apps have been set up by a collaborator. Thus, the aim is for the package to be useful for anyone with a rudimentary knowledge of R - or with collaborators who have such knowledge."}]},{"id":"folio-efdaff46682585f78d70-p2-p2_2","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"515px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:89cc6112c97d9b67e53574b78305c3c4438e66d2e5a5d85680b627874c179289"}}},{"id":"folio-efdaff46682585f78d70-p2-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p2-b5-0-bold-p2-i22","type":"style/bold","start":0,"end":8}]},"inline":[{"kind":"text","text":"Figure 1: Illustration screenshots. To the left: part of interactive corpus heat-map displaying oc-curences of Moses and Abraham in the King James Bible. In the middle: part of interactive corpus calendar heat-map displaying occurences of 'orthodox' in a collection of transcripts from the Russian president's website. To the right: document view with interactive document map and highlighted pattern matches."}]},{"id":"folio-efdaff46682585f78d70-p2-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p2-b6-0-bold-p2-i39","type":"style/bold","start":0,"end":16}]},"inline":[{"kind":"text","text":"Main dependencies"}]},{"id":"folio-efdaff46682585f78d70-p2-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"the shiny (Chang, Cheng, Allaire, Xie, & McPherson, 2018) framework. The plots are built with ggplot2 (Wickham, 2016). For searches and string operations, stringi (Gagolewski, 2019)/stringr (Wickham, 2019) and re2r (Qin Wenfeng, 2017) are used (details can be"}]},{"id":"folio-efdaff46682585f78d70-p2-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"fast search operations in the document term matrix. For other data operations, functions from various tidyverse (Wickham, 2017) packages are used. Other R packages utilised can be found in corporaexplorer's DESCRIPTION file."}]},{"id":"folio-efdaff46682585f78d70-p2-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p2-b11-0-bold-p2-i57","type":"style/bold","start":0,"end":15}]},"inline":[{"kind":"text","text":"Acknowledgements"}]},{"id":"folio-efdaff46682585f78d70-p2-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Power Political Repertoires (EPOS)' (project no. 250419), funded by the Research Council of Norway."}]},{"id":"folio-efdaff46682585f78d70-p2-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p2-b14-0-bold-p2-i62","type":"style/bold","start":0,"end":9}]},"inline":[{"kind":"text","text":"References"}]},{"id":"folio-efdaff46682585f78d70-p2-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p2-b15-0-italics-p2-i64","type":"style/italics","start":68,"end":73},{"id":"folio-efdaff46682585f78d70-p2-b15-0-italics-p2-i65","type":"style/italics","start":75,"end":89},{"id":"folio-efdaff46682585f78d70-p2-b15-0-italics-p2-i66","type":"style/italics","start":91,"end":162}]},"inline":[{"kind":"text","text":"Chang, W., Cheng, J., Allaire, J., Xie, Y., & McPherson, J. (2018). shiny: Web application framework for R. Retrieved from https://CRAN.R-project.org/package=shiny"}]},{"id":"folio-efdaff46682585f78d70-p2-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"corporaexplorer is an R (R Core Team, 2018) package. The interactive apps are built with"}]},{"id":"folio-efdaff46682585f78d70-p2-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"found in the package documentation)."}]},{"id":"folio-efdaff46682585f78d70-p2-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"data.table (Dowle & Srinivasan, 2019) is used for"}]},{"id":"folio-efdaff46682585f78d70-p2-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"corporaexplorer has been developed with support from the research project 'Evaluating"}]},{"id":"folio-efdaff46682585f78d70-p2-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p2-b17-0-italics-p2-i71","type":"style/italics","start":91,"end":135}]},"inline":[{"kind":"text","text":"Gjerde, (2019). corporaexplorer: An R package for dynamic exploration of text collections. Journal of Open Source Software, 4(38), 1342. 2 https://doi.org/10.21105/joss.01342"}]},{"id":"folio-efdaff46682585f78d70-p3-p3_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-efdaff46682585f78d70-p3-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b1-0-italics-p3-i1","type":"style/italics","start":36,"end":46},{"id":"folio-efdaff46682585f78d70-p3-b1-0-italics-p3-i2","type":"style/italics","start":48,"end":73}]},"inline":[{"kind":"text","text":"Dowle, M., & Srinivasan, A. (2019). data.table: Extension of 'data.frame'. Retrieved from https://CRAN.R-project.org/package=data.table"}]},{"id":"folio-efdaff46682585f78d70-p3-b1-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b1-1-italics-p3-i6","type":"style/italics","start":23,"end":40},{"id":"folio-efdaff46682585f78d70-p3-b1-1-italics-p3-i7","type":"style/italics","start":42,"end":80}]},"inline":[{"kind":"text","text":"Gagolewski, M. (2019). R package stringi: Character string processing facilities. Retrieved from http://www.gagolewski.com/software/stringi/"}]},{"id":"folio-efdaff46682585f78d70-p3-b1-2","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b1-2-italics-p3-i12","type":"style/italics","start":44,"end":77},{"id":"folio-efdaff46682585f78d70-p3-b1-2-italics-p3-i13","type":"style/italics","start":79,"end":83}]},"inline":[{"kind":"text","text":"Gold, M. K., & Klein, L. F. (Eds.). (2016). Debates in the digital humanities: 2016. Min-neapolis, MN: University of Minnesota Press."}]},{"id":"folio-efdaff46682585f78d70-p3-b1-3","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Lazer, D., Pentland, A., Adamic, L., Aral, S., Barabási, A.-L., Brewer, D., Christakis, N., et al. (2009). Computational social science. Science, 323(5915), 721-723. doi:10.1126/science. 1167742"}]},{"id":"folio-efdaff46682585f78d70-p3-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b2-0-italics-p3-i22","type":"style/italics","start":21,"end":25},{"id":"folio-efdaff46682585f78d70-p3-b2-0-italics-p3-i23","type":"style/italics","start":27,"end":88}]},"inline":[{"kind":"text","text":"Qin Wenfeng. (2017). re2r: RE2 regular expression. Retrieved from https://CRAN.R-project. org/package=re2r"}]},{"id":"folio-efdaff46682585f78d70-p3-b2-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b2-1-italics-p3-i26","type":"style/italics","start":21,"end":76}]},"inline":[{"kind":"text","text":"R Core Team. (2018). R: A language and environment for statistical computing. Vienna: R Foundation for Statistical Computing. Retrieved from https://www.R-project.org/"}]},{"id":"folio-efdaff46682585f78d70-p3-b2-2","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b2-2-italics-p3-i34","type":"style/italics","start":73,"end":85},{"id":"folio-efdaff46682585f78d70-p3-b2-2-italics-p3-i35","type":"style/italics","start":87,"end":157}]},"inline":[{"kind":"text","text":"Welbers, K., Van Atteveldt, W., & Benoit, K. (2017). Text analysis in R. Communication Methods and Measures, 11(4), 245-265. doi:10.1080/19312458.2017.1387238"}]},{"id":"folio-efdaff46682585f78d70-p3-b2-3","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b2-3-italics-p3-i37","type":"style/italics","start":20,"end":63}]},"inline":[{"kind":"text","text":"Wickham, H. (2016). ggplot2: Elegant graphics for data analysis. New York: Springer-Verlag. Retrieved from http://ggplot2.org"}]},{"id":"folio-efdaff46682585f78d70-p3-b2-4","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b2-4-italics-p3-i41","type":"style/italics","start":20,"end":29},{"id":"folio-efdaff46682585f78d70-p3-b2-4-italics-p3-i42","type":"style/italics","start":31,"end":70}]},"inline":[{"kind":"text","text":"Wickham, H. (2017). tidyverse: Easily install and load the 'tidyverse'. Retrieved from https: //CRAN.R-project.org/package=tidyverse"}]},{"id":"folio-efdaff46682585f78d70-p3-b2-5","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b2-5-italics-p3-i46","type":"style/italics","start":20,"end":27},{"id":"folio-efdaff46682585f78d70-p3-b2-5-italics-p3-i47","type":"style/italics","start":29,"end":66},{"id":"folio-efdaff46682585f78d70-p3-b2-5-italics-p3-i48","type":"style/italics","start":68,"end":85}]},"inline":[{"kind":"text","text":"Wickham, H. (2019). stringr: Simple, consistent wrappers for common string operations. Retrieved from https://CRAN.R-project.org/package=stringr"}]},{"id":"folio-efdaff46682585f78d70-p3-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-efdaff46682585f78d70-p3-b4-0-italics-p3-i54","type":"style/italics","start":91,"end":135}]},"inline":[{"kind":"text","text":"Gjerde, (2019). corporaexplorer: An R package for dynamic exploration of text collections. Journal of Open Source Software, 4(38), 1342. 3 https://doi.org/10.21105/joss.01342"}]}]},"definitionOwnerBlockIds":[]}
