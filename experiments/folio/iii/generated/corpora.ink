d","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p1-b24-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p1-b25-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p1-b25-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p1-b26-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p1-b26-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p1-b22-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p1-b22-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-p2_1","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-p2_1"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-b1-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-b1-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-b2-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-b2-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-b3-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-b3-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-b3-1","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-b3-1"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-p2_2","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-p2_2"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-b5-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-b5-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-b6-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-b6-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-b8-0","kind":"owned","target":{"kind":"local","blockId":"folio-efdaff46682585f78d70-p2-b8-0"}},{"placementId":"placement-folio-efdaff46682585f78d70-p2-b10-0","kind":"owned","target":{"kind":"local","