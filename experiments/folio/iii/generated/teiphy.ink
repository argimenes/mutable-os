6509e60a547a86f2098a-p9-b1-5"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b1-6","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b1-6"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b1-7","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b1-7"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b1-8","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b1-8"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b1-9","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b1-9"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b1-10","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b1-10"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b1-11","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b1-11"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b1-12","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b1-12"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b10-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b10-0"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b12-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b12-0"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b12-1","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b12-1"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p9-b15-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p9-b15-0"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-p10_1","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-p10_1"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b1-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b1-0"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b2-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b2-0"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b2-1","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b2-1"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b2-2","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b2-2"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b3-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b3-0"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b3-1","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b3-1"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b3-2","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b3-2"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b3-3","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b3-3"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b6-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b6-0"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b6-1","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b6-1"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b7-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b7-0"}},{"placementId":"placement-folio-6509e60a547a86f2098a-p10-b9-0","kind":"owned","target":{"kind":"local","blockId":"folio-6509e60a547a86f2098a-p10-b9-0"}}]},{"id":"folio-6509e60a547a86f2098a-p1-p1_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-6509e60a547a86f2098a-p1-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy: A Python Package for Converting TEI XML"}]},{"id":"folio-6509e60a547a86f2098a-p1-b1-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Collations to NEXUS and Other Formats"}]},{"id":"folio-6509e60a547a86f2098a-p1-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b2-0-bold-p1-i3","type":"style/bold","start":0,"end":12},{"id":"folio-6509e60a547a86f2098a-p1-b2-0-bold-p1-i5","type":"style/bold","start":16,"end":34}]},"inline":[{"kind":"text","text":"Joey McCollum 1 and Robert Turnbull 2"}]},{"id":"folio-6509e60a547a86f2098a-p1-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b3-0-bold-p1-i7","type":"style/bold","start":0,"end":104},{"id":"folio-6509e60a547a86f2098a-p1-b3-0-bold-p1-i9","type":"style/bold","start":160,"end":183}]},"inline":[{"kind":"text","text":"1 Institute for Religion and Critical Inquiry, Australian Catholic University, Australia 2 Melbourne Data Analytics Platform, University of Melboune, Australia DOI: 10.21105/joss.04879"}]},{"id":"folio-6509e60a547a86f2098a-p1-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b4-0-bold-p1-i10","type":"style/bold","start":0,"end":7}]},"inline":[{"kind":"text","text":"Software"}]},{"id":"folio-6509e60a547a86f2098a-p1-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b5-0-bold-p1-i12","type":"style/bold","start":0,"end":6}]},"inline":[{"kind":"text","text":"Summary • Review"}]},{"id":"folio-6509e60a547a86f2098a-p1-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Repository"}]},{"id":"folio-6509e60a547a86f2098a-p1-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Textual scholars have been using phylogenetics to analyze manuscript traditions since the • Archive early 1990s (Robinson & O'Hara, 1992). Many standard phylogenetic software packages accept as input the NEXUS file format (Maddison et al., 1997). The program takes"}]},{"id":"folio-6509e60a547a86f2098a-p1-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p1-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"a collation of texts encoded in TEI XML format and can convert it to any of the following Mark A. Jensen"}]},{"id":"folio-6509e60a547a86f2098a-p1-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b10-0-bold-p1-i25","type":"style/bold","start":0,"end":6},{"id":"folio-6509e60a547a86f2098a-p1-b10-0-bold-p1-i29","type":"style/bold","start":96,"end":105}]},"inline":[{"kind":"text","text":"Editor: formats amenable to phylogenetic analysis: NEXUS (with support for ambiguous states and Reviewers: clock model calibration data blocks for MrBayes or BEAST2), Hennig86, PHYLIP (relaxed"}]},{"id":"folio-6509e60a547a86f2098a-p1-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• @tresoldi for use with RAxML), FASTA (relaxed for use with RAxML), and STEMMA (designed for • @SimonGreenhill Stephen C. Carlson's stemmatic software tailored for textual data). For machine learning-based"}]},{"id":"folio-6509e60a547a86f2098a-p1-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"analyses, can also convert a TEI XML collation to a collation matrix in NumPy, Pandas"}]},{"id":"folio-6509e60a547a86f2098a-p1-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b13-0-bold-p1-i42","type":"style/bold","start":0,"end":27}]},"inline":[{"kind":"text","text":"Submitted: 22 September 2022 teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p1-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"DataFrame, CSV, TSV, or Excel format."}]},{"id":"folio-6509e60a547a86f2098a-p1-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b15-0-bold-p1-i44","type":"style/bold","start":0,"end":26}]},"inline":[{"kind":"text","text":"Published: 19 December 2022"}]},{"id":"folio-6509e60a547a86f2098a-p1-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b16-0-bold-p1-i45","type":"style/bold","start":0,"end":6},{"id":"folio-6509e60a547a86f2098a-p1-b16-0-bold-p1-i47","type":"style/bold","start":8,"end":24}]},"inline":[{"kind":"text","text":"License Statement of Need"}]},{"id":"folio-6509e60a547a86f2098a-p1-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Authors of papers retain copyright and release the work under a Creative Commons Attribution 4.0 For over a decade, the Text Encoding Initiative has endeavored to provide an international International License (CC BY 4.0). standard for digitally encoding textual information for the humanities (Ide & Sperberg-McQueen,"}]},{"id":"folio-6509e60a547a86f2098a-p1-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1995). Their guidelines describe a standard format for encoding material details, textual transcriptions, and critical apparatuses (TEI Consortium, 2022). Due to its rich and well-documented set of elements for expressing a wide range of features in these settings, the Text Encoding Initiative's Extensible Markup Language format (hereafter abbreviated TEI XML) has become the de facto format for textual data in the digital humanities (Fischer, 2020). Its expressive power has proven increasingly valuable since its release, as scholars have learned-sometimes the hard way-that digital transcriptions and collations should"}]},{"id":"folio-6509e60a547a86f2098a-p1-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1. preserve as much detail as they can from their material sources, including paratextual features;"}]},{"id":"folio-6509e60a547a86f2098a-p1-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"2. reproduce the text of their sources as closely as possible, with editorial regularizations to things like orthography, accentuation, and scribal shorthand encoded alongside rather than in place of the source text; and"}]},{"id":"folio-6509e60a547a86f2098a-p1-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"3. describe uncertainties about a source's contents as accurately as possible, allowing for degrees of uncertainty and multiple choices for disambiguations if necessary."}]},{"id":"folio-6509e60a547a86f2098a-p1-b22-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"These principles have much bearing on the editing of critical texts, a task fundamental to the field of philology. Phylogenetic algorithms developed in the context of evolutionary biology have been popular approaches to this task, especially as philology itself has taken a digital turn over the years. Taking the most arduous part of reconstructing a textual tradition and delegating it to a computer proved to be a promising technique, and its successful demonstration with a portion of The Canterbury Tales was a milestone in the development of the field (Barbrook et al., 1998). Soon after this, the same methods were applied more comprehensively to the tradition of Lanseloet van Denemerken in a work that would formalize many practical rules"}]},{"id":"folio-6509e60a547a86f2098a-p1-b24-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p1-b24-0-italics-p1-i97","type":"style/italics","start":135,"end":163}]},"inline":[{"kind":"text","text":"McCollum, & Turnbull. (2022). teiphy: A Python Package for Converting TEI XML Collations to NEXUS and Other Formats. Journal of Open 1 Source Software, 7(80), 4879. https://doi.org/10.21105/joss.04879."}]},{"id":"folio-6509e60a547a86f2098a-p2-p2_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-6509e60a547a86f2098a-p2-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"for computer-assisted textual criticism (Salemans, 2000). Over the decades preceding and following these developments, biologists have continued to develop and improve phylogenetic methods (Felsenstein, 2004), and textual critics have adapted these improvements and even added their own innovations to make the process more suitable for their purposes (Carlson, 2015; Edmondson, 2019; Hyytiäinen, 2021; Spencer et al., 2002, 2004; Turnbull, 2020)."}]},{"id":"folio-6509e60a547a86f2098a-p2-b1-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Phylogenetic algorithms have a natural place in textual criticism given the deep analogy between textual traditions and evolutionary trees of life: a sequence alignment, which consists of taxa, sites or characters, and the states of taxa at those characters, corresponds almost identically to a collation, which consists of witnesses to the text, locations of textual variation (which we will call \"variation units\" from here on), and the variant readings attested by witnesses at those points."}]},{"id":"folio-6509e60a547a86f2098a-p2-b1-2","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The problem is that no currently available phylogenetic software accepts inputs in TEI XML format. Instead, most phylogenetic programs expect inputs in NEXUS format (Maddison et al., 1997). This format was conceived with versatility-including use in stemmatic and non-biological applications-in mind, and this design choice has been vindicated in its general applicability, but NEXUS is neither equipped nor meant to express the same kinds of details that TEI XML is. Conversely, for those interested primarily in working with the collation as an alignment, TEI XML is overkill. Thus, a chasm continues to separate data born in the digital humanities from phylogenetic tools born in the biological sciences, and the only way to bridge it is by conversion."}]},{"id":"folio-6509e60a547a86f2098a-p2-b1-3","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The challenge is made more daunting by the variety of tools available for phylogenetic and other analyses, some of which expect inputs other than NEXUS files or NEXUS files augmented in different ways. For instance, the cladistic software PAUP*, which has historically been the tool of choice for text-critical applications that evaluate candidate trees using the criterion of maximum parsimony, reads inputs in NEXUS format (Swofford, 2003), but the TNT software, its main competitor among maximum parsimony-based programs, expects inputs in Hennig86 format (Farris, 1988; Goloboff & Catalano, 2016). While Hennig86 format does not allow for as much flexibility in the input as NEXUS does (e.g., it does not support ambiguous character states that can be disambiguated as some states but not others), TNT's extensive support for morphological state models makes it potentially more suitable for textual data, and textual critics may prefer it to PAUP*. In the same regime, Stephen C. Carlson's STEMMA software, initially developed for the cladistic analysis of biblical texts known to be affected by contamination, makes substantial adaptations to the basic maximum-parsimony phylogenetic approach to account for this problem and other constraints common in a text-critical setting (Carlson, 2015); however, the input collation data must be provided in a STEMMA-specific format. Likewise, among programs that use the maximum likelihood criterion instead of maximum parsimony, IQ-TREE accepts inputs in NEXUS format (Minh et al., 2020), but RAxML interfaces primarily with inputs in PHYLIP and FASTA format (Stamatakis, 2014). Finally, for phylogenetic programs that attempt to estimate the posterior distribution of candidate trees in a Bayesian fashion, MrBayes and BEAST2 both accept inputs in NEXUS format (or can convert NEXUS inputs to their standard input format), but they expect taxon dates (for the calibration of evolutionary clock models) to be specified in the NEXUS file in different code blocks (Bouckaert et al., 2019; Ronquist et al., 2012)."}]},{"id":"folio-6509e60a547a86f2098a-p2-b1-4","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Furthermore, end users of textual collations may be interested in non-phylogenetic analyses. In this case, the desired input format is often not a NEXUS-style sequence alignment, but a collation matrix with a row for each variant reading and a column for each witness (or vice-versa). For Python machine-learning libraries like Scikit-learn (Pedregosa et al., 2011), NIMFA (Zitnik & Zupan, 2012), and TensorFlow (Abadi et al., 2015), the standard input format is a NumPy array (Harris et al., 2020), although Pandas DataFrames, which support row and column labels (McKinney, 2010; The pandas development team, 2020), may also be supported. (The latter format also extends the conversion pipeline to many other formats, including CSV, TSV, and Excel files; Pandas DataFrames can even write their contents to database tables.) To give an example, the text of the New Testament has served as a testbed"}]},{"id":"folio-6509e60a547a86f2098a-p2-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p2-b3-0-italics-p2-i87","type":"style/italics","start":135,"end":163}]},"inline":[{"kind":"text","text":"McCollum, & Turnbull. (2022). teiphy: A Python Package for Converting TEI XML Collations to NEXUS and Other Formats. Journal of Open 2 Source Software, 7(80), 4879. https://doi.org/10.21105/joss.04879."}]},{"id":"folio-6509e60a547a86f2098a-p3-p3_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-6509e60a547a86f2098a-p3-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"for multiple analyses of this type, which have generally applied clustering and biclustering algorithms to collation matrices (Baldwin, 2010; Finney, 2018; McCollum, 2019; Thorpe, 2002; Willker, 2008). Given the prevalence of efforts like these, the need for a means of converting TEI XML collations to NumPy collation matrices or labeled Pandas DataFrames is clear."}]},{"id":"folio-6509e60a547a86f2098a-p3-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p3-b2-0-bold-p3-i7","type":"style/bold","start":0,"end":5}]},"inline":[{"kind":"text","text":"Design"}]},{"id":"folio-6509e60a547a86f2098a-p3-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"While the conversion process is a straightforward one for most collation data, various sources of ambiguity can make a one-to-one mapping of witnesses to readings impossible. One such source of ambiguity is lacunae, or gaps in the text due to erasure, faded ink, or damage to the page. Another is retroversions, or readings in the original language of the text reconstructed through the back-translation of subsequent versions of the text in other languages. Mechanisms for modeling ambiguous states resulting from situations like these exist in both TEI XML and NEXUS, and in both parsimony- and likelihood-based phylogenetic methods, ambiguities about the states at the leaves and even at the root of the tree can be encoded and leveraged in the inference process. For these reasons, it is imperative to ensure that these types of judgments, as well as other rich features from TEI XML, can be respected (and, where necessary, preserved) in the conversion process."}]},{"id":"folio-6509e60a547a86f2098a-p3-b3-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Collations should preserve as much detail as possible, including information on how certain types of data can be normalized and collapsed for analysis. Since one might want to conduct the same analysis at different levels of granularity, the underlying collation data should be available for use in any case, and only the output of the conversion should reflect changes in the desired level of detail. Likewise, as noted in the previous section, uncertainty about witnesses' attestations should be encoded in the collation and preserved in the conversion of the collation."}]},{"id":"folio-6509e60a547a86f2098a-p3-b3-2","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"For text-critical purposes, differences in granularity typically concern which types of variant readings we consider important for analysis. At the lowest level, readings with uncertain or reconstructed portions are almost always considered identical with their reconstructions (provided these reconstructions can be made unambiguously) for the purpose of analysis. Defective forms that are obvious misspellings of a more substantive reading are often treated the same way. Even orthographic subvariants that reflect equally \"correct\" regional spelling practices may be considered too common and of too trivial a nature to be of value for analysis. Other readings that do not fall under these rubrics but are nevertheless considered manifestly secondary (due to late and/or isolated attestion, for instance), may also be considered uninformative \"noise\" that is better left filtered out."}]},{"id":"folio-6509e60a547a86f2098a-p3-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p3-b4-0-bold-p3-i60","type":"style/bold","start":0,"end":7}]},"inline":[{"kind":"text","text":"Use Case"}]},{"id":"folio-6509e60a547a86f2098a-p3-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Due to the availability of extensive collation data for the Greek New Testament, and because this project was originally developed for use with such data, we tested this library on a sample collation of the book of Ephesians in thirty-eight textual witnesses (including the first-hand texts of manuscripts, corrections made to manuscripts by later hands, translations to other languages, and quotations from church fathers). The manuscript transcriptions used for this collation were those produced by the University of Birmingham's Institute for Textual Scholarship and Electronic Editing (ITSEE) for the International Greek New Testament Project (IGNTP); they are freely accessible at https://itseeweb.cal.bham.ac.uk/epistulae/XML/igntp.xml. To achieve a balance between variety and conciseness, we restricted the collation to a set of forty-two variation units in Ephesians corresponding to variation units in the United Bible Societies Greek New Testament (Aland et al., 2014), which highlights variation units that affect substantive matters of translation."}]},{"id":"folio-6509e60a547a86f2098a-p3-b5-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In our example collation, witnesses are described in the element under the teiHeader."}]},{"id":"folio-6509e60a547a86f2098a-p3-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"listWit"}]},{"id":"folio-6509e60a547a86f2098a-p3-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Because most New Testament witnesses are identified by numerical Gregory-Aland identifiers,"}]},{"id":"folio-6509e60a547a86f2098a-p3-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p3-b9-0-italics-p3-i83","type":"style/italics","start":135,"end":163}]},"inline":[{"kind":"text","text":"McCollum, & Turnbull. (2022). teiphy: A Python Package for Converting TEI XML Collations to NEXUS and Other Formats. Journal of Open 3 Source Software, 7(80), 4879. https://doi.org/10.21105/joss.04879."}]},{"id":"folio-6509e60a547a86f2098a-p4-p4_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-6509e60a547a86f2098a-p4-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"these witnesses are identified with attributes; the recommended practice is to identify such"}]},{"id":"folio-6509e60a547a86f2098a-p4-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@n"}]},{"id":"folio-6509e60a547a86f2098a-p4-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"elements by attributes, but this software is designed to work with either identifying"}]},{"id":"folio-6509e60a547a86f2098a-p4-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@xmltiid"}]},{"id":"folio-6509e60a547a86f2098a-p4-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"attribute (preferring if both are provided), and we have left things as they are to"}]},{"id":"folio-6509e60a547a86f2098a-p4-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@xmltiid"}]},{"id":"folio-6509e60a547a86f2098a-p4-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"demonstrate this feature."}]},{"id":"folio-6509e60a547a86f2098a-p4-b7-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The elements in the example collation also contain elements that provide"}]},{"id":"folio-6509e60a547a86f2098a-p4-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"witness origDate"}]},{"id":"folio-6509e60a547a86f2098a-p4-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"dates or date ranges for the corresponding witnesses. Where a witness can be dated to a specific year, the attribute is sufficient to specify this; if it can be dated within a range"}]},{"id":"folio-6509e60a547a86f2098a-p4-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@when"}]},{"id":"folio-6509e60a547a86f2098a-p4-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"of years, the and attributes or the and attributes should"}]},{"id":"folio-6509e60a547a86f2098a-p4-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"be used; the software will work with any of these options. While such dating elements are not required, our software includes them in the conversion process whenever possible. This way, phylogenetic methods that employ clock models and other chronological constraints can benefit from this information when it is provided."}]},{"id":"folio-6509e60a547a86f2098a-p4-b13-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Each variation unit is encoded as an element with a unique attribute. Within a"}]},{"id":"folio-6509e60a547a86f2098a-p4-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"app @xmltiid"}]},{"id":"folio-6509e60a547a86f2098a-p4-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"variation unit, a element without a attribute presents the main text, and it is followed"}]},{"id":"folio-6509e60a547a86f2098a-p4-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"lem @wit"}]},{"id":"folio-6509e60a547a86f2098a-p4-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"by elements that describe variant readings (with the first duplicating the reading"}]},{"id":"folio-6509e60a547a86f2098a-p4-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"rdg rdg lem"}]},{"id":"folio-6509e60a547a86f2098a-p4-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"and detailing its witnesses) and their attestations among the witnesses. (Situations where the reading is not duplicated by the first element, but has its own attribute,"}]},{"id":"folio-6509e60a547a86f2098a-p4-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"lem rdg @wit"}]},{"id":"folio-6509e60a547a86f2098a-p4-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"are also supported.) For conciseness, we use the attribute for each reading as a local"}]},{"id":"folio-6509e60a547a86f2098a-p4-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@n"}]},{"id":"folio-6509e60a547a86f2098a-p4-b23-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"identifier; the recommended practice for readings that will be referenced elsewhere is to use the attribute, and this software will use this as the identifier if it is specified, but we"}]},{"id":"folio-6509e60a547a86f2098a-p4-b24-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@xmltiid"}]},{"id":"folio-6509e60a547a86f2098a-p4-b25-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"have only specified attributes for elements referenced in other variation units to"}]},{"id":"folio-6509e60a547a86f2098a-p4-b26-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@xmltiid rdg"}]},{"id":"folio-6509e60a547a86f2098a-p4-b27-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"demonstrate the flexibility of the software. For witnesses with missing or ambiguous readings at a given variation unit, we use the element. For ambiguous readings, we specify"}]},{"id":"folio-6509e60a547a86f2098a-p4-b28-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"witDetail"}]},{"id":"folio-6509e60a547a86f2098a-p4-b29-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"their possible disambiguations with the attribute and express our degrees of certainty"}]},{"id":"folio-6509e60a547a86f2098a-p4-b30-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@target"}]},{"id":"folio-6509e60a547a86f2098a-p4-b31-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"about these disambiguations using elements under the element."}]},{"id":"folio-6509e60a547a86f2098a-p4-b32-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"certainty witDetail"}]},{"id":"folio-6509e60a547a86f2098a-p4-b33-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The TEI XML file for this example is available in the directory of the GitHub repository."}]},{"id":"folio-6509e60a547a86f2098a-p4-b34-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"example"}]},{"id":"folio-6509e60a547a86f2098a-p4-b35-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Full instructions for converting this file using and analyzing it with several different"}]},{"id":"folio-6509e60a547a86f2098a-p4-b36-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p4-b37-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"phylogenetic packages are provided in the documentation, but here, we will walk through the command-line arguments involved in installing and using it to convert our example"}]},{"id":"folio-6509e60a547a86f2098a-p4-b38-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p4-b39-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"TEI XML collation (1) to a NEXUS file suitable for use with IQ-TREE, and (2) to input for the STEMMA program."}]},{"id":"folio-6509e60a547a86f2098a-p4-b39-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Because is published in the Python Package Index (PyPI), it can be installed via the"}]},{"id":"folio-6509e60a547a86f2098a-p4-b40-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p4-b41-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"command"}]},{"id":"folio-6509e60a547a86f2098a-p4-b42-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"pip install teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p4-b43-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Now we are ready to convert our TEI XML collation to a NEXUS file for IQ-TREE. Let us suppose that we would like to treat reconstructions of unclear or missing text, defective spellings, and orthographic variations in spelling as trivial variants for the purposes of our phylogenetic analysis. We can specify this to with the flag for each trivial type of"}]},{"id":"folio-6509e60a547a86f2098a-p4-b44-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy -t"}]},{"id":"folio-6509e60a547a86f2098a-p4-b45-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"reading as follows:"}]},{"id":"folio-6509e60a547a86f2098a-p4-b47-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In addition, suppose we would like to treat placeholders for overlapping variants from larger units and lacunae as missing data. We can specify this to with the flag for each"}]},{"id":"folio-6509e60a547a86f2098a-p4-b48-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy -m"}]},{"id":"folio-6509e60a547a86f2098a-p4-b49-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"type of reading to be read as missing data as follows:"}]},{"id":"folio-6509e60a547a86f2098a-p4-b51-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"If, in variation units where manuscripts are corrected or have alternate readings provided by"}]},{"id":"folio-6509e60a547a86f2098a-p4-b52-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"other hands, our collation adds and suffixes to manuscript sigla to mark the work of the * T original hand, we can tell to ignore these suffixes using the flag with each trivial teiphy -s suffix:"}]},{"id":"folio-6509e60a547a86f2098a-p4-b53-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-s\"*\" -s T"}]},{"id":"folio-6509e60a547a86f2098a-p4-b56-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@from"}]},{"id":"folio-6509e60a547a86f2098a-p4-b57-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@to"}]},{"id":"folio-6509e60a547a86f2098a-p4-b58-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@notBefore"}]},{"id":"folio-6509e60a547a86f2098a-p4-b59-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"@notAfter"}]},{"id":"folio-6509e60a547a86f2098a-p4-b60-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-t reconstructed"}]},{"id":"folio-6509e60a547a86f2098a-p4-b61-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-t defective -t orthographic"}]},{"id":"folio-6509e60a547a86f2098a-p4-b62-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-m overlap"}]},{"id":"folio-6509e60a547a86f2098a-p4-b63-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-m lac"}]},{"id":"folio-6509e60a547a86f2098a-p4-b55-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p4-b55-0-italics-p4-i165","type":"style/italics","start":135,"end":163}]},"inline":[{"kind":"text","text":"McCollum, & Turnbull. (2022). teiphy: A Python Package for Converting TEI XML Collations to NEXUS and Other Formats. Journal of Open 4 Source Software, 7(80), 4879. https://doi.org/10.21105/joss.04879."}]},{"id":"folio-6509e60a547a86f2098a-p5-p5_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-6509e60a547a86f2098a-p5-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"(Note that because the character is reserved on the command-line, we must place it between"}]},{"id":"folio-6509e60a547a86f2098a-p5-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"*"}]},{"id":"folio-6509e60a547a86f2098a-p5-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"quotation marks directly after the flag.)"}]},{"id":"folio-6509e60a547a86f2098a-p5-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-s"}]},{"id":"folio-6509e60a547a86f2098a-p5-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"When corrections are made to a manuscript, they are typically sporadic, and as a result, the text of corrector witnesses like 06C1 and 06C2 will tend to be too fragmentary to be useful for analysis. But if we wish to assume that each corrector tacitly adopted all of the readings from the previous hand that he or she did not change, then can \"fill out\" each corrector's"}]},{"id":"folio-6509e60a547a86f2098a-p5-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p5-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"text using the text of the first hand (in the case of the first corrector) or the filled-out text of the previous corrector (for all subsequent correctors). Thus, 06C1 would replicate the text of 06* (i.e., the first hand responsible for the text of 06) where it does not introduce its own readings, and 06C2 would then replicate the text of 06C1 where it does not introduce its own readings. If we want to apply this transformation during the conversion process, then we can specify this with the flag."}]},{"id":"folio-6509e60a547a86f2098a-p5-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"--fill-correctors"}]},{"id":"folio-6509e60a547a86f2098a-p5-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Finally, we must specify the required arguments to teiphy, which are the input TEI XML file (example/ubs_ephesians.xml) and the name of the output NEXUS file (ubs_ephesians-iqtree.nexus). Note that we do not have to specify the desired output format explicitly; will determine from the output filename that it should write a NEXUS file. Combining"}]},{"id":"folio-6509e60a547a86f2098a-p5-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p5-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"the previous options and arguments, the complete command is"}]},{"id":"folio-6509e60a547a86f2098a-p5-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"If we pass the resulting NEXUS file to IQ-TREE and specify appropriate settings for our textual data (in this case, the Lewis Mk substitution model with ascertainment bias correction), we will get an output tree like the one shown in Figure 1."}]},{"id":"folio-6509e60a547a86f2098a-p5-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p5-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-t reconstructed"}]},{"id":"folio-6509e60a547a86f2098a-p5-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-t defective -t orthographic"}]},{"id":"folio-6509e60a547a86f2098a-p5-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-m overlap"}]},{"id":"folio-6509e60a547a86f2098a-p5-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-m lac"}]},{"id":"folio-6509e60a547a86f2098a-p5-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-s\"*\""}]},{"id":"folio-6509e60a547a86f2098a-p5-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-s T --fill-correctors"}]},{"id":"folio-6509e60a547a86f2098a-p5-b23-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"example/ubs_ephesians.xml ubs_ephesians-iqtree.nexus"}]},{"id":"folio-6509e60a547a86f2098a-p5-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p5-b15-0-italics-p5-i54","type":"style/italics","start":135,"end":163}]},"inline":[{"kind":"text","text":"McCollum, & Turnbull. (2022). teiphy: A Python Package for Converting TEI XML Collations to NEXUS and Other Formats. Journal of Open 5 Source Software, 7(80), 4879. https://doi.org/10.21105/joss.04879."}]},{"id":"folio-6509e60a547a86f2098a-p6-p6_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-6509e60a547a86f2098a-p6-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"UBS"}]},{"id":"folio-6509e60a547a86f2098a-p6-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"33 28 1175"}]},{"id":"folio-6509e60a547a86f2098a-p6-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"P46"}]},{"id":"folio-6509e60a547a86f2098a-p6-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"85"}]},{"id":"folio-6509e60a547a86f2098a-p6-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"03 35 Jerome"}]},{"id":"folio-6509e60a547a86f2098a-p6-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"19 424C 83 1739 22 1881"}]},{"id":"folio-6509e60a547a86f2098a-p6-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"01 45 02 55 04"}]},{"id":"folio-6509e60a547a86f2098a-p6-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"67 copsa"}]},{"id":"folio-6509e60a547a86f2098a-p6-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"77 copbo 06C2"}]},{"id":"folio-6509e60a547a86f2098a-p6-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"vg"}]},{"id":"folio-6509e60a547a86f2098a-p6-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"57 82"}]},{"id":"folio-6509e60a547a86f2098a-p6-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Pelagius"}]},{"id":"folio-6509e60a547a86f2098a-p6-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Ambrosiaster"}]},{"id":"folio-6509e60a547a86f2098a-p6-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"99"}]},{"id":"folio-6509e60a547a86f2098a-p6-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"MariusVictorinus 96 06"}]},{"id":"folio-6509e60a547a86f2098a-p6-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"73"}]},{"id":"folio-6509e60a547a86f2098a-p6-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"90 06C1"}]},{"id":"folio-6509e60a547a86f2098a-p6-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"71"}]},{"id":"folio-6509e60a547a86f2098a-p6-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"010"}]},{"id":"folio-6509e60a547a86f2098a-p6-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"98"}]},{"id":"folio-6509e60a547a86f2098a-p6-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"012"}]},{"id":"folio-6509e60a547a86f2098a-p6-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"TheodoreOfMopsuestia"}]},{"id":"folio-6509e60a547a86f2098a-p6-b23-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"18"}]},{"id":"folio-6509e60a547a86f2098a-p6-b24-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"56"}]},{"id":"folio-6509e60a547a86f2098a-p6-b25-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"35"}]},{"id":"folio-6509e60a547a86f2098a-p6-b26-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"424 64 Chrysostom 48 syrh 60 syrp 38 1611"}]},{"id":"folio-6509e60a547a86f2098a-p6-b27-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"60 syrhmg 40 1505 42 2495 29 88"}]},{"id":"folio-6509e60a547a86f2098a-p6-b28-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"92"}]},{"id":"folio-6509e60a547a86f2098a-p6-b29-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"915"}]},{"id":"folio-6509e60a547a86f2098a-p6-b30-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"53"}]},{"id":"folio-6509e60a547a86f2098a-p6-b31-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"606"}]},{"id":"folio-6509e60a547a86f2098a-p6-b32-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"81"}]},{"id":"folio-6509e60a547a86f2098a-p6-b33-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1910"}]},{"id":"folio-6509e60a547a86f2098a-p6-b34-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p6-b34-0-bold-p6-i68","type":"style/bold","start":0,"end":96}]},"inline":[{"kind":"text","text":"Figure 1: A phylogenetic tree inferred by IQ-TREE for the UBS Ephesians example data with support values on the branches based on 1000 bootstrap replicates. Reconstructed, defective, and orthographic sub-variants were treated as identical to their parent readings, and changes made to the text by later correctors (represented as distinct witnesses with sigla like 06C1 and 06C2) were filled in with the readings of the first hand or the previous corrector where the corrector was not active."}]},{"id":"folio-6509e60a547a86f2098a-p6-b35-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"If we want to generate input files for the STEMMA program using the same options, only a few adjustments are required. First, since multiple files are written for STEMMA input (namely, a collation file with no file extension and a file containing information about witness"}]},{"id":"folio-6509e60a547a86f2098a-p6-b36-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":".chron"}]},{"id":"folio-6509e60a547a86f2098a-p6-b37-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"dates), we only specify the base of the filename for our output. Second, since the filename now has no extension, we must specify the desired output format to with the argument"}]},{"id":"folio-6509e60a547a86f2098a-p6-b38-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p6-b38-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"--format stemma"}]},{"id":"folio-6509e60a547a86f2098a-p6-b39-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Combining the options and arguments we used before with these changes, the complete command is"}]},{"id":"folio-6509e60a547a86f2098a-p6-b41-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"If we process the output files with the PREP utility that accompanies STEMMA and then pass the resulting files to STEMMA, we will get an output tree like the one shown in Figure 2."}]},{"id":"folio-6509e60a547a86f2098a-p6-b44-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p6-b45-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-t reconstructed"}]},{"id":"folio-6509e60a547a86f2098a-p6-b46-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-t defective -t orthographic"}]},{"id":"folio-6509e60a547a86f2098a-p6-b47-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-m overlap"}]},{"id":"folio-6509e60a547a86f2098a-p6-b48-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-m lac"}]},{"id":"folio-6509e60a547a86f2098a-p6-b49-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-s\"*\""}]},{"id":"folio-6509e60a547a86f2098a-p6-b50-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"-s T --fill-correctors --format stemma"}]},{"id":"folio-6509e60a547a86f2098a-p6-b51-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"example/ubs_ephesians.xml stemma_example"}]},{"id":"folio-6509e60a547a86f2098a-p6-b43-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p6-b43-0-italics-p6-i109","type":"style/italics","start":135,"end":163}]},"inline":[{"kind":"text","text":"McCollum, & Turnbull. (2022). teiphy: A Python Package for Converting TEI XML Collations to NEXUS and Other Formats. Journal of Open 6 Source Software, 7(80), 4879. https://doi.org/10.21105/joss.04879."}]},{"id":"folio-6509e60a547a86f2098a-p7-p7_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-6509e60a547a86f2098a-p7-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"UBS"}]},{"id":"folio-6509e60a547a86f2098a-p7-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"33"}]},{"id":"folio-6509e60a547a86f2098a-p7-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"P46"}]},{"id":"folio-6509e60a547a86f2098a-p7-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"03"}]},{"id":"folio-6509e60a547a86f2098a-p7-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"48%1175"}]},{"id":"folio-6509e60a547a86f2098a-p7-b5-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Jerome"}]},{"id":"folio-6509e60a547a86f2098a-p7-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"01"}]},{"id":"folio-6509e60a547a86f2098a-p7-b6-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"424C"}]},{"id":"folio-6509e60a547a86f2098a-p7-b6-2","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1739"}]},{"id":"folio-6509e60a547a86f2098a-p7-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"68%1881"}]},{"id":"folio-6509e60a547a86f2098a-p7-b7-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"02"}]},{"id":"folio-6509e60a547a86f2098a-p7-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"copsa"}]},{"id":"folio-6509e60a547a86f2098a-p7-b8-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"copbo"}]},{"id":"folio-6509e60a547a86f2098a-p7-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"vg"}]},{"id":"folio-6509e60a547a86f2098a-p7-b9-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Pelagius"}]},{"id":"folio-6509e60a547a86f2098a-p7-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Ambrosiaster"}]},{"id":"folio-6509e60a547a86f2098a-p7-b10-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"MariusVictorinus"}]},{"id":"folio-6509e60a547a86f2098a-p7-b10-2","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"010"}]},{"id":"folio-6509e60a547a86f2098a-p7-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"06"}]},{"id":"folio-6509e60a547a86f2098a-p7-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"06C1"}]},{"id":"folio-6509e60a547a86f2098a-p7-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"37%06C2"}]},{"id":"folio-6509e60a547a86f2098a-p7-b13-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"TheodoreOfMopsuestia"}]},{"id":"folio-6509e60a547a86f2098a-p7-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"63%06C2"}]},{"id":"folio-6509e60a547a86f2098a-p7-b14-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1611"}]},{"id":"folio-6509e60a547a86f2098a-p7-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"syrp"}]},{"id":"folio-6509e60a547a86f2098a-p7-b15-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"syrhmg"}]},{"id":"folio-6509e60a547a86f2098a-p7-b15-2","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"syrh"}]},{"id":"folio-6509e60a547a86f2098a-p7-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"18"}]},{"id":"folio-6509e60a547a86f2098a-p7-b16-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"424"}]},{"id":"folio-6509e60a547a86f2098a-p7-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Chrysostom"}]},{"id":"folio-6509e60a547a86f2098a-p7-b17-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1505"}]},{"id":"folio-6509e60a547a86f2098a-p7-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"52%1175"}]},{"id":"folio-6509e60a547a86f2098a-p7-b18-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"2495"}]},{"id":"folio-6509e60a547a86f2098a-p7-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"606"}]},{"id":"folio-6509e60a547a86f2098a-p7-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"1910"}]},{"id":"folio-6509e60a547a86f2098a-p7-b20-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"88"}]},{"id":"folio-6509e60a547a86f2098a-p7-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"915"}]},{"id":"folio-6509e60a547a86f2098a-p7-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"32%1881"}]},{"id":"folio-6509e60a547a86f2098a-p7-b23-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p7-b23-0-bold-p7-i38","type":"style/bold","start":0,"end":8}]},"inline":[{"kind":"text","text":"Figure 2: A phylogenetic tree inferred by STEMMA for the UBS Ephesians example data using 100 iterations of simulated annealing. Mixed witnesses are split (with proportions of their readings indicated by the percentages before their sigla) and located at different parts of the tree. Note that some witnesses (e.g., 012, 35) from the collation are excluded from this tree by STEMMA because they have the same reading sequence as another witness after their reconstructed, defective, and orthographic readings have been regularized."}]},{"id":"folio-6509e60a547a86f2098a-p7-b24-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"For the small sample of variation units covered in the UBS apparatus for Ephesians, the phylogenetic results depicted in Figures 1 and 2 are impressive. The trees produced by IQ-TREE and STEMMA agree on several traditionally established groupings of manuscripts, including Family 1739 (1739, 1881, and the corrections to 424); the \"Western\" tradition (as preserved in the Greek-Latin diglots 06, 010, and 012, the Latin Vulgate, and the early Latin church fathers Ambrosiaster, Marius Victorinus, and Pelagius); and the later Byzantine tradition (with representative manuscripts 18 and 35 and church fathers Chrysostom and Theodore of Mopsuestia). The Harklean Syriac translation (syrh) and the witnesses to its Greek Vorlage (1505, 1611, 2495) are correctly placed within the Byzantine tradition, although the two programs disagree on how to describe their relationships within that tradition. While IQ-TREE does not account for mixture complicating the tradition, STEMMA identifies three witnesses suspected to exhibit Byzantine contamination: 1175, 1881, and the second corrector of 06. Both programs also identify the Codex Alexandrinus (02) as closely related to both the Sahidic and Bohairic Coptic translations of Ephesians (copsa, copbo), although they disagree on where this clade is located in the larger tradition. Despite their discrepancies regarding"}]},{"id":"folio-6509e60a547a86f2098a-p7-b26-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p7-b26-0-italics-p7-i80","type":"style/italics","start":135,"end":163}]},"inline":[{"kind":"text","text":"McCollum, & Turnbull. (2022). teiphy: A Python Package for Converting TEI XML Collations to NEXUS and Other Formats. Journal of Open 7 Source Software, 7(80), 4879. https://doi.org/10.21105/joss.04879."}]},{"id":"folio-6509e60a547a86f2098a-p8-p8_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-6509e60a547a86f2098a-p8-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"certain subtrees, the extent of their agreements speaks to the level of genealogically significant detail preserved in the TEI XML apparatus and the NEXUS and STEMMA inputs generated from it."}]},{"id":"folio-6509e60a547a86f2098a-p8-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b2-0-bold-p8-i3","type":"style/bold","start":0,"end":11}]},"inline":[{"kind":"text","text":"Availability"}]},{"id":"folio-6509e60a547a86f2098a-p8-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"As noted above, the software is published in PyPI and can be installed from there using pip. The source code is available under the MIT license from the GitHub repository. The automated testing suite has 100% coverage, and functional tests where our example TEI XML file is converted and run through RAxML, IQ-TREE, MrBayes, and STEMMA are part of teiphy's continuous integration (CI) pipeline."}]},{"id":"folio-6509e60a547a86f2098a-p8-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b4-0-bold-p8-i9","type":"style/bold","start":0,"end":27}]},"inline":[{"kind":"text","text":"Acknowledgements and Funding"}]},{"id":"folio-6509e60a547a86f2098a-p8-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"The authors wish to thank Stephen C. Carlson for his feedback during the development of and the JOSS reviewers for their thorough and insightful comments on earlier drafts of"}]},{"id":"folio-6509e60a547a86f2098a-p8-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"teiphy"}]},{"id":"folio-6509e60a547a86f2098a-p8-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"this work. This work was supported by an Australian Government Research Training Program (RTP) Scholarship."}]},{"id":"folio-6509e60a547a86f2098a-p8-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b8-0-bold-p8-i16","type":"style/bold","start":0,"end":9}]},"inline":[{"kind":"text","text":"References"}]},{"id":"folio-6509e60a547a86f2098a-p8-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b9-0-italics-p8-i20","type":"style/italics","start":261,"end":271},{"id":"folio-6509e60a547a86f2098a-p8-b9-0-italics-p8-i21","type":"style/italics","start":273,"end":342}]},"inline":[{"kind":"text","text":"Abadi, M., Agarwal, A., Barham, P., Brevdo, E., Chen, Z., Citro, C., Corrado, G. S., Davis, A., Dean, J., Devin, M., Ghemawat, S., Goodfellow, I., Harp, A., Irving, G., Isard, M., Jia, Y., Jozefowicz, R., Kaiser, L., Kudlur, M., … Zheng, X. (2015). TensorFlow: Large-scale machine learning on heterogeneous systems. https://www.tensorflow.org/"}]},{"id":"folio-6509e60a547a86f2098a-p8-b9-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Aland, B., Aland, K., Karavidopoulos, J., Martini, C. M., & Metzger, B. M. (Eds.). (2014)."}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b10-0-italics-p8-i23","type":"style/italics","start":0,"end":61}]},"inline":[{"kind":"text","text":"The Greek New Testament (5th ed.). Deutsche Bibelgesellschaft."}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b10-1-italics-p8-i27","type":"style/italics","start":102,"end":151}]},"inline":[{"kind":"text","text":"Baldwin, C. S. (2010). Factor analysis: A new method for classifying New Testament Greek manuscripts. Andrews University Seminary Studies, 48(1), 29-53."}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-2","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b10-2-italics-p8-i32","type":"style/italics","start":85,"end":101},{"id":"folio-6509e60a547a86f2098a-p8-b10-2-italics-p8-i33","type":"style/italics","start":103,"end":149}]},"inline":[{"kind":"text","text":"Barbrook, A. C., Howe, C. J., Blake, N., & Robinson, P. (1998). The phylogeny of The Canterbury Tales. Nature, 394, 839. https://doi.org/10.1038/29667"}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-3","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b10-3-italics-p8-i51","type":"style/italics","start":380,"end":419}]},"inline":[{"kind":"text","text":"Bouckaert, R., Vaughan, T. G., Barido-Sottani, J., Duchêne, S., Fourment, M., Gavryushkina, A., Heled, J., Jones, G., Kühnert, D., De Maio, N., Matschiner, M., Mendes, F. K., Müller, N. F., Ogilvie, H. A., du Plessis, L., Popinga, A., Rambaut, A., Rasmussen, D., Siveroni, I., … Drummond, A. J. (2019). BEAST 2.5: An advanced software platform for Bayesian evolutionary analysis. PLOS Computational Biology, 15(4), 1-28. https: //doi.org/10.1371/journal.pcbi.1006650"}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-4","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Carlson, S. C. (2015). The text of Galatians and its history. Mohr Siebeck. https://doi.org/ 10.1628/978-3-16-153324-2"}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-5","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b10-5-italics-p8-i59","type":"style/italics","start":25,"end":84},{"id":"folio-6509e60a547a86f2098a-p8-b10-5-italics-p8-i60","type":"style/italics","start":86,"end":99}]},"inline":[{"kind":"text","text":"Edmondson, A. C. (2019). An analysis of the coherence-based genealogical method using phylogenetics. University of Birmingham. http://etheses.bham.ac.uk/id/eprint/9150"}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-6","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b10-6-italics-p8-i65","type":"style/italics","start":22,"end":35},{"id":"folio-6509e60a547a86f2098a-p8-b10-6-italics-p8-i66","type":"style/italics","start":37,"end":84}]},"inline":[{"kind":"text","text":"Farris, J. S. (1988). Hennig86, ver. 1.5. Program and documentation. James S. Farris."}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-7","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b10-7-italics-p8-i68","type":"style/italics","start":24,"end":45}]},"inline":[{"kind":"text","text":"Felsenstein, J. (2004). Inferring phylogenies. Sinauer Associates."}]},{"id":"folio-6509e60a547a86f2098a-p8-b10-8","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b10-8-italics-p8-i72","type":"style/italics","start":54,"end":88}]},"inline":[{"kind":"text","text":"Finney, T. J. (2018). How to discover textual groups. Digital Studies/Le Champ Numérique,"}]},{"id":"folio-6509e60a547a86f2098a-p8-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b16-0-italics-p8-i73","type":"style/italics","start":0,"end":1}]},"inline":[{"kind":"text","text":"8. https://doi.org/10.16995/dscn.291"}]},{"id":"folio-6509e60a547a86f2098a-p8-b16-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-6509e60a547a86f2098a-p8-b16-1-italics-p8-i77","type":"style/italics","start":98,"end":142}]},"inline":[{"kind":"text","text":"Fischer, F. (2020). Representing the critical text. In P. Roelli (Ed.), Handbook of stemmatology: History, methodology, digital approaches (pp. 4