5f6-p1-b10-0-bold-p1-i40","type":"style/bold","start":0,"end":6}]},"inline":[{"kind":"text","text":"License"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Authors of papers retain copyright and release the work under a Creative Commons Attribution 4.0 International License (CC BY 4.0)."}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Potnia: A Python library for the conversion of transliterated ancient texts to Unicode"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p1-b13-0-bold-p1-i3","type":"style/bold","start":0,"end":9},{"id":"folio-0e1228444002c1a2d5f6-p1-b13-0-bold-p1-i6","type":"style/bold","start":46,"end":64}]},"inline":[{"kind":"text","text":"Emily Tour 1*¶, Kabir Manandhar Shrestha 2* , and Robert Turnbull 2*"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p1-b14-0-bold-p1-i8","type":"style/bold","start":0,"end":97}]},"inline":[{"kind":"text","text":"1 University of Melbourne, Australia 2 Melbourne Data Analytics Platform, University of Melbourne, Australia ¶ Corresponding author * These authors contributed equally."}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p1-b15-0-bold-p1-i15","type":"style/bold","start":0,"end":6}]},"inline":[{"kind":"text","text":"Summary"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Potnia is an open-source Python library designed to convert Romanized transliterations of ancient texts into their respective Unicode representations. Significant progress has been made in the digitization of ancient language corpora. However, many of these datasets are solely presented in transliterated form, even though the necessary Unicode blocks exist to render them using their native script. This restriction to using transliterated datasets for certain ancient scripts has the potential to limit the precision of linguistic analysis via machine learning."}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b16-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Potnia bridges this gap by providing a flexible framework for converting transliterations into Unicode. By enabling tokenization and processing in the original script, Potnia can optimize tasks such as textual restoration and machine learning-based analysis. The library currently supports:"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Linear A"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Linear B"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Hittite cuneiform"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b20-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• Arabic"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b20-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"While Linear B has the most comprehensive test cases and is the most robust, the tool can also be used effectively for the other scripts. The architectural flexibility of Potnia makes it easy to accommodate additional scripts, offering significant value to both computational linguistics and digital humanities by enabling researchers to work with ancient texts in their native scripts."}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p1-b21-0-bold-p1-i54","type":"style/bold","start":0,"end":16}]},"inline":[{"kind":"text","text":"Statement of Need"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"While machine learning has increasingly been applied to the study of ancient texts (Sommer-schield et al., 2023), much of this progress has involved working with transliterated texts, rather than native script formats (Fetaya et al., 2020; Luo et al., 2019; Papavassileiou et al., 2023; Perono Cacciafoco & Loh, 2021). Although Unicode standards exist for many ancient scripts, transliterated texts remain prevalent due to historical digitization practices."}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b24-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Transliteration is the process of converting text from its original script into a different script, using systematic processes. It allows those who can understand the secondary script to comprehend the orthography and the approximate pronunciation of the original text. Prior to the gradual introduction of relevant Unicode blocks since the 1990s (Hossain, 2024), it was also usually necessary for representing non-Latin scripts on Western computational systems, which were largely confined to letters of the Latin alphabet and a small number of special characters."}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b24-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Transliteration has an important place in aiding new learners of an ancient script to understand the pronunciation and orthography of the underlying language it represents (particularly for"}]},{"id":"folio-0e1228444002c1a2d5f6-p1-b26-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p1-b26-0-italics-p1-i87","type":"style/italics","start":108,"end":139},{"id":"folio-0e1228444002c1a2d5f6-p1-b26-0-italics-p1-i89","type":"style/italics","start":143,"end":156}]},"inline":[{"kind":"text","text":"Tour et al. (2025). Potnia: A Python library for the conversion of transliterated ancient texts to Unicode. Journal of Open Source Software, 1 10(108), 7725. https://doi.org/10.21105/joss.07725."}]},{"id":"folio-0e1228444002c1a2d5f6-p2-p2_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-0e1228444002c1a2d5f6-p2-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"non-alphabetic scripts, where beginners need to grasp a vast repertoire of unfamiliar signs). However, it is well recognized that this process can only provide an approximate, and often unsatisfactory or disputed, representation of the original text (Martinet, 1953; Odisho, 1992; Weinberg, 1974). In particular, a lack of standardized approaches to transliteration can introduce considerable ambiguity and noise into the dataset in a variety of ways, including:"}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• the use of various notation systems, with different transliterations representing the exact same sign in distinct ways (e.g. where in Akkadian cuneiform can be represented as either 'mè' or 'me3');"}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• changing opinions on particular sign values over time, introducing possible differences between older and newer transliterations (e.g. in the Linear B script changing from the previously suggested value of 'pa2' to 'qa')(Chadwick, 1973, pp. 389, 391);"}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"• and the way in which transliteration obscures polyvalency in scripts, where a single sign can represent multiple different values (e.g. in Hittite cuneiform can represent three different syllables, transliterated as 'ḫar', 'ḫur' and 'mur', as well as acting as a logogram for three different words, 'ring', 'thick' and 'lung')."}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b4-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"For language modelling tasks, we therefore suggest that representations of texts in their native form are preferable to achieve the most accurate results. A number of digitized corpora for well-resourced and widely studied ancient languages are now available in Unicode representations of their native script, including a corpus of ancient Greek (Cerrato et al., 2021), classical Hebrew (Sefaria, 2024), Syriac (Walters, 2020) and Arabic (Nigst et al., 2023). However, many other online text corpora remain restricted to Romanized translisterations (despite the availability of relevant Unicode standards), presumably due to considerations around ease, system limitations and accessibility, e.g. Linear B (Aurora, 2015), Ugaritic (Prosser & Pardee, 2019) and Sumero-Akkadian cuneiform (CDLI contributors, 2024). For this latter group of scripts, current tools capable of converting transliterated ancient texts to the corresponding Unicode appear limited to a handful of individual scripts, such as the various implementations of 'Cuneify' (Tinney, 2019) that handle Sumero-Akkadian cuneiform, the PHP script 'UnicodeConverter', for Egyptian hieroglyphs (Ilin-Tomich, 2019), or 'Anatolian Hieroglyphics (Luwian) generation' tool for Luwian hieroglyphs (Senior, 2023), the latter only available to use through a basic online graphical user interface. While the PyArabic package (Zerrouki, 2023) is able to convert Arabic text to and from the popular Timothy Buckwalter transliteration system, Potnia provides a complementary functionality for the DIN 31635 transliteration system (Deutsches Institut für Normung, 2011) which is widely used in academic literature."}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b4-2","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"In addition, such transliterations of ancient texts are often heavily annotated, with special characters used to denote a range of features including uncertain readings, missing or damaged elements, erasures, non-textual marks, and annotations by modern transliterators pertaining to structural or physical elements of the document. If not removed or handled appropriately, these have the potential to introduce further noise into language models."}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b4-3","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"These are the primary gaps we have aimed to address through the development of Potnia. The library's focus on ancient scripts and its extensible architecture make it a valuable asset for researchers working with digitized ancient corpora. It is also equipped to provide specific handling of these elements, with tailored tokenization and regularization rules pertaining to both script-specific and corpus-specific conventions. Potnia therefore enables a key pre-processing step in the language modelling pipeline, with the resulting Unicode outputs of ancient texts enabling more accurate and nuanced computational analysis of these texts in downstream modelling tasks."}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p2-b5-0-bold-p2-i79","type":"style/bold","start":0,"end":13}]},"inline":[{"kind":"text","text":"Implementation"}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Potnia is implemented in Python with an extensible architecture centered around the"}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Script"}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"class, which converts transliterated texts into Unicode representations. It is designed to handle the complexities of ancient scripts through a flexible and customizable framework."}]},{"id":"folio-0e1228444002c1a2d5f6-p2-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p2-b10-0-italics-p2-i91","type":"style/italics","start":108,"end":139},{"id":"folio-0e1228444002c1a2d5f6-p2-b10-0-italics-p2-i93","type":"style/italics","start":143,"end":156}]},"inline":[{"kind":"text","text":"Tour et al. (2025). Potnia: A Python library for the conversion of transliterated ancient texts to Unicode. Journal of Open Source Software, 2 10(108), 7725. https://doi.org/10.21105/joss.07725."}]},{"id":"folio-0e1228444002c1a2d5f6-p3-p3_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-0e1228444002c1a2d5f6-p3-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b1-0-bold-p3-i0","type":"style/bold","start":0,"end":11}]},"inline":[{"kind":"text","text":"Key Features"}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b2-0-bold-p3-i2","type":"style/bold","start":3,"end":82}]},"inline":[{"kind":"text","text":"1. YAML-Based Mapping and Rule Specification: Each script in Potnia (e.g. Linear A, Linear B, Arabic, Hittite cuneiform) is configured via a single YAML file that contains syllabograms, logograms, and rules for transliteration and regularization. This unified structure simplifies updates, scales easily for new scripts, and eliminates the need for hardcoded source files (fig. 1)."}]},{"id":"folio-0e1228444002c1a2d5f6-p3-p3_2","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"257px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:1b1d815e7a6924b96051a71e744c3af76544e832babcb9493700f3d92d235ac7"}}},{"id":"folio-0e1228444002c1a2d5f6-p3-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b4-0-bold-p3-i8","type":"style/bold","start":0,"end":8}]},"inline":[{"kind":"text","text":"Figure 1: Example of YAML mapping specification."}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b5-0-bold-p3-i11","type":"style/bold","start":3,"end":19}]},"inline":[{"kind":"text","text":"2. Tokenization: The method applies complex symbol replace-"}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"tokenize_transliteration"}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"ments and regular expressions to transliterated text based on the rules specified in the YAML file. This tokenization process ensures that the text is split accurately into its meaningful components, handling special symbols and spacing using placeholders, and preparing the text for Unicode conversion."}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b8-0-bold-p3-i23","type":"style/bold","start":3,"end":29}]},"inline":[{"kind":"text","text":"3. Transliteration to Unicode: Potnia uses the method to convert the transliter-"}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"__call__"}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"ated text to its Unicode representation (fig. 2)."}]},{"id":"folio-0e1228444002c1a2d5f6-p3-p3_3","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"412px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:48713d980af5faa022b23cc9ee6fe0286235a5cc2d3314f9a90dade5a7d519ff"}}},{"id":"folio-0e1228444002c1a2d5f6-p3-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b12-0-bold-p3-i28","type":"style/bold","start":0,"end":8}]},"inline":[{"kind":"text","text":"Figure 2: Example of using Potnia."}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b13-0-bold-p3-i31","type":"style/bold","start":3,"end":92}]},"inline":[{"kind":"text","text":"4. Regularization of Text: The regularize method applies a series of regular expression rules to clean and normalize the Unicode output. It removes unnecessary tags, ignores patterns specified in the YAML file (e.g. annotations or uncertain characters), and ensures that only the essential characters are retained. This step ensures the output is refined and ready for downstream tasks."}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b14-0-bold-p3-i38","type":"style/bold","start":3,"end":87}]},"inline":[{"kind":"text","text":"5. Comprehensive Testing: Pytest fixtures allow us to define test cases as lines in YAML files which allowed us to consisely add over 360 test examples, covering a broad range of edge cases. The code coverage of the tests is 100%."}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b15-0-bold-p3-i43","type":"style/bold","start":3,"end":92}]},"inline":[{"kind":"text","text":"6. Versatile Interface Options Users can interact with Potnia as a Python library, or through the command line interface (CLI), or through the graphical user interface (GUI) (fig. 3)"}]},{"id":"folio-0e1228444002c1a2d5f6-p3-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p3-b17-0-italics-p3-i49","type":"style/italics","start":108,"end":139},{"id":"folio-0e1228444002c1a2d5f6-p3-b17-0-italics-p3-i51","type":"style/italics","start":143,"end":156}]},"inline":[{"kind":"text","text":"Tour et al. (2025). Potnia: A Python library for the conversion of transliterated ancient texts to Unicode. Journal of Open Source Software, 3 10(108), 7725. https://doi.org/10.21105/joss.07725."}]},{"id":"folio-0e1228444002c1a2d5f6-p4-p4_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-0e1228444002c1a2d5f6-p4-p4_2","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"412px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:742675baccb088654adce6e87ed7abe784a6be69a7dfbb5fe4fb9f2b9b2a4f29"}}},{"id":"folio-0e1228444002c1a2d5f6-p4-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p4-b2-0-bold-p4-i0","type":"style/bold","start":0,"end":8}]},"inline":[{"kind":"text","text":"Figure 3: Example of using the Potnia GUI."}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p4-b3-0-bold-p4-i2","type":"style/bold","start":0,"end":19}]},"inline":[{"kind":"text","text":"Research Application"}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Potnia's design and functionality address the following challenges in the analysis of ancient texts:"}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p4-b5-0-bold-p4-i6","type":"style/bold","start":3,"end":16}]},"inline":[{"kind":"text","text":"1. Extensibility: Potnia is designed to be highly extensible, allowing researchers to integrate new scripts by defining script-specific rules for tokenization and conversion. This flexibility makes the library suitable for a wide range of ancient scripts that are not yet represented in Unicode, providing a valuable tool for researchers across various fields of ancient studies."}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p4-b6-0-bold-p4-i17","type":"style/bold","start":3,"end":38}]},"inline":[{"kind":"text","text":"2. Integration with Research Workflows: Researchers can easily incorporate Potnia into their existing workflows. For example, in a typical research scenario, Potnia could be used to preprocess a corpus of Linear B texts before feeding them into a machine learning model for further analysis."}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b6-1","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"As part of a broader initiative to develop language models for ancient language research, Potnia serves as a foundational component by converting Romanized transliterations of Linear B texts into Unicode datasets for computational analysis. These datasets enable the development of language-specific models supporting tasks such as text generation, restoration and vector embedding analysis. The library's modular design facilitates its application to additional ancient scripts, contributing to broader research initiatives in computational philology."}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p4-b7-0-bold-p4-i33","type":"style/bold","start":0,"end":11}]},"inline":[{"kind":"text","text":"Availability"}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Potnia is open-source software released under the Apache 2.0 license. It is available through PyPI https://pypi.org/project/potnia/ and GitHub https://github.com/AncientNLP/potnia. We welcome contributions from the community and adhere to the Contributor Covenant Code of Conduct. Documentation is available at https://ancientnlp.github.io/potnia/."}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p4-b9-0-bold-p4-i41","type":"style/bold","start":0,"end":15}]},"inline":[{"kind":"text","text":"Acknowledgements"}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"We acknowledge support from Wytamma Wirth, Brent Davis, Kim Doyle, Man-Hua (Kate) Chu, Anhui (Ellie) Situ, Ekaterina Vylomova, Chris Guest and Stavroula (Stephie) Nikoloudis. This research was supported by The University of Melbourne's Research Computing Services. Robert Turnbull completed part of this work through the BICROSS project, which has received funding from the European Research Council (ERC) under the European Union's Horizon Europe research and innovation programme (grant agreement no. 101043730 - BICROSS -ERC-2021-COG)."}]},{"id":"folio-0e1228444002c1a2d5f6-p4-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p4-b12-0-italics-p4-i53","type":"style/italics","start":108,"end":139},{"id":"folio-0e1228444002c1a2d5f6-p4-b12-0-italics-p4-i55","type":"style/italics","start":143,"end":156}]},"inline":[{"kind":"text","text":"Tour et al. (2025). Potnia: A Python library for the conversion of transliterated ancient texts to Unicode. Journal of Open Source Software, 4 10(108), 7725. https://doi.org/10.21105/joss.07725."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-p5_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-0e1228444002c1a2d5f6-p5-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b1-0-bold-p5-i0","type":"style/bold","start":0,"end":9}]},"inline":[{"kind":"text","text":"References"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b2-0-italics-p5-i4","type":"style/italics","start":104,"end":157}]},"inline":[{"kind":"text","text":"Aurora, F. (2015). DĀMOS (Database of Mycenaean at Oslo). Annotating a fragmentarily attested language. Procedia - Social and Behavioral Sciences, 198, 21-31. https://doi. org/10.1016/j.sbspro.2015.07.415"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b2-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b2-1-italics-p5-i9","type":"style/italics","start":27,"end":63}]},"inline":[{"kind":"text","text":"CDLI contributors. (2024). Cuneiform Digital Library Initiative. https://cdli.mpiwg-berlin."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"mpg.de/."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b4-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b4-1-italics-p5-i15","type":"style/italics","start":249,"end":263},{"id":"folio-0e1228444002c1a2d5f6-p5-b4-1-italics-p5-i16","type":"style/italics","start":265,"end":294}]},"inline":[{"kind":"text","text":"Cerrato, L., Almas, B., TDBuck, ahanhardt, srdee, Babeu, A., Clérice, T., Fleischman, S., gregorycrane, Munson, M., Berra, A., Mittmann, A., Palladino, C., KATEBHN, Sowell, E., Kalvesmaki, J., Scott, S., Hellingman, J., Andrei, & Drymon, C. (2021). Canonical greek literature (Version 0.0.2867). Zenodo. https://doi.org/10.5281/zenodo.5090923"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b4-2","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b4-2-italics-p5-i19","type":"style/italics","start":21,"end":87}]},"inline":[{"kind":"text","text":"Chadwick, J. (1973). Documents in Mycenaean Greek (2nd ed.). Cambridge University Press."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b4-3","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Deutsches Institut für Normung. (2011). DIN 31635: Transliteration of the Arabic alphabet."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Standard published by Deutsches Institut für Normung."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b6-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b6-1-italics-p5-i26","type":"style/italics","start":135,"end":182},{"id":"folio-0e1228444002c1a2d5f6-p5-b6-1-italics-p5-i27","type":"style/italics","start":184,"end":244}]},"inline":[{"kind":"text","text":"Fetaya, E., Lifshitz, Y., Aaron, E., & Gordin, S. (2020). Restoration of fragmentary Babylonian texts using recurrent neural networks. Proceedings of the National Academy of Sciences, 117(37), 22743-22751. https://doi.org/10.1073/pnas.2003794117"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b6-2","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b6-2-italics-p5-i32","type":"style/italics","start":120,"end":166}]},"inline":[{"kind":"text","text":"Hossain, A. (2024). Text Standards for the \"Rest of World\": The Making of the Unicode Standard and the OpenType Format. IEEE Annals of the History of Computing, 46(1), 20-33. https://doi.org/10.1109/MAHC.2024.3351948"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b6-3","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b6-3-italics-p5-i35","type":"style/italics","start":24,"end":87}]},"inline":[{"kind":"text","text":"Ilin-Tomich, A. (2019). UnicodeConverter. https://github.com/ailintom/UnicodeConverter/."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b6-4","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b6-4-italics-p5-i40","type":"style/italics","start":169,"end":171},{"id":"folio-0e1228444002c1a2d5f6-p5-b6-4-italics-p5-i41","type":"style/italics","start":173,"end":246}]},"inline":[{"kind":"text","text":"Luo, J., Cao, Y., & Barzilay, R. (2019). Neural decipherment via minimum-cost flow: From Ugaritic to Linear B. Proceedings of the 57th Annual Meeting of the Association for Computational Linguistics, 3146-3155. https://doi.org/10.18653/v1/P19-1303"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b6-5","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Martinet, A. (1953). A Project of Transliteration of Classical Greek. WORD, 9(2), 152-161."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"https://doi.org/10.1080/00437956.1953.11659466"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b10-1-italics-p5-i46","type":"style/italics","start":76,"end":85},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-1-italics-p5-i47","type":"style/italics","start":87,"end":129}]},"inline":[{"kind":"text","text":"Nigst, L., Romanov, M., Savant, S. B., Seydi, M., & Verkinderen, P. (2023). OpenITI: a Machine-Readable Corpus of Islamicate Texts (Version 2023.1.8) [Data set]. Zenodo. https://doi.org/10.5281/zenodo.10021513"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-2","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b10-2-italics-p5-i52","type":"style/italics","start":95,"end":141}]},"inline":[{"kind":"text","text":"Odisho, E. Y. (1992). Transliterating English in Arabic. Zeitschrift Für Arabische Linguistik, 24, 21-34. http://www.jstor.org/stable/43525603"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-3","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b10-3-italics-p5-i57","type":"style/italics","start":173,"end":179},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-3-italics-p5-i58","type":"style/italics","start":181,"end":260}]},"inline":[{"kind":"text","text":"Papavassileiou, K., Kosmopoulos, D. I., & Owens, G. (2023). A generative model for the Mycenaean Linear B script and its application in infilling text from ancient tablets. Journal on Computing and Cultural Heritage, 16(3), 1-25. https://doi.org/10.1145/3593431"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-4","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b10-4-italics-p5-i63","type":"style/italics","start":247,"end":258}]},"inline":[{"kind":"text","text":"Perono Cacciafoco, F., & Loh, C. J. S. (2021). A New Approach to the Decipherment of Linear A, Stage 2 - Cryptanalysis and Language Deciphering: A \"Brute Force Attack\" on an Undeciphered Writing System. Grapholinguistics in the 21st Century 2020. Proceedings, 927-943. https://doi.org/10.36824/2020-graf-cacc"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-5","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b10-5-italics-p5-i69","type":"style/italics","start":40,"end":71}]},"inline":[{"kind":"text","text":"Prosser, M. C., & Pardee, D. G. (2019). The Ras Shamra Tablet Inventory. https:// onlinepublications.uchicago.edu/RSTI/."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-6","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b10-6-italics-p5-i74","type":"style/italics","start":17,"end":24},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-6-italics-p5-i75","type":"style/italics","start":26,"end":65}]},"inline":[{"kind":"text","text":"Sefaria. (2024). Sefaria: A living library of jewish texts online. https://www.sefaria.org."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-7","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b10-7-italics-p5-i78","type":"style/italics","start":19,"end":62}]},"inline":[{"kind":"text","text":"Senior, A. (2023). Anatolian hieroglyphics (luwian) generation. https://andrewsenior.com/ luwian/."}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b10-8","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"Sommerschield, T., Assael, Y., Pavlopoulos, J., Stefanak, V., Senior, A., Dyer, C., Bodel,"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b17-0-italics-p5-i91","type":"style/italics","start":110,"end":148}]},"inline":[{"kind":"text","text":"J., Prag, J., Androutsopoulos, I., & Freitas, N. D. (2023). Machine learning for ancient languages: A survey. Computational Linguistics, 49(3), 1-45. https://doi.org/10.1162/"}]},{"id":"folio-0e1228444002c1a2d5f6-p5-b19-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p5-b19-0-italics-p5-i97","type":"style/italics","start":108,"end":139},{"id":"folio-0e1228444002c1a2d5f6-p5-b19-0-italics-p5-i99","type":"style/italics","start":143,"end":156}]},"inline":[{"kind":"text","text":"Tour et al. (2025). Potnia: A Python library for the conversion of transliterated ancient texts to Unicode. Journal of Open Source Software, 5 10(108), 7725. https://doi.org/10.21105/joss.07725."}]},{"id":"folio-0e1228444002c1a2d5f6-p6-p6_1","type":"image-block","properties":{"blockProperties":[{"type":"block/size","metadata":{"width":"208px"}}],"metadata":{"alt":"Imported figure"},"asset":{"kind":"managed","cavernId":"folio-reading","assetId":"sha256:4d1d452763be30a272127b6eae43ca828f2cd4b19fed6f19caaf43947af47972"}}},{"id":"folio-0e1228444002c1a2d5f6-p6-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[]},"inline":[{"kind":"text","text":"coli_a_00481"}]},{"id":"folio-0e1228444002c1a2d5f6-p6-b1-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0e1228444002c1a2d5f6-p6-b1-1-italics-p6-i2","type":"style/italics","start":19,"end":26}]},"inline":[{"kind":"text","text":"Tinney, S. (2019). Cuneify.