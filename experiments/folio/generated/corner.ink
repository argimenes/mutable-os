-p1-i4","type":"style/bold","start":0,"end":39}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":166.86,"y":193.6,"width":161,"height":9.06},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"sans-serif","align":"left"}}},"inline":[{"kind":"text","text":"1 Sagan Fellow, University of Washington"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b11-0-p1-i7","type":"spatial/source-run","value":"p1-i7","start":0,"end":6},{"id":"folio-0569cd3d34fd1dcab25b-p1-b11-0-bold-p1-i7","type":"style/bold","start":0,"end":6}],"metadata":{"folio":{"kind":"heading","frame":{"x":166.86,"y":226.34,"width":61.3,"height":14.49},"fontSize":14.35,"lineCount":1,"leading":16.21,"family":"sans-serif","align":"left"}}},"inline":[{"kind":"text","text":"Summary"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i10","type":"spatial/source-run","value":"p1-i10","start":0,"end":85},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i12","type":"spatial/source-run","value":"p1-i12","start":87,"end":113},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i13","type":"spatial/source-run","value":"p1-i13","start":115,"end":138},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i14","type":"spatial/source-run","value":"p1-i14","start":140,"end":172},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i20","type":"spatial/source-run","value":"p1-i20","start":173,"end":227},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i21","type":"spatial/source-run","value":"p1-i21","start":229,"end":262},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-italics-p1-i21","type":"style/italics","start":229,"end":262},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i23","type":"spatial/source-run","value":"p1-i23","start":264,"end":350},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i29","type":"spatial/source-run","value":"p1-i29","start":352,"end":443},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-0-p1-i34","type":"spatial/source-run","value":"p1-i34","start":445,"end":452}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":166.47,"y":258.57,"width":387.96,"height":69.73},"fontSize":9.96,"lineCount":6,"leading":11.95,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"This Python module uses matplotlib (Hunter 2007) to visualize multidimensional samples using a scatterplot matrix. In these visualizations, each one- and two-dimensional projection of the sample is plotted to reveal covariances. corner was originally conceived to display the results of Markov Chain Monte Carlo simulations and the defaults are chosen with this application in mind but it can be used for displaying many qualitatively different samples."}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i36","type":"spatial/source-run","value":"p1-i36","start":0,"end":83},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i37","type":"spatial/source-run","value":"p1-i37","start":84,"end":96},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i38","type":"spatial/source-run","value":"p1-i38","start":98,"end":103},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-italics-p1-i38","type":"style/italics","start":98,"end":103},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i39","type":"spatial/source-run","value":"p1-i39","start":105,"end":107},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i40","type":"spatial/source-run","value":"p1-i40","start":109,"end":132},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i41","type":"spatial/source-run","value":"p1-i41","start":134,"end":149},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i42","type":"spatial/source-run","value":"p1-i42","start":151,"end":160},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i43","type":"spatial/source-run","value":"p1-i43","start":162,"end":167},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i44","type":"spatial/source-run","value":"p1-i44","start":169,"end":248},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i45","type":"spatial/source-run","value":"p1-i45","start":250,"end":252},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i46","type":"spatial/source-run","value":"p1-i46","start":254,"end":338},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-1-p1-i47","type":"spatial/source-run","value":"p1-i47","start":340,"end":344}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":166.62,"y":335.28,"width":387.81,"height":58.33},"fontSize":9.96,"lineCount":5,"leading":11.96,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Development of corner happens on GitHub and any issues can be raised there (Foreman-Mackey 2016). corner has been used extensively in the astronomical literature and it has occasionally been cited as corner.py or using its previous name triangle.py. The source code for corner has been archived to Zenodo and it has the DOI (Zenodo Archive 2016)"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-2","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b12-2-p1-i48","type":"spatial/source-run","value":"p1-i48","start":0,"end":75}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":166.51,"y":400.04,"width":335.85,"height":10.07},"fontSize":9.96,"lineCount":1,"leading":11.26,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The following is a simple demonstration of a visualization made with corner:"}]},{"id":"folio-0569cd3d34fd1dcab25b-p1-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-0569cd3d34fd1dcab25b-p1-b13-0-p1-i49","type":"spatial/source-run","value":"p1-i49","start":0,"end":9},{"id":"folio-0569cd3d34fd1dcab25b-p1-b13-0-bold-p1-i49","type":"style/bold","start":0,"end":9}],"metadata":{"folio":{"kind":"heading","frame":{"x":166.86,"y":434.43,"width":70.68,"height":14.35},"fontSize":14.35,"lineCount":1,"l