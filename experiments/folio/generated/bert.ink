4,"end":411}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":71.25,"y":66.32,"width":219.03,"height":118.2},"fontSize":10.91,"lineCount":9,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"word based only on its context. Unlike left-toright language model pre-training, the MLM objective enables the representation to fuse the left and the right context, which allows us to pretrain a deep bidirectional Transformer. In addition to the masked language model, we also use a \"next sentence prediction\" task that jointly pretrains text-pair representations. The contributions of our paper are as follows:"}]},{"id":"folio-987545ffb087f1ece898-p2-b1-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i53","type":"spatial/source-run","value":"p2-i53","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i54","type":"spatial/source-run","value":"p2-i54","start":2,"end":47},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i58","type":"spatial/source-run","value":"p2-i58","start":49,"end":90},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i59","type":"spatial/source-run","value":"p2-i59","start":92,"end":93},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i61","type":"spatial/source-run","value":"p2-i61","start":94,"end":140},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i63","type":"spatial/source-run","value":"p2-i63","start":141,"end":185},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i65","type":"spatial/source-run","value":"p2-i65","start":187,"end":190},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i66","type":"spatial/source-run","value":"p2-i66","start":192,"end":206},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i67","type":"spatial/source-run","value":"p2-i67","start":208,"end":216},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i68","type":"spatial/source-run","value":"p2-i68","start":218,"end":223},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i69","type":"spatial/source-run","value":"p2-i69","start":225,"end":227},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i72","type":"spatial/source-run","value":"p2-i72","start":228,"end":275},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i74","type":"spatial/source-run","value":"p2-i74","start":277,"end":327},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i77","type":"spatial/source-run","value":"p2-i77","start":329,"end":373},{"id":"folio-987545ffb087f1ece898-p2-b1-0-p2-i79","type":"spatial/source-run","value":"p2-i79","start":375,"end":418}],"metadata":{"folio":{"kind":"list_item","frame":{"x":74.11,"y":195.19,"width":216.16,"height":118.21},"fontSize":10.91,"lineCount":9,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"• We demonstrate the importance of bidirectional pre-training for language representations. Unlike Radford et al. (2018), which uses unidirectional language models for pre-training, BERT uses masked language models to enable pretrained deep bidirectional representations. This is also in contrast to Peters et al. (2018a), which uses a shallow concatenation of independently trained left-to-right and right-to-left LMs."}]},{"id":"folio-987545ffb087f1ece898-p2-b2-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i88","type":"spatial/source-run","value":"p2-i88","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i89","type":"spatial/source-run","value":"p2-i89","start":2,"end":48},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i95","type":"spatial/source-run","value":"p2-i95","start":50,"end":52},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i96","type":"spatial/source-run","value":"p2-i96","start":54,"end":57},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i97","type":"spatial/source-run","value":"p2-i97","start":59,"end":61},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i98","type":"spatial/source-run","value":"p2-i98","start":63,"end":66},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i99","type":"spatial/source-run","value":"p2-i99","start":68,"end":85},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i100","type":"spatial/source-run","value":"p2-i100","start":87,"end":90},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i102","type":"spatial/source-run","value":"p2-i102","start":91,"end":98},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i103","type":"spatial/source-run","value":"p2-i103","start":100,"end":113},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i104","type":"spatial/source-run","value":"p2-i104","start":115,"end":136},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i106","type":"spatial/source-run","value":"p2-i106","start":137,"end":183},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i108","type":"spatial/source-run","value":"p2-i108","start":185,"end":200},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i109","type":"spatial/source-run","value":"p2-i109","start":202,"end":212},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i110","type":"spatial/source-run","value":"p2-i110","start":214,"end":215},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i111","type":"spatial/source-run","value":"p2-i111","start":217,"end":217},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i112","type":"spatial/source-run","value":"p2-i112","start":219,"end":223},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i113","type":"spatial/source-run","value":"p2-i113","start":225,"end":229},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i118","type":"spatial/source-run","value":"p2-i118","start":231,"end":277},{"id":"folio-987545ffb087f1ece898-p2-b2-0-p2-i121","type":"spatial/source-run","value":"p2-i121","start":278,"end":318}],"metadata":{"folio":{"kind":"list_item","frame":{"x":74.11,"y":325.29,"width":216.16,"height":91.11},"fontSize":10.91,"lineCount":7,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"• We show that pre-trained representations reduce the need for many heavily-engineered taskspecific architectures. BERT is the first finetuning based representation model that achieves state-of-the-art performance on a large suite of sentence-level and token-level tasks, outperforming many task-specific architectures."}]},{"id":"folio-987545ffb087f1ece898-p2-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b3-0-p2-i126","type":"spatial/source-run","value":"p2-i126","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p2-b3-0-p2-i127","type":"spatial/source-run","value":"p2-i127","start":2,"end":46},{"id":"folio-987545ffb087f1ece898-p2-b3-0-p2-i129","type":"spatial/source-run","value":"p2-i129","start":48,"end":57},{"id":"folio-987545ffb087f1ece898-p2-b3-0-p2-i130","type":"spatial/source-run","value":"p2-i130","start":59,"end":82},{"id":"folio-987545ffb087f1ece898-p2-b3-0-p2-i131","type":"spatial/source-run","value":"p2-i131","start":84,"end":86},{"id":"folio-987545ffb087f1ece898-p2-b3-0-p2-i135","type":"spatial/source-run","value":"p2-i135","start":87,"end":126},{"id":"folio-987545ffb087f1ece898-p2-b3-0-p2-i137","type":"spatial/source-run","value":"p2-i137","start":128,"end":148}],"metadata":{"folio":{"kind":"list_item","frame":{"x":74.11,"y":428.29,"width":216.16,"height":50.46},"fontSize":10.91,"lineCount":4,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"• BERT advances the state of the art for eleven NLP tasks. The code and pre-trained models are available at https://github.com/ google-research/bert."}]},{"id":"folio-987545ffb087f1ece898-p2-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b4-0-p2-i139","type":"spatial/source-run","value":"p2-i139","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p2-b4-0-bold-p2-i139","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p2-b4-0-p2-i140","type":"spatial/source-run","value":"p2-i140","start":2,"end":13},{"id":"folio-987545ffb087f1ece898-p2-b4-0-bold-p2-i140","type":"style/bold","star