un","value":"p3-i114","start":288,"end":293},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i115","type":"spatial/source-run","value":"p3-i115","start":295,"end":303},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i116","type":"spatial/source-run","value":"p3-i116","start":305,"end":306},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i117","type":"spatial/source-run","value":"p3-i117","start":308,"end":310},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i118","type":"spatial/source-run","value":"p3-i118","start":312,"end":320},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i123","type":"spatial/source-run","value":"p3-i123","start":322,"end":366},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i125","type":"spatial/source-run","value":"p3-i125","start":367,"end":417},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i133","type":"spatial/source-run","value":"p3-i133","start":419,"end":467},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i135","type":"spatial/source-run","value":"p3-i135","start":469,"end":490},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i136","type":"spatial/source-run","value":"p3-i136","start":492,"end":505},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i137","type":"spatial/source-run","value":"p3-i137","start":507,"end":519},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i138","type":"spatial/source-run","value":"p3-i138","start":521,"end":550},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i141","type":"spatial/source-run","value":"p3-i141","start":552,"end":602},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i142","type":"spatial/source-run","value":"p3-i142","start":604,"end":650},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i143","type":"spatial/source-run","value":"p3-i143","start":651,"end":651},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i145","type":"spatial/source-run","value":"p3-i145","start":653,"end":679},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i146","type":"spatial/source-run","value":"p3-i146","start":681,"end":699},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i153","type":"spatial/source-run","value":"p3-i153","start":701,"end":741},{"id":"folio-987545ffb087f1ece898-p3-b8-1-bold-p3-i153","type":"style/bold","start":701,"end":741},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i158","type":"spatial/source-run","value":"p3-i158","start":742,"end":782},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i160","type":"spatial/source-run","value":"p3-i160","start":784,"end":812},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i165","type":"spatial/source-run","value":"p3-i165","start":814,"end":856},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i169","type":"spatial/source-run","value":"p3-i169","start":858,"end":861},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i170","type":"spatial/source-run","value":"p3-i170","start":863,"end":864},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i171","type":"spatial/source-run","value":"p3-i171","start":866,"end":900},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i173","type":"spatial/source-run","value":"p3-i173","start":902,"end":912},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i174","type":"spatial/source-run","value":"p3-i174","start":914,"end":947},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i180","type":"spatial/source-run","value":"p3-i180","start":949,"end":997},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i182","type":"spatial/source-run","value":"p3-i182","start":998,"end":1047},{"id":"folio-987545ffb087f1ece898-p3-b8-1-p3-i184","type":"spatial/source-run","value":"p3-i184","start":1049,"end":1094}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":378.08,"width":218.27,"height":322.84},"fontSize":10.91,"lineCount":24,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Model Architecture BERT's model architecture is a multi-layer bidirectional Transformer encoder based on the original implementation described in Vaswani et al. (2017) and released in the tensor2tensor library.1 Because the use of Transformers has become common and our implementation is almost identical to the original, we will omit an exhaustive background description of the model architecture and refer readers to Vaswani et al. (2017) as well as excellent guides such as \"The Annotated Transformer.\"2 In this work, we denote the number of layers (i.e., Transformer blocks) as L, the hidden size as H, and the number of self-attention heads as A.3 We primarily report results on two model sizes: BERT BASE (L=12, H=768, A=12, Total Parameters=110M) and BERT LARGE (L=24, H=1024, A=16, Total Parameters=340M). BERT BASE was chosen to have the same model size as OpenAI GPT for comparison purposes. Critically, however, the BERT Transformer uses bidirectional self-attention, while the GPT Transformer uses constrained self-attention where every token can only attend to context to its left.4"}]},{"id":"folio-987545ffb087f1ece898-p3-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p3-b9-0-p3-i187","type":"spatial/source-run","value":"p3-i187","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p3-b9-0-p3-i188","type":"spatial/source-run","value":"p3-i188","start":1,"end":43}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":319.93,"y":712.52,"width":159.59,"height":9.81},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"1https://github.com/tensorflow/tensor2tensor"}]},{"id":"folio-987545ffb087f1ece898-p3-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p3-b10-0-p3-i189","type":"spatial/source-run","value":"p3-i189","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p3-b10-0-p3-i192","type":"spatial/source-run","value":"p3-i192","start":1,"end":53},{"id":"folio-987545ffb087f1ece898-p3-b10-0-p3-i191","type":"spatial/source-run","value":"p3-i191","start":55,"end":55},{"id":"folio-987545ffb087f1ece898-p3-b10-0-p3-i193","type":"spatial/source-run","value":"p3-i193","start":56,"end":113},{"id":"folio-987545ffb087f1ece898-p3-b10-0-p3-i195","type":"spatial/source-run","value":"p3-i195","start":115,"end":167}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":723.39,"width":218.27,"height":30.64},"fontSize":8.97,"lineCount":3,"leading":11.6,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"2http://nlp.seas.harvard.edu/2018/04/03/attention.html 3In all cases we set the feed-forward/filter size to be 4H, i.e., 3072 for the H = 768 and 4096 for the H = 1024."}]},{"id":"folio-987545ffb087f1ece898-p3-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i202","type":"spatial/source-run","value":"p3-i202","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i203","type":"spatial/source-run","value":"p3-i203","start":1,"end":7},{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i204","type":"spatial/source-run","value":"p3-i204","start":9,"end":12},{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i205","type":"spatial/source-run","value":"p3-i205","start":14,"end":15},{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i206","type":"spatial/source-run","value":"p3-i206","start":17,"end":19},{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i207","type":"spatial/source-run","value":"p3-i207","start":21,"end":30},{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i208","type":"spatial/source-run","value":"p3-i208","start":32,"end":34},{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i209","type":"spatial/source-run","value":"p3-i209","start":36,"end":48},{"id":"folio-987545ffb087f1ece898-p3-b11-0-p3-i210","type":"spatial/source-run","value":"p3-i210","start":50,"end":55}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":319.93,"y":755.1,"width":205.62,"height":9.8},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4We note that in the literature the bidirectional Trans-"}]},{"id":"folio-987