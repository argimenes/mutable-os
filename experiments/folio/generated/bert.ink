":{"x":307.28,"y":236.92,"width":218.29,"height":44.83},"fontSize":9.96,"lineCount":4,"leading":11.96,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Table 7: CoNLL-2003 Named Entity Recognition results. Hyperparameters were selected using the Dev set. The reported Dev and Test scores are averaged over 5 random restarts using those hyperparameters."}]},{"id":"folio-987545ffb087f1ece898-p9-b29-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i86","type":"spatial/source-run","value":"p9-i86","start":0,"end":19},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i87","type":"spatial/source-run","value":"p9-i87","start":21,"end":48},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i92","type":"spatial/source-run","value":"p9-i92","start":50,"end":100},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i94","type":"spatial/source-run","value":"p9-i94","start":102,"end":135},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i98","type":"spatial/source-run","value":"p9-i98","start":137,"end":184},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i101","type":"spatial/source-run","value":"p9-i101","start":186,"end":221},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i102","type":"spatial/source-run","value":"p9-i102","start":223,"end":225},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i103","type":"spatial/source-run","value":"p9-i103","start":227,"end":232},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i111","type":"spatial/source-run","value":"p9-i111","start":233,"end":281},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i113","type":"spatial/source-run","value":"p9-i113","start":283,"end":322},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i114","type":"spatial/source-run","value":"p9-i114","start":324,"end":325},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i122","type":"spatial/source-run","value":"p9-i122","start":326,"end":373},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i129","type":"spatial/source-run","value":"p9-i129","start":374,"end":377},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i130","type":"spatial/source-run","value":"p9-i130","start":379,"end":403},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i131","type":"spatial/source-run","value":"p9-i131","start":405,"end":417},{"id":"folio-987545ffb087f1ece898-p9-b29-0-p9-i133","type":"spatial/source-run","value":"p9-i133","start":419,"end":443}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":314.34,"width":218.81,"height":135.62},"fontSize":10.91,"lineCount":10,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"layer in the output. We use the representation of the first sub-token as the input to the token-level classifier over the NER label set. To ablate the fine-tuning approach, we apply the feature-based approach by extracting the activations from one or more layers without fine-tuning any parameters of BERT. These contextual embeddings are used as input to a randomly initialized two-layer 768-dimensional BiLSTM before the classification layer."}]},{"id":"folio-987545ffb087f1ece898-p9-b30-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i136","type":"spatial/source-run","value":"p9-i136","start":0,"end":32},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i137","type":"spatial/source-run","value":"p9-i137","start":34,"end":43},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i139","type":"spatial/source-run","value":"p9-i139","start":45,"end":93},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i142","type":"spatial/source-run","value":"p9-i142","start":94,"end":141},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i144","type":"spatial/source-run","value":"p9-i144","start":143,"end":192},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i146","type":"spatial/source-run","value":"p9-i146","start":193,"end":241},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i148","type":"spatial/source-run","value":"p9-i148","start":243,"end":285},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i149","type":"spatial/source-run","value":"p9-i149","start":287,"end":290},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i152","type":"spatial/source-run","value":"p9-i152","start":292,"end":340},{"id":"folio-987545ffb087f1ece898-p9-b30-0-p9-i155","type":"spatial/source-run","value":"p9-i155","start":341,"end":376}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":457.55,"width":218.27,"height":104.66},"fontSize":10.91,"lineCount":8,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Results are presented in Table 7. BERT LARGE performs competitively with state-of-the-art methods. The best performing method concatenates the token representations from the top four hidden layers of the pre-trained Transformer, which is only 0.3 F1 behind fine-tuning the entire model. This demonstrates that BERT is effective for both finetuning and feature-based approaches."}]},{"id":"folio-987545ffb087f1ece898-p9-b31-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b31-0-p9-i157","type":"spatial/source-run","value":"p9-i157","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p9-b31-0-bold-p9-i157","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p9-b31-0-p9-i158","type":"spatial/source-run","value":"p9-i158","start":2,"end":11},{"id":"folio-987545ffb087f1ece898-p9-b31-0-bold-p9-i158","type":"style/bold","start":2,"end":11}],"metadata":{"folio":{"kind":"heading","frame":{"x":307.28,"y":588.73,"width":75.07,"height":10.76},"fontSize":11.96,"lineCount":1,"leading":13.51,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"6 Conclusion"}]},{"id":"folio-987545ffb087f1ece898-p9-b32-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i168","type":"spatial/source-run","value":"p9-i168","start":0,"end":5},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i169","type":"spatial/source-run","value":"p9-i169","start":7,"end":15},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i170","type":"spatial/source-run","value":"p9-i170","start":17,"end":28},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i171","type":"spatial/source-run","value":"p9-i171","start":30,"end":35},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i172","type":"spatial/source-run","value":"p9-i172","start":37,"end":44},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i180","type":"spatial/source-run","value":"p9-i180","start":46,"end":92},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i188","type":"spatial/source-run","value":"p9-i188","start":94,"end":97},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i189","type":"spatial/source-run","value":"p9-i189","start":99,"end":144},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i197","type":"spatial/source-run","value":"p9-i197","start":146,"end":189},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i198","type":"spatial/source-run","value":"p9-i198","start":191,"end":192},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i213","type":"spatial/source-run","value":"p9-i213","start":194,"end":243},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i221","type":"spatial/source-run","value":"p9-i221","start":245,"end":294},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i222","type":"spatial/source-run","value":"p9-i222","start":295,"end":300},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i223","type":"spatial/source-run","value":"p9-i223","start":302,"end":342},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i227","type":"spatial/source-run","value":"p9-i227","start":343,"end":393},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i229","type":"spatial/source-run","value":"p9-i229","start":394,"end":442},{"id":"folio-987545ffb087f1ece898-p9-b32-0-p9-i231","type":"spatial/source-run","value":"p9-i231","start":443,"end":484}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":620.02,"width":218.29,"height":131.76},"fontSize":10.91,"lineCount":10,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Recent empirical improvements due to transfer learning with language models have demonstrated that rich, unsupervised pre-training is an integral part of many language understanding systems. In particular, these results enable even low-resource tasks to benefit from deep unidirectional architectures. Our major contribution is further generalizing these findings to deep bidirectional architectures, allowing the same pre-trained model to successfully tackle a broad set of NLP tasks."}]},{"id":"folio-987545ffb087f1ece898-p9-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b22-0-p9-i233","type":"spatial/source-run","value":"p9-i233","start":0,"end":3}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":287.86,"y":778.25,"width":21.82,"height":9.75},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4179"}]},{"id":"folio-987545ffb087f1ece898-p10","type":"page-block","properties":{"metadata":{"folio":{"number":10,"width":595.2760009765625,"height":841.8900146484375,"rules":[]}}},"children":[{"placementId":"folio-placement-folio-987545ffb087f1ece898-p10-b0-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p10-b0-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p10-b1-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p10-b1-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p10-b2-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p10-b2-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p10-b3-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p10-b3-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p10-b4-0","kind":"owned","target":{"kind":"loca