e-run","value":"p9-i128","start":529,"end":536},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i132","type":"spatial/source-run","value":"p9-i132","start":538,"end":586},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i134","type":"spatial/source-run","value":"p9-i134","start":588,"end":635},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i135","type":"spatial/source-run","value":"p9-i135","start":637,"end":686},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i138","type":"spatial/source-run","value":"p9-i138","start":688,"end":733},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i140","type":"spatial/source-run","value":"p9-i140","start":735,"end":745},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i141","type":"spatial/source-run","value":"p9-i141","start":747,"end":774},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i143","type":"spatial/source-run","value":"p9-i143","start":776,"end":820},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i145","type":"spatial/source-run","value":"p9-i145","start":822,"end":868},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i147","type":"spatial/source-run","value":"p9-i147","start":870,"end":914},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i150","type":"spatial/source-run","value":"p9-i150","start":916,"end":926},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i151","type":"spatial/source-run","value":"p9-i151","start":928,"end":960},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i153","type":"spatial/source-run","value":"p9-i153","start":962,"end":973},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i154","type":"spatial/source-run","value":"p9-i154","start":975,"end":1009},{"id":"folio-987545ffb087f1ece898-p9-b10-0-p9-i156","type":"spatial/source-run","value":"p9-i156","start":1010,"end":1059}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":286.37,"width":218.28,"height":295.09},"fontSize":10.91,"lineCount":22,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"All of the BERT results presented so far have used the fine-tuning approach, where a simple classification layer is added to the pre-trained model, and all parameters are jointly fine-tuned on a downstream task. However, the feature-based approach, where fixed features are extracted from the pretrained model, has certain advantages. First, not all tasks can be easily represented by a Transformer encoder architecture, and therefore require a task-specific model architecture to be added. Second, there are major computational benefits to pre-compute an expensive representation of the training data once and then run many experiments with cheaper models on top of this representation. In this section, we compare the two approaches by applying BERT to the CoNLL-2003 Named Entity Recognition (NER) task (Tjong Kim Sang and De Meulder, 2003). In the input to BERT, we use a case-preserving WordPiece model, and we include the maximal document context provided by the data. Following standard practice, we formulate this as a tagging task but do not use a CRF"}]},{"id":"folio-987545ffb087f1ece898-p9-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b12-0-p9-i159","type":"spatial/source-run","value":"p9-i159","start":0,"end":10}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":89.03,"y":607.69,"width":48.3,"height":8.02},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Hyperparams"}]},{"id":"folio-987545ffb087f1ece898-p9-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p9-b13-0-p9-i161","type":"spatial/source-run","value":"p9-i161","start":0,"end":1},{"id":"folio-987545ffb087f1ece898-p9-b13-0-p9-i162","type":"spatial/source-run","value":"p9-i162","start":3,"end":4}],"metadata":{"folio":{"kind":"table","frame":{"x":85.57,"y":623.13,"width":34.44,"height":8.02},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"serif","align":"lef