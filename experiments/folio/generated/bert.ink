:218.29,"height":91.1},"fontSize":10.91,"lineCount":7,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"We also observed that large data sets (e.g., 100k+ labeled training examples) were far less sensitive to hyperparameter choice than small data sets. Fine-tuning is typically very fast, so it is reasonable to simply run an exhaustive search over the above parameters and choose the model that performs best on the development set."}]},{"id":"folio-987545ffb087f1ece898-p14-b3-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b3-0-p14-i35","type":"spatial/source-run","value":"p14-i35","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p14-b3-0-bold-p14-i35","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p14-b3-0-p14-i36","type":"spatial/source-run","value":"p14-i36","start":4,"end":32},{"id":"folio-987545ffb087f1ece898-p14-b3-0-bold-p14-i36","type":"style/bold","start":4,"end":32},{"id":"folio-987545ffb087f1ece898-p14-b3-0-p14-i38","type":"spatial/source-run","value":"p14-i38","start":34,"end":43},{"id":"folio-987545ffb087f1ece898-p14-b3-0-bold-p14-i38","type":"style/bold","start":34,"end":43}],"metadata":{"folio":{"kind":"heading","frame":{"x":72,"y":208.81,"width":186.35,"height":23.37},"fontSize":10.91,"lineCount":2,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"A.4 Comparison of BERT, ELMo ,and OpenAI GPT"}]},{"id":"folio-987545ffb087f1ece898-p14-b4-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i43","type":"spatial/source-run","value":"p14-i43","start":0,"end":48},{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i45","type":"spatial/source-run","value":"p14-i45","start":50,"end":95},{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i48","type":"spatial/source-run","value":"p14-i48","start":97,"end":135},{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i51","type":"spatial/source-run","value":"p14-i51","start":136,"end":183},{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i53","type":"spatial/source-run","value":"p14-i53","start":185,"end":196},{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i54","type":"spatial/source-run","value":"p14-i54","start":198,"end":234},{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i56","type":"spatial/source-run","value":"p14-i56","start":235,"end":280},{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i58","type":"spatial/source-run","value":"p14-i58","start":281,"end":328},{"id":"folio-987545ffb087f1ece898-p14-b4-0-p14-i60","type":"spatial/source-run","value":"p14-i60","start":330,"end":338}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":240.38,"width":218.29,"height":104.65},"fontSize":10.91,"lineCount":8,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Here we studies the differences in recent popular representation learning models including ELMo, OpenAI GPT and BERT. The comparisons between the model architectures are shown visually in Figure 3. Note that in addition to the architecture differences, BERT and OpenAI GPT are finetuning approaches, while ELMo is a feature-based approach."}]},{"id":"folio-987545ffb087f1ece898-p14-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i61","type":"spatial/source-run","value":"p14-i61","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i62","type":"spatial/source-run","value":"p14-i62","start":4,"end":7},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i63","type":"spatial/source-run","value":"p14-i63","start":9,"end":18},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i64","type":"spatial/source-run","value":"p14-i64","start":20,"end":27},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i65","type":"spatial/source-run","value":"p14-i65","start":29,"end":40},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i68","type":"spatial/source-run","value":"p14-i68","start":42,"end":85},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i71","type":"spatial/source-run","value":"p14-i71","start":87,"end":134},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i73","type":"spatial/source-run","value":"p14-i73","start":135,"end":184},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i74","type":"spatial/source-run","value":"p14-i74","start":186,"end":203},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i75","type":"spatial/source-run","value":"p14-i75","start":205,"end":211},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i76","type":"spatial/source-run","value":"p14-i76","start":213,"end":219},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i77","type":"spatial/source-run","value":"p14-i77","start":221,"end":222},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i78","type":"spatial/source-run","value":"p14-i78","start":224,"end":228},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i79","type":"spatial/source-run","value":"p14-i79","start":230,"end":231},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i84","type":"spatial/source-run","value":"p14-i84","start":233,"end":280},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i86","type":"spatial/source-run","value":"p14-i86","start":282,"end":300},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i87","type":"spatial/source-run","value":"p14-i87","start":302,"end":326},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i89","type":"spatial/source-run","value":"p14-i89","start":328,"end":377},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i92","type":"spatial/source-run","value":"p14-i92","start":378,"end":428},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i94","type":"spatial/source-run","value":"p14-i94","start":430,"end":432},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i95","type":"spatial/source-run","value":"p14-i95","start":434,"end":448},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i96","type":"spatial/source-run","value":"p14-i96","start":450,"end":476},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i98","type":"spatial/source-run","value":"p14-i98","start":478,"end":528},{"id":"folio-987545ffb087f1ece898-p14-b5-0-p14-i100","type":"spatial/source-run","value":"p14-i100","start":530,"end":567}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":349.01,"width":218.29,"height":158.85},"fontSize":10.91,"lineCount":12,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The most comparable existing pre-training method to BERT is OpenAI GPT, which trains a left-to-right Transformer LM on a large text corpus. In fact, many of the design decisions in BERT were intentionally made to make it as close to GPT as possible so that the two methods could be minimally compared. The core argument of this work is that the bi-directionality and the two pretraining tasks presented in Section 3.1 account for the majority of the empirical improvements, but we do note that there are several other differences between how BERT and GPT were trained:"}]},{"id":"folio-987545ffb087f1ece898-p14-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b6-0-p14-i105","type":"spatial/source-run","value":"p14-i105","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p14-b6-0-p14-i106","type":"spatial/source-run","value":"p14-i106","start":2,"end":40},{"id":"folio-987545ffb087f1ece898-p14-b6-0-p14-i108","type":"spatial/source-run","value":"p14-i108","start":42,"end":48},{"id":"folio-987545ffb087f1ece898-p14-b6-0-p14-i109","type":"spatial/source-run","value":"p14-i109","start":50,"end":80},{"id":"folio-987545ffb087f1ece898-p14-b6-0-p14-i112","type":"spatial/source-run","value":"p14-i112","start":81,"end":118},{"id":"folio-987545ffb087f1ece898-p14-b6-0-p14-i114","type":"spatial/source-run","value":"p14-i114","start":120,"end":126}],"metadata":{"folio":{"kind":"list_item","frame":{"x":85.02,"y":522.6,"width":205.25,"height":50.45},"fontSize":10.91,"lineCount":4,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"• GPT is trained on the BooksCorpus (800M words); BERT is trained on the BooksCorpus (800M words) and Wikipedia (2,500M words)."}]},{"id":"folio-987545ffb087f1ece898-p14-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i116","type":"spatial/source-run","value":"p14-i116","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i117","type":"spatial/source-run","value":"p14-i117","start":2,"end":42},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i119","type":"spatial/source-run","value":"p14-i119","start":44,"end":85},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i122","type":"spatial/source-run","value":"p14-i122","start":86,"end":93},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i123","type":"spatial/source-run","value":"p14-i123","start":95,"end":96},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i124","type":"spatial/source-run","value":"p14-i124","start":98,"end":108},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i125","type":"spatial/source-run","value":"p14-i125","start":110,"end":114},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i126","type":"spatial/source-run","value":"p14-i126","start":116,"end":126},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i133","type":"spatial/source-run","value":"p14-i133","start":128,"end":162},{"id":"folio-987545ffb087f1ece898-p14-b7-0-p14-i136","type":"spatial/source-run","value":"p14-i136","start":163,"end":188}],"metadata":{"folio":{"kind":"list_item","frame":{"x":85.02,"y":586.69,"width":205.25,"height":64.02},"fontSize":10.91,"lineCount":5,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"• GPT uses a sentence separator ([SEP]) and classifier token ([CLS]) which are only introduced at fine-tuning time; BERT learns [SEP], [CLS] and sentence A/B embeddings during pre-training."}]},{"id":"folio-987545ffb087f1ece898-p14-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b8-0-p14-i147","type":"spatial/source-run","value":"p14-i147","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p14-b8-0-p14-i148","type":"spatial/source-run","value":"p14-i148","start":2,"end":42},{"id":"folio-987545ffb087f1ece898-p14-b8-0-p14-i150","type":"spatial/source-run","value":"p14-i150","start":44,"end":85},{"id":"folio-987545ffb087f1ece898-p14-b8-0-p14-i152","type":"spatial/source-run","value":"p14-i152","start":87,"end":130}],"metadata":{"folio":{"kind":"list_item","frame":{"x":85.02,"y":664.33,"width":205.27,"height":36.91},"fontSize":10.91,"lineCount":3,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"• GPT was trained for 1M steps with a batch size of 32,000 words; BERT was trained for 1M steps with a batch size of 128,000 words."}]},{"id":"folio-987545ffb087f1ece898-p14-b9-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b9-0-p14-i154","type":"spatial/source-run","value":"p14-i154","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p14-b9-0-p14-i155","type":"spatial/source-run","value":"p14-i155","start":2,"end":44},{"id":"folio-987545ffb087f1ece898-p14-b9-0-p14-i157","type":"spatial/source-run","value":"p14-i157","start":46,"end":88},{"id":"folio-987545ffb087f1ece898-p14-b9-0-p14-i164","type":"spatial/source-run","value":"p14-i164","start":90,"end":134},{"id":"folio-987545ffb087f1ece898-p14-b9-0-p14-i166","type":"spatial/source-run","value":"p14-i166","start":136,"end":176}],"metadata":{"folio":{"kind":"list_item","frame":{"x":85.02,"y":714.81,"width":205.27,"height":50.51},"fontSize":10.91,"lineCount":4,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"• GPT used the same learning rate of 5e-5 for all fine-tuning experiments; BERT chooses a task-specific fine-tuning learning rate which performs the best on the development set."}]},{"id":"folio-987545ffb087f1ece898-p14-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b10-0-p14-i2","type":"spatial/source-run","value":"p14-i2","start":0,"end":49},{"id":"folio-987545ffb087f1ece898-p14-b10-0-p14-i5","type":"spatial/source-run","value":"p14-i5","start":50,"end":62},{"id":"folio-987545ffb087f1ece898-p14-b10-0-p14-i6","type":"spatial/source-run","value":"p14-i6","start":64,"end":77},{"id":"folio-987545ffb087f1ece898-p14-b10-0-p14-i7","type":"spatial/source-run","value":"p14-i7","start":79,"end":95},{"id":"folio-987545ffb087f1ece898-p14-b10-0-p14-i8","type":"spatial/source-run","value":"p14-i8","start":97,"end":145},{"id":"folio-987545ffb087f1ece898-p14-b10-0-p14-i16","type":"spatial/source-run","value":"p14-i16","start":147,"end":196},{"id":"folio-987545ffb087f1ece898-p14-b10-0-p14-i21","type":"spatial/source-run","value":"p14-i21","start":198,"end":234}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":66.32,"width":218.27,"height":64.02},"fontSize":10.91,"lineCount":5,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"To isolate the effect of these differences, we perform ablation experiments in Section 5.1 which demonstrate that the majority of the improvements are in fact coming from the two pre-training tasks and the bidirectionality they enable."}]},{"id":"folio-987545ffb087f1ece898-p14-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b11-0-p14-i24","type":"spatial/source-run","value":"p14-i24","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p14-b11-0-bold-p14-i24","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p14-b11-0-p14-i25","type":"spatial/source-run","value":"p14-i25","start":4,"end":44},{"id":"folio-987545ffb087f1ece898-p14-b11-0-bold-p14-i25","type":"style/bold","start":4,"end":44},{"id":"folio-987545ffb087f1ece898-p14-b