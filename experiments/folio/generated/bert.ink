1,"end":488},{"id":"folio-987545ffb087f1ece898-p13-b21-0-p13-i114","type":"spatial/source-run","value":"p13-i114","start":490,"end":500}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":265.86,"width":218.29,"height":145.3},"fontSize":10.91,"lineCount":11,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"epochs over the 3.3 billion word corpus. We use Adam with learning rate of 1e$-4,\\beta _{1}=0.9$, $\\beta _{2}=0.999$, L2 weight decay of 0.01, learning rate warmup over the first 10,000 steps, and linear decay of the learning rate. We use a dropout probability of 0.1 on all layers. We use a gelu activation (Hendrycks and Gimpel, 2016) rather than the standard relu, following OpenAI GPT. The training loss is the sum of the mean masked LM likelihood and the mean next sentence prediction likelihood."}]},{"id":"folio-987545ffb087f1ece898-p13-b22-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i121","type":"spatial/source-run","value":"p13-i121","start":0,"end":7},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i122","type":"spatial/source-run","value":"p13-i122","start":9,"end":20},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i123","type":"spatial/source-run","value":"p13-i123","start":22,"end":34},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i124","type":"spatial/source-run","value":"p13-i124","start":36,"end":39},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i127","type":"spatial/source-run","value":"p13-i127","start":41,"end":85},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i128","type":"spatial/source-run","value":"p13-i128","start":87,"end":95},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i129","type":"spatial/source-run","value":"p13-i129","start":97,"end":132},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i136","type":"spatial/source-run","value":"p13-i136","start":134,"end":180},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i137","type":"spatial/source-run","value":"p13-i137","start":181,"end":213},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i143","type":"spatial/source-run","value":"p13-i143","start":215,"end":259},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i146","type":"spatial/source-run","value":"p13-i146","start":260,"end":310},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i147","type":"spatial/source-run","value":"p13-i147","start":312,"end":318},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i148","type":"spatial/source-run","value":"p13-i148","start":320,"end":360},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i151","type":"spatial/source-run","value":"p13-i151","start":362,"end":377},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i152","type":"spatial/source-run","value":"p13-i152","start":379,"end":407},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i154","type":"spatial/source-run","value":"p13-i154","start":409,"end":433},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i155","type":"spatial/source-run","value":"p13-i155","start":435,"end":457},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i157","type":"spatial/source-run","value":"p13-i157","start":459,"end":506},{"id":"folio-987545ffb087f1ece898-p13-b22-0-p13-i160","type":"spatial/source-run","value":"p13-i160","start":508,"end":529}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":415.44,"width":218.81,"height":159.4},"fontSize":10.91,"lineCount":12,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Training of BERT BASE was performed on 4 Cloud TPUs in Pod configuration (16 TPU chips total).13 Training of BERT LARGE was performed on 16 Cloud TPUs (64 TPU chips total). Each pretraining took 4 days to complete. Longer sequences are disproportionately expensive because attention is quadratic to the sequence length. To speed up pretraing in our experiments, we pre-train the model with sequence length of 128 for 90% of the steps. Then, we train the rest 10% of the steps of sequence of 512 to learn the positional embeddings."}]},{"id":"folio-987545ffb087f1ece898-p13-b23-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p13-b23-0-p13-i164","type":"spatial/source-run","value":"p13-i164","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p13-b23-0-bold-p13-i164","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p13-b23-0-p13-i165","type":"spatial/source-run","value":"p13-i165","start":4,"end":24},{"id":"folio-987545ffb087f1ece898-p13-b23-0-bold-p13-i165","type":"style/bold","start":4,"end":24}],"metadata":{"folio":{"kind":"heading","frame":{"x":307.28,"y":589.18,"width":132.33,"height":9.82},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"A.3 Fine-tuning Procedure"}]},{"id":"folio-987545ffb087f1ece898-p13-b24-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i167","type":"spatial/source-run","value":"p13-i167","start":0,"end":46},{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i169","type":"spatial/source-run","value":"p13-i169","start":48,"end":97},{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i171","type":"spatial/source-run","value":"p13-i171","start":99,"end":148},{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i173","type":"spatial/source-run","value":"p13-i173","start":149,"end":159},{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i174","type":"spatial/source-run","value":"p13-i174","start":161,"end":194},{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i176","type":"spatial/source-run","value":"p13-i176","start":196,"end":207},{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i177","type":"spatial/source-run","value":"p13-i177","start":209,"end":241},{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i179","type":"spatial/source-run","value":"p13-i179","start":243,"end":293},{"id":"folio-987545ffb087f1ece898-p13-b24-0-p13-i181","type":"spatial/source-run","value":"p13-i181","start":295,"end":343}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":607.82,"width":218.81,"height":91.1},"fontSize":10.91,"lineCount":7,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"For fine-tuning, most model hyperparameters are the same as in pre-training, with the exception of the batch size, learning rate, and number of training epochs. The dropout probability was always kept at 0.1. The optimal hyperparameter values are task-specific, but we found the following range of possible values to work well across all tasks:"}]},{"id":"folio-987545ffb087f1ece898-p13-b25-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p13-b25-0-p13-i184","type":"spatial/source-run","value":"p13-i184","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p13-b25-0-p13-i185","type":"spatial/source-run","value":"p13-i185","start":2,"end":19},{"id":"folio-987545ffb087f1ece898-p13-b25-0-bold-p13-i185","type":"style/bold","start":2,"end":19}],"metadata":{"folio":{"kind":"list_item","frame":{"x":320.3,"y":714.96,"width":89.45,"height":9.89},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"• Batch size: 16, 32"}]},{"id":"folio-987545ffb087f1ece898-p13-b26-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p13-b26-0-p13-i187","type":"spatial/source-run","value":"p13-i187","start":0,"end":1},{"id":"folio-987545ffb087f1ece898-p13-b26-0-p13-i188","type":"spatial/source-run","value":"p13-i188","start":2,"end":52},{"id":"folio-987545ffb087f1ece898-p13-b26-0-p13-i190","type":"spatial/source-run","value":"p13-i190","start":53,"end":97},{"id":"folio-987545ffb087f1ece898-p13-b26-0-p13-i196","type":"spatial/source-run","value":"p13-i196","start":98,"end":114}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307