lio-987545ffb087f1ece898-p1-b15-0-p1-i181","type":"spatial/source-run","value":"p1-i181","start":851,"end":861},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i185","type":"spatial/source-run","value":"p1-i185","start":862,"end":906},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i187","type":"spatial/source-run","value":"p1-i187","start":907,"end":912},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i188","type":"spatial/source-run","value":"p1-i188","start":914,"end":919},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i189","type":"spatial/source-run","value":"p1-i189","start":921,"end":925},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i190","type":"spatial/source-run","value":"p1-i190","start":927,"end":930},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i191","type":"spatial/source-run","value":"p1-i191","start":932,"end":939},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i192","type":"spatial/source-run","value":"p1-i192","start":941,"end":946},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i193","type":"spatial/source-run","value":"p1-i193","start":948,"end":950},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i195","type":"spatial/source-run","value":"p1-i195","start":952,"end":995},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i201","type":"spatial/source-run","value":"p1-i201","start":997,"end":1046},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i203","type":"spatial/source-run","value":"p1-i203","start":1048,"end":1054},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i204","type":"spatial/source-run","value":"p1-i204","start":1056,"end":1058},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i205","type":"spatial/source-run","value":"p1-i205","start":1060,"end":1081},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i206","type":"spatial/source-run","value":"p1-i206","start":1083,"end":1088},{"id":"folio-987545ffb087f1ece898-p1-b15-0-p1-i207","type":"spatial/source-run","value":"p1-i207","start":1090,"end":1095}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":306.52,"y":456.91,"width":219.57,"height":308.42},"fontSize":10.91,"lineCount":23,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"cially for the fine-tuning approaches. The major limitation is that standard language models are unidirectional, and this limits the choice of architectures that can be used during pre-training. For example, in OpenAI GPT, the authors use a left-toright architecture, where every token can only attend to previous tokens in the self-attention layers of the Transformer (Vaswani et al., 2017). Such restrictions are sub-optimal for sentence-level tasks, and could be very harmful when applying finetuning based approaches to token-level tasks such as question answering, where it is crucial to incorporate context from both directions. In this paper, we improve the fine-tuning based approaches by proposing BERT: Bidirectional Encoder Representations from Transformers. BERT alleviates the previously mentioned unidirectionality constraint by using a \"masked language model\" (MLM) pre-training objective, inspired by the Cloze task (Taylor, 1953). The masked language model randomly masks some of the tokens from the input, and the objective is to predict the original vocabulary id of the masked"}]},{"id":"folio-987545ffb087f1ece898-p1-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p1-b12-0-p1-i208","type":"spatial/source-run","value":"p1-i208","start":0,"end":3}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":287.86,"y":778.25,"width":21.82,"height":9.75},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4171"}]},{"id":"folio-987545ffb087f1ece898-p1-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p1-b16-0-p1-i209","type":"spatial/source-run","value":"p1-i209","start":0,"end":45},{"id":"folio-987545ffb087f1ece898-p1-b16-0-italics-p1-i209","type":"style/italics","start":0,"end":45}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":202.54,"y":795.31,"width":190.19,"height":8.08},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Proceedings of NAACL-HLT 2019, pages 4171-4186"}]},{"id":"folio-987545ffb087f1ece898-p1-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p1-b17-0-p1-i210","type":"spatial/source-run","value":"p1-i210","start":0,"end":45},{"id":"folio-987545ffb087f1ece898-p1-b17-0-p1-i211","type":"spatial/source-run","value":"p1-i211","start":47,"end":94}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":120.16,"y":806.43,"width":354.95,"height":8.29},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Minneapolis, Minnesota, June 2 - June 7, 2019. c 2019 Association for Computational Linguistics"}]},{"id":"folio-987545ffb087f1ece898-p2","type":"page-block","properties":{"metadata":{"folio":{"number":2,"width":595.2760009765625,"height":841.8900146484375,"rules":[]}}},"children":[{"placementId":"folio-placement-folio-987545ffb087f1ece898-p2-b0-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p2-b0-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p2-b1-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p2-b1-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p2-b2-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p2-b2-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p2-b3-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p2-b3-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p2-b4-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p2-b4-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece