ragraph","frame":{"x":72,"y":410.32,"width":218.27,"height":118.21},"fontSize":10.91,"lineCount":9,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"There has also been work showing effective transfer from supervised tasks with large datasets, such as natural language inference (Conneau et al., 2017) and machine translation (McCann et al., 2017). Computer vision research has also demonstrated the importance of transfer learning from large pre-trained models, where an effective recipe is to fine-tune models pre-trained with ImageNet (Deng et al., 2009; Yosinski et al., 2014)."}]},{"id":"folio-987545ffb087f1ece898-p3-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p3-b6-0-p3-i139","type":"spatial/source-run","value":"p3-i139","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p3-b6-0-bold-p3-i139","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p3-b6-0-p3-i140","type":"spatial/source-run","value":"p3-i140","start":2,"end":5},{"id":"folio-987545ffb087f1ece898-p3-b6-0-bold-p3-i140","type":"style/bold","start":2,"end":5}],"metadata":{"folio":{"kind":"heading","frame":{"x":72,"y":542.9,"width":50.01,"height":10.75},"fontSize":11.96,"lineCount":1,"leading":13.51,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"3 BERT"}]},{"id":"folio-987545ffb087f1ece898-p3-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p3-b7-0-p3-i144","type":"spatial/source-run","value":"p3-i144","start":0,"end":44},{"id":"folio-987545ffb087f1ece898-p3-b7-0-p3-i147","type":"spatial/source-run","value":"p3-i147","start":45,"end":48},{"id":"folio-987545ffb087f1ece898-p3-b7-0-p3-i148","type":"spatial/source-run","value":"p3-i148","start":50,"end":51},{"id":"folio-987545ffb087f1ece898-p3-b7-0-p3-i149","type":"spatial/source-run","value":"p3-i149","start":53,"end":56},{"id":"folio-987545ffb087f1ece898-p3-b7-0-p3-i