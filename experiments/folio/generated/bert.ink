art":338,"end":348},{"id":"folio-987545ffb087f1ece898-p14-b12-0-p14-i50","type":"spatial/source-run","value":"p14-i50","start":350,"end":389},{"id":"folio-987545ffb087f1ece898-p14-b12-0-p14-i52","type":"spatial/source-run","value":"p14-i52","start":391,"end":442},{"id":"folio-987545ffb087f1ece898-p14-b12-0-p14-i55","type":"spatial/source-run","value":"p14-i55","start":444,"end":493},{"id":"folio-987545ffb087f1ece898-p14-b12-0-p14-i57","type":"spatial/source-run","value":"p14-i57","start":494,"end":541},{"id":"folio-987545ffb087f1ece898-p14-b12-0-p14-i59","type":"spatial/source-run","value":"p14-i59","start":543,"end":574}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":174.37,"width":218.28,"height":158.85},"fontSize":10.91,"lineCount":12,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The illustration of fine-tuning BERT on different tasks can be seen in Figure 4. Our task-specific models are formed by incorporating BERT with one additional output layer, so a minimal number of parameters need to be learned from scratch. Among the tasks, (a) and (b) are sequence-level tasks while (c) and (d) are token-level tasks. In the figure, E represents the input embedding$,T_{i}$ represents the contextual representation of token i, [CLS] is the special symbol for classification output, and [SEP] is the special symbol to separate non-consecutive token sequences."}]},{"id":"folio-987545ffb087f1ece898-p14-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b13-0-p14-i66","type":"spatial/source-run","value":"p14-i66","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p14-b13-0-bold-p14-i66","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p14-b13-0-p14-i67","type":"spatial/source-run","value":"p14-i67","start":2,"end":28},{"id":"folio-987545ffb087f1ece898-p14-b13-0-bold-p14-i67","type":"style/bold","start":2,"end":28}],"metadata":{"folio":{"kin