start":299,"end":327},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i97","type":"spatial/source-run","value":"p6-i97","start":328,"end":352},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i98","type":"spatial/source-run","value":"p6-i98","start":354,"end":392},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i99","type":"spatial/source-run","value":"p6-i99","start":394,"end":399},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i101","type":"spatial/source-run","value":"p6-i101","start":401,"end":412},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i102","type":"spatial/source-run","value":"p6-i102","start":414,"end":448},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i104","type":"spatial/source-run","value":"p6-i104","start":450,"end":499},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i106","type":"spatial/source-run","value":"p6-i106","start":500,"end":518},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i107","type":"spatial/source-run","value":"p6-i107","start":520,"end":551},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i115","type":"spatial/source-run","value":"p6-i115","start":553,"end":627},{"id":"folio-987545ffb087f1ece898-p6-b10-0-p6-i117","type":"spatial/source-run","value":"p6-i117","start":629,"end":629}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":252.12,"width":218.29,"height":161.08},"fontSize":10.91,"lineCount":12,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Wikipedia containing the answer, the task is to predict the answer text span in the passage. As shown in Figure 1, in the question answering task, we represent the input question and passage as a single packed sequence, with the question using the A embedding and the passage using the B embedding. We only introduce a start vector $S\\in \\mathbb{R}^{H}$ and an end vector $E\\in \\mathbb{R}^{H}$ during fine-tuning. The probability of word i being the start of the answer span is computed as a dot product between $T_{i}$ and S followed by a softmax over all of the words in the paragraph$:P_{i}=\\sum ^{e_{S\\cdot Tj}^{S\\cdot Ti}}$ ."}]},{"id":"folio-987545ffb087f1ece898-p6-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p6-b11-0-p6-i116","type":"spatial/source-run","value":"p6-i116","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p6-b11-0-p6-i119","type":"spatial/source-run","value":"p6-i119","start":2,"end":2}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":496.5,"y":411.23,"width":9.24,"height":9.24},"fontSize":7.97,"lineCount":2,"leading":7.97,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"e j"}]},{"id":"folio-987545ffb087f1ece898-p6-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i121","type":"spatial/source-run","value":"p6-i121","start":0,"end":47},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i123","type":"spatial/source-run","value":"p6-i123","start":49,"end":95},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i124","type":"spatial/source-run","value":"p6-i124","start":97,"end":164},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i126","type":"spatial/source-run","value":"p6-i126","start":166,"end":201},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i127","type":"spatial/source-run","value":"p6-i127","start":203,"end":208},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i129","type":"spatial/source-run","value":"p6-i129","start":210,"end":230},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i130","type":"spatial/source-run","value":"p6-i130","start":232,"end":260},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i133","type":"spatial/source-run","value":"p6-i133","start":262,"end":312},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i136","type":"spatial/source-run","value":"p6-i136","start":314,"end":327},{"id":"folio-987545ffb087f1ece898-p6-b12-0-p6-i137","type":"spatial/source-run","value":"p6-i137","start":329,"end":360},{"id":"folio-987545ffb087f1ece89