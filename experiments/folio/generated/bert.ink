spatial/source-run","value":"p2-i218","start":519,"end":524},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i219","type":"spatial/source-run","value":"p2-i219","start":526,"end":529},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i220","type":"spatial/source-run","value":"p2-i220","start":531,"end":540},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i222","type":"spatial/source-run","value":"p2-i222","start":542,"end":587},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i226","type":"spatial/source-run","value":"p2-i226","start":588,"end":636},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i228","type":"spatial/source-run","value":"p2-i228","start":637,"end":641},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i229","type":"spatial/source-run","value":"p2-i229","start":643,"end":647},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i230","type":"spatial/source-run","value":"p2-i230","start":649,"end":652},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i231","type":"spatial/source-run","value":"p2-i231","start":654,"end":656},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i232","type":"spatial/source-run","value":"p2-i232","start":658,"end":677},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i234","type":"spatial/source-run","value":"p2-i234","start":679,"end":680},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i235","type":"spatial/source-run","value":"p2-i235","start":682,"end":685},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i236","type":"spatial/source-run","value":"p2-i236","start":687,"end":693},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i237","type":"spatial/source-run","value":"p2-i237","start":695,"end":707},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i238","type":"spatial/source-run","value":"p2-i238","start":709,"end":716},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i239","type":"spatial/source-run","value":"p2-i239","start":718,"end":723}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":550.6,"width":218.28,"height":214.74},"fontSize":10.91,"lineCount":16,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"As with the feature-based approaches, the first works in this direction only pre-trained word embedding parameters from unlabeled text (Collobert and Weston, 2008). More recently, sentence or document encoders which produce contextual token representations have been pre-trained from unlabeled text and fine-tuned for a supervised downstream task (Dai and Le, 2015; Howard and Ruder, 2018; Radford et al., 2018). The advantage of these approaches is that few parameters need to be learned from scratch. At least partly due to this advantage, OpenAI GPT (Radford et al., 2018) achieved previously state-of-the-art results on many sentencelevel tasks from the GLUE benchmark (Wang et al., 2018a). Left-to-right language model-"}]},{"id":"folio-987545ffb087f1ece898-p2-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b8-0-p2-i240","type":"spatial/source-run","value":"p2-i240","start":0,"end":3}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":287.86,"y":778.25,"width":21.82,"height":9.75},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4172"}]},{"id":"folio-987545ffb087f1ece898-p3","type":"page-block","properties":{"metadata":{"folio":{"number":3,"width":595.2760009765625,"height":841.8900146484375,"rules":[]}}},"children":[{"placementId":"folio-placement-folio-987545ffb087f1ece898-p3-b0-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p3-b0-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p3-b0-1","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p3-b0-1"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p3-b1-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p3-b1-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p3-b2-0","ki