rties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b2-1-p5-i39","type":"spatial/source-run","value":"p5-i39","start":0,"end":7},{"id":"folio-987545ffb087f1ece898-p5-b2-1-p5-i40","type":"spatial/source-run","value":"p5-i40","start":8,"end":17}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":117.35,"y":151.55,"width":37.44,"height":14.26},"fontSize":18.67,"lineCount":1,"leading":21.09,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"PositionEmbeddings"}]},{"id":"folio-987545ffb087f1ece898-p5-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b5-0-p5-i52","type":"spatial/source-run","value":"p5-i52","start":0,"end":106},{"id":"folio-987545ffb087f1ece898-p5-b5-0-p5-i53","type":"spatial/source-run","value":"p5-i53","start":107,"end":150}],"metadata":{"folio":{"kind":"caption","frame":{"x":72,"y":185.2,"width":453.55,"height":20.92},"fontSize":9.96,"lineCount":2,"leading":11.96,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Figure 2: BERT input representation. The input embeddings are the sum of the token embeddings, the segmentation embeddings and the position embeddings."}]},{"id":"folio-987545ffb087f1ece898-p5-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b6-0-p5-i54","type":"spatial/source-run","value":"p5-i54","start":0,"end":48},{"id":"folio-987545ffb087f1ece898-p5-b6-0-p5-i56","type":"spatial/source-run","value":"p5-i56","start":49,"end":101},{"id":"folio-987545ffb087f1ece898-p5-b6-0-p5-i58","type":"spatial/source-run","value":"p5-i58","start":103,"end":128},{"id":"folio-987545ffb087f1ece898-p5-b6-0-p5-i59","type":"spatial/source-run","value":"p5-i59","start":130,"end":146},{"id":"folio-987545ffb087f1ece898-p5-b6-0-p5-i61","type":"spatial/source-run","value":"p5-i61","start":148,"end":196},{"id":"folio-987545ffb087f1ece898-p5-b6-0-p5-i63","type":"spatial/source-run","value":"p5-i63","start":198,"end":243},{"id":"folio-987545ffb087f1ece898-p5-b6-0-p5-i65","type":"spatial/source-run","value":"p5-i65","start":244,"end":292}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":230.98,"width":218.29,"height":77.55},"fontSize":10.91,"lineCount":6,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The NSP task is closely related to representationlearning objectives used in Jernite et al. (2017) and Logeswaran and Lee (2018). However, in prior work, only sentence embeddings are transferred to down-stream tasks, where BERT transfers all parameters to initialize end-task model parameters."}]},{"id":"folio-987545ffb087f1ece898-p5-b6-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i68","type":"spatial/source-run","value":"p5-i68","start":0,"end":11},{"id":"folio-987545ffb087f1ece898-p5-b6-1-bold-p5-i68","type":"style/bold","start":0,"end":11},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i69","type":"spatial/source-run","value":"p5-i69","start":13,"end":16},{"id":"folio-987545ffb087f1ece898-p5-b6-1-bold-p5-i69","type":"style/bold","start":13,"end":16},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i70","type":"spatial/source-run","value":"p5-i70","start":18,"end":20},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i71","type":"spatial/source-run","value":"p5-i71","start":22,"end":33},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i72","type":"spatial/source-run","value":"p5-i72","start":35,"end":43},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i77","type":"spatial/source-run","value":"p5-i77","start":45,"end":95},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i85","type":"spatial/source-run","value":"p5-i85","start":97,"end":146},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i87","type":"spatial/source-run","value":"p5-i87","start":148,"end":192},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i89","type":"spatial/source-run","value":"p5-i89","start":194,"end":198},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i90","type":"spatial/source-run","value":"p5-i90","start":200,"end":202},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i91","type":"spatial/source-run","value":"p5-i91","start":204,"end":210},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i92","type":"spatial/source-run","value":"p5-i92","start":212,"end":220},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i93","type":"spatial/source-run","value":"p5-i93","start":222,"end":228},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i94","type":"spatial/source-run","value":"p5-i94","start":230,"end":236},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i97","type":"spatial/source-run","value":"p5-i97","start":238,"end":284},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i100","type":"spatial/source-run","value":"p5-i100","start":286,"end":302},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i101","type":"spatial/source-run","value":"p5-i101","start":304,"end":310},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i102","type":"spatial/source-run","value":"p5-i102","start":312,"end":323},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i103","type":"spatial/source-run","value":"p5-i103","start":325,"end":326},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i104","type":"spatial/source-run","value":"p5-i104","start":328,"end":329},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i105","type":"spatial/source-run","value":"p5-i105","start":331,"end":335},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i108","type":"spatial/source-run","value":"p5-i108","start":336,"end":341},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i109","type":"spatial/source-run","value":"p5-i109","start":343,"end":383},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i111","type":"spatial/source-run","value":"p5-i111","start":385,"end":434},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i112","type":"spatial/source-run","value":"p5-i112","start":436,"end":483},{"id":"folio-987545ffb087f1ece898-p5-b6-1-p5-i115","type":"spatial/source-run","value":"p5-i115","start":485,"end":518}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":320.95,"width":218.27,"height":145.4},"fontSize":10.91,"lineCount":11,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Pre-training data The pre-training procedure largely follows the existing literature on language model pre-training. For the pre-training corpus we use the BooksCorpus (800M words) (Zhu et al., 2015) and English Wikipedia (2,500M words). For Wikipedia we extract only the text passages and ignore lists, tables, and headers. It is critical to use a document-level corpus rather than a shuffled sentence-level corpus such as the Billion Word Benchmark (Chelba et al., 2013) in order to extract long contiguous sequences."}]},{"id":"folio-987545ffb087f1ece898-p5-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b7-0-p5-i117","type":"spatial/source-run","value":"p5-i117","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p5-b7-0-bold-p5-i117","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p5-b7-0-p5-i118","type":"spatial/source-run","value":"p5-i118","start":4,"end":19},{"id":"folio-987545ffb087f1ece898-p5-b7-0-bold-p5-i118","type":"style/bold","start":4,"end":19}],"metadata":{"folio":{"kind":"heading","frame":{"x":72,"y":479.74,"width":111.1,"height":9.82},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"3.2 Fine-tuning BERT"}]},{"id":"folio-987545ffb087f1ece898-p5-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i120","type":"spatial/source-run","value":"p5-i120","start":0,"end":10},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i121","type":"spatial/source-run","value":"p5-i121","start":12,"end":13},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i122","type":"spatial/source-run","value":"p5-i122","start":15,"end":29},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i123","type":"spatial/source-run","value":"p5-i123","start":31,"end":35},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i124","type":"spatial/source-run","value":"p5-i124","start":37,"end":39},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i125","type":"spatial/source-run","value":"p5-i125","start":41,"end":44},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i128","type":"spatial/source-run","value":"p5-i128","start":45,"end":53},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i129","type":"spatial/source-run","value":"p5-i129","start":55,"end":63},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i130","type":"spatial/source-run","value":"p5-i130","start":65,"end":66},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i131","type":"spatial/source-run","value":"p5-i131","start":68,"end":70},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i132","type":"spatial/source-run","value":"p5-i132","start":72,"end":82},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i133","type":"spatial/source-run","value":"p5-i133","start":84,"end":85},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i135","type":"spatial/source-run","value":"p5-i135","start":86,"end":125},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i137","type":"spatial/source-run","value":"p5-i137","start":126,"end":174},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i139","type":"spatial/source-run","value":"p5-i139","start":176,"end":223},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i141","type":"spatial/source-run","value":"p5-i141","start":225,"end":255},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i142","type":"spatial/source-run","value":"p5-i142","start":257,"end":262},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i143","type":"spatial/source-run","value":"p5-i143","start":264,"end":271},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i145","type":"spatial/source-run","value":"p5-i145","start":273,"end":279},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i146","type":"spatial/source-run","value":"p5-i146","start":281,"end":282},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i147","type":"spatial/source-run","value":"p5-i147","start":284,"end":285},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i148","type":"spatial/source-run","value":"p5-i148","start":287,"end":320},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i150","type":"spatial/source-run","value":"p5-i150","start":321,"end":333},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i151","type":"spatial/source-run","value":"p5-i151","start":335,"end":347},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i152","type":"spatial/source-run","value":"p5-i152","start":349,"end":353},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i153","type":"spatial/source-run","value":"p5-i153","start":355,"end":364},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i154","type":"spatial/source-run","value":"p5-i154","start":366,"end":369},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i158","type":"spatial/source-run","value":"p5-i158","start":371,"end":413},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i159","type":"spatial/source-run","value":"p5-i159","start":415,"end":418},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i164","type":"spatial/source-run","value":"p5-i164","start":420,"end":469},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i171","type":"spatial/source-run","value":"p5-i171","start":471,"end":519},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i173","type":"spatial/source-run","value":"p5-i173","start":521,"end":524},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i174","type":"spatial/source-run","value":"p5-i174","start":526,"end":565},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i175","type":"spatial/source-run","value":"p5-i175","start":567,"end":570},{"id":"folio-987545ffb087f1ece898-p5-b8-0-italics-p5-i175","type":"style/italics","start":567,"end":570},{"id":"folio-987545ffb087f1ece898-p5-b8-0-p5-i178","type":"spatial/source-run","value":"p5-i178","start":571,"end":618},{"id":"folio-987545ffb087f1ece898-p5-b8-0-italics-p5-i178","type":"style/italics","start":571,"end":618}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":497.82,"width":218.28,"height":172.4},"fontSize":10.91,"lineCount":13,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Fine-tuning is straightforward since the selfattention mechanism in the Transformer allows BERT to model many downstream taskswhether they involve single text or text pairs-by swapping out the appropriate inputs and outputs. For applications involving text pairs, a common pattern is to independently encode text pairs before applying bidirectional cross attention, such as Parikh et al. (2016); Seo et al. (2017). BERT instead uses the self-attention mechanism to unify these two stages, as encoding a concatenated text pair with self-attention effectively includes bidirectional cross attention between two sentences."}]},{"id":"folio-987545ffb087f1ece898-p5-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i181","type":"spatial/source-run","value":"p5-i181","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i182","type":"spatial/source-run","value":"p5-i182","start":4,"end":7},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i183","type":"spatial/source-run","value":"p5-i183","start":9,"end":13},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i184","type":"spatial/source-run","value":"p5-i184","start":15,"end":23},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i185","type":"spatial/source-run","value":"p5-i185","start":25,"end":28},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i186","type":"spatial/source-run","value":"p5-i186","start":30,"end":31},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i187","type":"spatial/source-run","value":"p5-i187","start":33,"end":35},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i188","type":"spatial/source-run","value":"p5-i188","start":37,"end":40},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i191","type":"spatial/source-run","value":"p5-i191","start":41,"end":48},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i192","type":"spatial/source-run","value":"p5-i192","start":50,"end":86},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i194","type":"spatial/source-run","value":"p5-i194","start":87,"end":90},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i195","type":"spatial/source-run","value":"p5-i195","start":92,"end":94},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i196","type":"spatial/source-run","value":"p5-i196","start":96,"end":98},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i197","type":"spatial/source-run","value":"p5-i197","start":100,"end":109},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i198","type":"spatial/source-run","value":"p5-i198","start":111,"end":121},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i199","type":"spatial/source-run","value":"p5-i199","start":123,"end":128},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i200","type":"spatial/source-run","value":"p5-i200","start":130,"end":131},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i202","type":"spatial/source-run","value":"p5-i202","start":132,"end":179},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i204","type":"spatial/source-run","value":"p5-i204","start":181,"end":228},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i207","type":"spatial/source-run","value":"p5-i207","start":229,"end":280},{"id":"folio-987545ffb087f1ece898-p5-b10-0-p5-i209","type":"spatial/source-run","value":"p5-i209","start":282,"end":330}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":674.22,"width":218.27,"height":91.11},"fontSize":10.91,"lineCount":7,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"For each task, we simply plug in the taskspecific inputs and outputs into BERT and finetune all the parameters end-to-end. At the input, sentence A and sentence B from pre-training are analogous to (1) sentence pairs in paraphrasing, (2) hypothesis-premise pairs in entailment, (3) question-passage pairs in question answering, and"}]},{"id":"folio-987545ffb087f1ece898-p5-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b12-0-p5-i55","type":"spatial/source-run","value":"p5-i55","start":0,"end":50},{"id":"folio-987545ffb087f1ece898-p5-b12-0-p5-i57","type":"spatial/source-run","value":"p5-i57","start":52,"end":100},{"id":"folio-987545ffb087f1ece898-p5-b12-0-p5-i60","type":"spatial/source-run","value":"p5-i60","start":101,"end":151},{"id":"folio-987545ffb087f1ece898-p5-b12-0-p5-i62","type":"spatial/source-run","value":"p5-i62","start":152,"end":200},{"id":"folio-987545ffb087f1ece898-p5-b12-0-p5-i64","type":"spatial/source-run","value":"p5-i64","start":202,"end":247},{"id":"folio-987545ffb087f1ece898-p5-b12-0-p5-i66","type":"spatial/source-run","value":"p5-i66","start":249,"end":299},{"id":"folio-987545ffb087f1ece898-p5-b12-0-p5-i67","type":"spatial/source-run","value":"p5-i67","start":300,"end":330}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":230.98,"width":218.27,"height":91.11},"fontSize":10.91,"lineCount":7,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"(4) a degenerate text-∅ pair in text classification or sequence tagging. At the output, the token representations are fed into an output layer for tokenlevel tasks, such as sequence tagging or question answering, and the [CLS] representation is fed into an output layer for classification, such as entailment or sentiment analysis."}]},{"id":"folio-987545ffb087f1ece898-p5-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b13-0-p5-i73","type":"spatial/source-run","value":"p5-i73","start":0,"end":24},{"id":"folio-987545ffb087f1ece898-p5-b13-0-p5-i74","type":"spatial/source-run","value":"p5-i74","start":26,"end":36},{"id":"folio-987545ffb087f1ece898-p5-b13-0-p5-i75","type":"spatial/source-run","value":"p5-i75","start":38,"end":39},{"i