tart":127,"end":172},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i40","type":"spatial/source-run","value":"p8-i40","start":174,"end":220},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i47","type":"spatial/source-run","value":"p8-i47","start":222,"end":267},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i49","type":"spatial/source-run","value":"p8-i49","start":268,"end":285},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i50","type":"spatial/source-run","value":"p8-i50","start":287,"end":315},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i53","type":"spatial/source-run","value":"p8-i53","start":317,"end":367},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i55","type":"spatial/source-run","value":"p8-i55","start":369,"end":370},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i56","type":"spatial/source-run","value":"p8-i56","start":372,"end":417},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i58","type":"spatial/source-run","value":"p8-i58","start":419,"end":465},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i60","type":"spatial/source-run","value":"p8-i60","start":467,"end":520},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i62","type":"spatial/source-run","value":"p8-i62","start":522,"end":570},{"id":"folio-987545ffb087f1ece898-p8-b5-0-p8-i64","type":"spatial/source-run","value":"p8-i64","start":572,"end":614}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":66.32,"width":218.29,"height":173.89},"fontSize":10.91,"lineCount":13,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"results are still far worse than those of the pretrained bidirectional models. The BiLSTM hurts performance on the GLUE tasks. We recognize that it would also be possible to train separate LTR and RTL models and represent each token as the concatenation of the two models, as ELMo does. However: (a) this is twice as expensive as a single bidirectional model; (b) this is non-intuitive for tasks like QA, since the RTL model would not be able to condition the answer on the question; (c) this it is strictly less powerful than a deep bidirectional model, since it can use both left and right context at every layer."}]},{"id":"folio-987545ffb087f1ece898-p8-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p8-b6-0-p8-i65","type":"spatial/source-run","value":"p8-i65","start":0,"end":43}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":264.28,"width":196.95,"height":9.81},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"ablation studies can be found in Appendix C."}]},{"id":"folio-987545ffb087f1ece898-p8-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p8-b7-0-p8-i69","type":"spatial/source-run","value":"p8-i69","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p8-b7-0-bold-p8-i69","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p8-b7-0-p8-i70","type":"spatial/source-run","value":"p8-i70","start":4,"end":31},{"id":"folio-987545ffb087f1ece898-p8-b7-0-bold-p8-i70","type":"style/bold","start":4,"end":31}],"metadata":{"folio":{"kind":"heading","frame":{"x":72,"y":290.9,"width":153.33,"height":9.82},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"5.1 Effect of Pre-training Tasks"}]},{"id":"folio-987545ffb087f1ece898-p8-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p8-b8-0-p8-i72","type":"spatial/source-run","value":"p8-i72","start":0,"end":45},{"id":"folio-987545ffb087f1ece898-p8-b8-0-p8-i74","type":"spatial/source-run","value":"p8-i74","start":46,"end":57},{"id":"folio-987545ffb087f1ece898-p8-b8-0-p8-i75","type":"spatial/source-run","value":"p8-i75","start":59,"end":60},{"id":"folio-987545ffb087f1ece898-p8-b8-0-p8-i76","type":"spatial/source-run","value":"p8-i76","start":62,"end":65},{"id":"