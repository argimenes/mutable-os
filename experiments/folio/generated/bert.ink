252,"end":264},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i206","type":"spatial/source-run","value":"p12-i206","start":266,"end":279},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i208","type":"spatial/source-run","value":"p12-i208","start":281,"end":291},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i209","type":"spatial/source-run","value":"p12-i209","start":293,"end":296},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i210","type":"spatial/source-run","value":"p12-i210","start":298,"end":303},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i211","type":"spatial/source-run","value":"p12-i211","start":305,"end":307},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i212","type":"spatial/source-run","value":"p12-i212","start":309,"end":326},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i213","type":"spatial/source-run","value":"p12-i213","start":328,"end":333},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i214","type":"spatial/source-run","value":"p12-i214","start":335,"end":373},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i216","type":"spatial/source-run","value":"p12-i216","start":375,"end":423},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i218","type":"spatial/source-run","value":"p12-i218","start":425,"end":436},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i219","type":"spatial/source-run","value":"p12-i219","start":438,"end":452},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i220","type":"spatial/source-run","value":"p12-i220","start":454,"end":470},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i222","type":"spatial/source-run","value":"p12-i222","start":471,"end":475},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i224","type":"spatial/source-run","value":"p12-i224","start":477,"end":521},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i225","type":"spatial/source-run","value":"p12-i225","start":523,"end":567},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i228","type":"spatial/source-run","value":"p12-i228","start":569,"end":574},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i229","type":"spatial/source-run","value":"p12-i229","start":576,"end":577},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i230","type":"spatial/source-run","value":"p12-i230","start":579,"end":589},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i231","type":"spatial/source-run","value":"p12-i231","start":591,"end":609},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i232","type":"spatial/source-run","value":"p12-i232","start":611,"end":614},{"id":"folio-987545ffb087f1ece898-p12-b17-1-p12-i234","type":"spatial/source-run","value":"p12-i234","start":616,"end":663}],"metadata":{"folio":{"kind":"list_item","frame":{"x":307.28,"y":565.66,"width":218.81,"height":199.67},"fontSize":10.91,"lineCount":15,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The advantage of this procedure is that the Transformer encoder does not know which words it will be asked to predict or which have been replaced by random words, so it is forced to keep a distributional contextual representation of every input token. Additionally, because random replacement only occurs for 1.5% of all tokens (i.e., 10% of 15%), this does not seem to harm the model's language understanding capability. In Section C.2, we evaluate the impact this procedure. Compared to standard langauge model training, the masked LM only make predictions on 15% of tokens in each batch, which suggests that more pre-training steps may be required for the model"}]},{"id":"folio-987545ffb087f1ece898-p12-b7-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p12-b7-1-p12-i235","type":"spatial/source-run","value":"p12-i235","start":0,"end":3}],"metadata":{"folio":{"kind":"list_item","frame":{"x":287.86,"y":778.25,"width":21.82,"height":9.75},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4182"}]},{"id":"folio-987545ffb087f1ece898-p13