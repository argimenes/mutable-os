,"start":570,"end":617},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i168","type":"spatial/source-run","value":"p4-i168","start":619,"end":621},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i169","type":"spatial/source-run","value":"p4-i169","start":623,"end":628},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i170","type":"spatial/source-run","value":"p4-i170","start":630,"end":637},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i171","type":"spatial/source-run","value":"p4-i171","start":639,"end":640},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i172","type":"spatial/source-run","value":"p4-i172","start":642,"end":650},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i173","type":"spatial/source-run","value":"p4-i173","start":652,"end":661},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i175","type":"spatial/source-run","value":"p4-i175","start":663,"end":664},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i176","type":"spatial/source-run","value":"p4-i176","start":666,"end":674},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i177","type":"spatial/source-run","value":"p4-i177","start":676,"end":709},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i179","type":"spatial/source-run","value":"p4-i179","start":710,"end":713},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i180","type":"spatial/source-run","value":"p4-i180","start":715,"end":721},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i181","type":"spatial/source-run","value":"p4-i181","start":723,"end":729},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i182","type":"spatial/source-run","value":"p4-i182","start":731,"end":733},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i183","type":"spatial/source-run","value":"p4-i183","start":735,"end":745},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i184","type":"spatial/source-run","value":"p4-i184","start":747,"end":754},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i186","type":"spatial/source-run","value":"p4-i186","start":755,"end":806},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i188","type":"spatial/source-run","value":"p4-i188","start":808,"end":811},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i189","type":"spatial/source-run","value":"p4-i189","start":813,"end":814},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i190","type":"spatial/source-run","value":"p4-i190","start":816,"end":819},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i191","type":"spatial/source-run","value":"p4-i191","start":821,"end":830},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i192","type":"spatial/source-run","value":"p4-i192","start":832,"end":833},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i193","type":"spatial/source-run","value":"p4-i193","start":835,"end":838},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i194","type":"spatial/source-run","value":"p4-i194","start":840,"end":850},{"id":"folio-987545ffb087f1ece898-p4-b10-0-p4-i195","type":"spatial/source-run","value":"p4-i195","start":852,"end":852}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":485.6,"width":218.29,"height":240.15},"fontSize":10.91,"lineCount":18,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Many important downstream tasks such as Question Answering (QA) and Natural Language Inference (NLI) are based on understanding the relationship between two sentences, which is not directly captured by language modeling. In order to train a model that understands sentence relationships, we pre-train for a binarized next sentence prediction task that can be trivially generated from any monolingual corpus. Specifically, when choosing the sentences A and B for each pretraining example, 50% of the time B is the actual next sentence that follows A (labeled as IsNext), and 50% of the time it is a random sentence from the corpus (labeled as NotNext). As we show in Figure 1, C is used for next sentence prediction (NSP).5 Despite its simplicity, we demonstrate in Section 5.1 that pre-training towards this task is very beneficial to both QA and NLI. 6"}]},{"id":"folio-987545ffb087f1ece898-p4-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p4-b11-0-p4-i197","type":"spatial/source-run","value":"p4-i197","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p4-b11-0-p4-i198","type":"spatial/source-run","value":"p4-i198","start":1,"end":49}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":319.93,"y":734.21,"width":196.23,"height":9.87},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"5The final model achieves 97%-98% accuracy on NSP."}]},{"id":"folio-987545ffb087f1ece898-p4-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p4-b12-0-p4-i200","type":"spatial/source-run","value":"p4-i200","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p4-b12-0-p4-i201","type":"spatial/source-run","value":"p4-i201","start":1,"end":56},{"id":"folio-987545ffb087f1ece898-p4-b12-0-p4-i203","type":"spatial/source-run","value":"p4-i203","start":58,"end":108}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":745.11,"width":218.26,"height":19.81},"fontSize":8.97,"lineCount":2,"leading":11.74,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"6The vector C is not a meaningful sentence representation without fine-tuning, since it was trained with NSP."}]},{"id":"folio-987545ffb087f1ece898-p4-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p4-b6-0-p4-i204","type":"spatial/source-run","value":"p4-i204","start":0,"end":3}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":287.86,"y":778.25,"width":21.82,"height":9.75},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4174"}]},{"id":"folio-987545ffb087f1ece898-p5","type":"page-block","properties":{"metadata":{"folio":{"number":5,"width":595.2760009765625,