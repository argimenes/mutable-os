rom 1 to 5 denoting how similar the two sentences are in terms of semantic meaning."}]},{"id":"folio-987545ffb087f1ece898-p15-b23-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i108","type":"spatial/source-run","value":"p15-i108","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p15-b23-0-bold-p15-i108","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i109","type":"spatial/source-run","value":"p15-i109","start":4,"end":14},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i110","type":"spatial/source-run","value":"p15-i110","start":16,"end":22},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i111","type":"spatial/source-run","value":"p15-i111","start":24,"end":33},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i112","type":"spatial/source-run","value":"p15-i112","start":35,"end":36},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i113","type":"spatial/source-run","value":"p15-i113","start":38,"end":41},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i115","type":"spatial/source-run","value":"p15-i115","start":42,"end":45},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i116","type":"spatial/source-run","value":"p15-i116","start":47,"end":56},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i117","type":"spatial/source-run","value":"p15-i117","start":58,"end":69},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i118","type":"spatial/source-run","value":"p15-i118","start":71,"end":72},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i119","type":"spatial/source-run","value":"p15-i119","start":74,"end":87},{"id":"folio-987545ffb087f1ece898-p15-b23-0-p15-i120","type":"spatial/source-run","value":"p15-i120","start":89,"end":140}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":487.94,"width":218.27,"height":36.99},"fontSize":10.91,"lineCount":3,"leading":13.63,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"RTE Recognizing Textua