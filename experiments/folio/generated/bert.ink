un","value":"p15-i145","start":176,"end":184},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i148","type":"spatial/source-run","value":"p15-i148","start":186,"end":233},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i150","type":"spatial/source-run","value":"p15-i150","start":235,"end":281},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i159","type":"spatial/source-run","value":"p15-i159","start":283,"end":315},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i160","type":"spatial/source-run","value":"p15-i160","start":317,"end":331},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i163","type":"spatial/source-run","value":"p15-i163","start":332,"end":348},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i164","type":"spatial/source-run","value":"p15-i164","start":350,"end":359},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i165","type":"spatial/source-run","value":"p15-i165","start":361,"end":379},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i167","type":"spatial/source-run","value":"p15-i167","start":381,"end":423},{"id":"folio-987545ffb087f1ece898-p15-b24-0-p15-i169","type":"spatial/source-run","value":"p15-i169","start":424,"end":436}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":306.52,"y":548.76,"width":219.04,"height":131.84},"fontSize":10.91,"lineCount":10,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"WNLI Winograd NLI is a small natural language inference dataset (Levesque et al., 2011). The GLUE webpage notes that there are issues with the construction of this dataset, 15 and every trained system that's been submitted to GLUE has performed worse than the 65.1 baseline accuracy of predicting the majority class. We therefore exclude this set to be fair to OpenAI GPT. For our GLUE submission, we always predicted the majority class."}]},{"id":"folio-987545ffb087f1ece898-p15-b25-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p15-b25-0-p15-i170","type":"spatial/source-run","value":"p15-i170","start":0,"end":3},{"id":"folio-987545ffb087f1ece898-p15-b25-0-bold-p15-i170","type":"style/bold","start":0,"end":3},{"id":"folio-987545ffb087f1ece898-p15-b25-0-p15-i171","type":"spatial/source-run","value":"p15-i171","start":5,"end":40},{"id":"folio-987545ffb087f1ece898-p15-b25-0-p15-i174","type":"spatial/source-run","value":"p15-i174","start":42,"end":91},{"id":"folio-987545ffb087f1ece898-p15-b25-0-p15-i177","type":"spatial/source-run","value":"p15-i177","start":93,"end":140},{"id":"folio-987545ffb087f1ece898-p15-b25-0-p15-i185","type":"spatial/source-run","value":"p15-i185","start":142,"end":190},{"id":"folio-987545ffb087f1ece898-p15-b25-0-p15-i187","type":"spatial/source-run","value":"p15-i187","start":191,"end":234}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":701.23,"width":218.27,"height":64.1},"fontSize":10.91,"lineCount":5,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"MRPC Microsoft Research Paraphrase Corpus consists of sentence pairs automatically extracted from online news sources, with human annotations for whether the sentences in the pair are semantically equivalent (Dolan and Brockett, 2005)."}]},{"id":"folio-987545ffb087f1ece898-p15-b26-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i172","type":"spatial/source-run","value":"p15-i172","start":0,"end":1},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i173","type":"spatial/source-run","value":"p15-i173","start":2,"end":57},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i175","type":"spatial/source-run","value":"p15-i175","start":59,"end":72},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i176","type":"spatial/source-run","value":"p15-i176","start":74,"end":117},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i178","type":"spatial/source-run","value":"p15-i178","start":118,"end":123},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i179","type":"spatial/source-run","value":"p15-i179","start":125,"end":158},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i180","type":"spatial/source-run","value":"p15-i180","start":160,"end":171},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i181","type":"spatial/source-run","value":"p15-i181","start":173,"end":174},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i182","type":"spatial/source-run","value":"p15-i182","start":176,"end":178},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i183","type":"spatial/source-run","value":"p15-i183","start":180,"end":198},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i184","type":"spatial/source-run","value":"p15-i184","start":200,"end":229},{"id":"folio-987545ffb087f1ece898-p15-b26-0-p15-i186","type":"spatial/source-run","value":"p15-i186","start":230,"end":253}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":704.38,"width":218.27,"height":49.66},"fontSize":8.97,"lineCount":5,"leading":9.96,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"14Note that we only report single-task fine-tuning results in this paper. A multitask fine-tuning approach could potentially push the performance even further. For example, we did observe substantial improvements on RTE from multitask training with MNLI."}]},{"id":"folio-987545ffb087f1ece898-p15-b27-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p15-b27-0-p15-i188","type":"spatial/source-run","value":"p15-i188","start":0,"end":1},{"id":"folio-987545ffb087f1ece898-p15-b27-0-p15-i189","type":"spatial/source-run","value":"p15-i189","start":2,"end":30}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":316.94,"y":755.04,"width":162.49,"height":9.58},"fontSize":8.97,"lineCount":1,"leading":10.13,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"15https://gluebenchmark.com/faq"}]},{"id":"folio-987545ffb087f1ece898-p15-b28-0","type":"standoff-editor-block","properties":{"standoffProperties