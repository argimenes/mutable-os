folio-987545ffb087f1ece898-p7-b34-0-p7-i180","type":"spatial/source-run","value":"p7-i180","start":357,"end":405},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i182","type":"spatial/source-run","value":"p7-i182","start":407,"end":454},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i185","type":"spatial/source-run","value":"p7-i185","start":456,"end":504},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i186","type":"spatial/source-run","value":"p7-i186","start":505,"end":550},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i188","type":"spatial/source-run","value":"p7-i188","start":551,"end":561},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i189","type":"spatial/source-run","value":"p7-i189","start":563,"end":571},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i190","type":"spatial/source-run","value":"p7-i190","start":573,"end":573},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i191","type":"spatial/source-run","value":"p7-i191","start":575,"end":579},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i192","type":"spatial/source-run","value":"p7-i192","start":581,"end":583},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i193","type":"spatial/source-run","value":"p7-i193","start":585,"end":588},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i194","type":"spatial/source-run","value":"p7-i194","start":590,"end":595},{"id":"folio-987545ffb087f1ece898-p7-b34-0-p7-i196","type":"spatial/source-run","value":"p7-i196","start":597,"end":637}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":435.48,"width":218.27,"height":186.51},"fontSize":10.91,"lineCount":14,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The Situations With Adversarial Generations (SWAG) dataset contains 113k sentence-pair completion examples that evaluate grounded commonsense inference (Zellers et al., 2018). Given a sentence, the task is to choose the most plausible continuation among four choices. When fine-tuning on the SWAG dataset, we construct four input sequences, each containing the concatenation of the given sentence (sentence A) and a possible continuation (sentence B). The only task-specific parameters introduced is a vector whose dot product with the [CLS] token representation C denotes a score for each choice which is normalized with a softmax layer."}]},{"id":"folio-987545ffb087f1ece898-p7-b35-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i200","type":"spatial/source-run","value":"p7-i200","start":0,"end":11},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i201","type":"spatial/source-run","value":"p7-i201","start":13,"end":15},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i202","type":"spatial/source-run","value":"p7-i202","start":17,"end":21},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i203","type":"spatial/source-run","value":"p7-i203","start":23,"end":25},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i204","type":"spatial/source-run","value":"p7-i204","start":27,"end":27},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i205","type":"spatial/source-run","value":"p7-i205","start":29,"end":34},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i206","type":"spatial/source-run","value":"p7-i206","start":36,"end":39},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i207","type":"spatial/source-run","value":"p7-i207","start":41,"end":41},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i209","type":"spatial/source-run","value":"p7-i209","start":43,"end":87},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i210","type":"spatial/source-run","value":"p7-i210","start":89,"end":90},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i217","type":"spatial/source-run","value":"p7-i217","start":91,"end":121},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i218","type":"spatial/source-run","value":"p7-i218","start":123,"end":136},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i220","type":"spatial/source-run","value":"p7-i220","start":137,"end":180},{"id":"folio-987545ffb087f1ece898-p7-b35-0-p7-i223","type":"spatial/source-run","value":"p7-i223","start":181,"end":217}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":626.27,"width":218.27,"height":64.02},"fontSize":10.91,"lineCount":5,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"We fine-tune the model for 3 epochs with a learning rate of 2e-5 and a batch size of 16. Results are presented in Table 4. BERT LARGE outperforms the authors' baseline ESIM+ELMo system by +27.1% and OpenAI GPT by 8.3%."}]},{"id":"folio-987545ffb087f1ece898-p7-b36-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p7-b36-0-p7-i225","type":"spatial/source-run","value":"p7-i225","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p7-b36-0-bold-p7-i225","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p7-b36-0-p7-i228","type":"spatial/source-run","value":"p7-i228","start":2,"end":17},{"id":"folio-987545ffb087f1ece898-p7-b36-0-bold-p7-i228","type":"style/bold","start":2,"end":17}],"metadata":{"folio":{"kind":"heading","frame":{"x":307.28,"y":705.32,"width":102.64,"height":10.77},"fontSize":11.96,"lineCount":1,"leading":13.51,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"5 Ablation Studies"}]},{"id":"folio-987545ffb087f1ece898-p7-b37-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p7-b37-0-p7-i231","type":"spatial/source-run","value":"p7-i231","start":0,"end":47},{"id":"folio-987545ffb087f1ece898-p7-b37-0-p7-i233","type":"spatial/source-run","value":"p7-i233","start":49,"end":98},{"id":"folio-987545ffb087f1ece898-p7-b37-0-p7-i235","type":"spatial/source-run","value":"p7-i235","start":100,"end":124},{"id":"folio-987545ffb087f1ece898-p7-b37-0-p7-i236","type":"spatial/source-run","value":"p7-i236","start":126,"end":136},{"id":"folio-987545ffb087f1ece898-p7-b37-0-p7-i237","type":"spatial/source-run","value":"p7-i237","s