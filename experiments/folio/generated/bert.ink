087f1ece898-p14-b15-0-p14-i88","type":"spatial/source-run","value":"p14-i88","start":94,"end":127}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":399.76,"width":218.27,"height":36.92},"fontSize":10.91,"lineCount":3,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The GLUE benchmark includes the following datasets, the descriptions of which were originally summarized in Wang et al. (2018a):"}]},{"id":"folio-987545ffb087f1ece898-p14-b15-1","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i90","type":"spatial/source-run","value":"p14-i90","start":0,"end":3},{"id":"folio-987545ffb087f1ece898-p14-b15-1-bold-p14-i90","type":"style/bold","start":0,"end":3},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i91","type":"spatial/source-run","value":"p14-i91","start":5,"end":42},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i93","type":"spatial/source-run","value":"p14-i93","start":44,"end":93},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i97","type":"spatial/source-run","value":"p14-i97","start":94,"end":145},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i99","type":"spatial/source-run","value":"p14-i99","start":147,"end":195},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i101","type":"spatial/source-run","value":"p14-i101","start":196,"end":210},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i102","type":"spatial/source-run","value":"p14-i102","start":212,"end":225},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i103","type":"spatial/source-run","value":"p14-i103","start":227,"end":240},{"id":"folio-987545ffb087f1ece898-p14-b15-1-italics-p14-i103","type":"style/italics","start":227,"end":240},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i104","type":"spatial/source-run","value":"p14-i104","start":242,"end":243},{"id":"folio-987545ffb087f1ece898-p14-b15-1-p14-i107","type":"spatial/source-run","value":"p14-i107","start":245,"end":282},{"id":"folio-987545ffb087f1ece898-p14-b15-1-italics-p14-i107","type":"style/italics","start":245,"end":282}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":447.97,"width":218.81,"height":77.63},"fontSize":10.91,"lineCount":6,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"MNLI Multi-Genre Natural Language Inference is a large-scale, crowdsourced entailment classification task (Williams et al., 2018). Given a pair of sentences, the goal is to predict whether the second sentence is an entailment, contradiction, or neutral with respect to the first one."}]},{"id":"folio-987545ffb087f1ece898-p14-b15-2","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b15-2-p14-i110","type":"spatial/source-run","value":"p14-i110","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p14-b15-2-bold-p14-i110","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p14-b15-2-p14-i111","type":"spatial/source-run","value":"p14-i111","start":4,"end":44},{"id":"folio-987545ffb087f1ece898-p14-b15-2-p14-i113","type":"spatial/source-run","value":"p14-i113","start":45,"end":93},{"id":"folio-987545ffb087f1ece898-p14-b15-2-p14-i115","type":"spatial/source-run","value":"p14-i115","start":95,"end":141},{"id":"folio-987545ffb087f1ece898-p14-b15-2-p14-i118","type":"spatial/source-run","value":"p14-i118","start":142,"end":167}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":536.9,"width":218.27,"height":50.54},"fontSize":10.91,"lineCount":4,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"QQP Quora Question Pairs is a binary classification task where the goal is to determine if two questions asked on Quora are semantically equivalent (Chen et al., 2018)."}]},{"id":"folio-987545ffb087f1ece898-p14-b15-3","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p14-b15-3-p14-i120","type":"spatial/source-