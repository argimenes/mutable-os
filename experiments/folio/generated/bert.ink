run","value":"p2-i47","start":325,"end":335},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i48","type":"spatial/source-run","value":"p2-i48","start":337,"end":349},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i49","type":"spatial/source-run","value":"p2-i49","start":351,"end":360},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i50","type":"spatial/source-run","value":"p2-i50","start":362,"end":372},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i52","type":"spatial/source-run","value":"p2-i52","start":373,"end":422},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i55","type":"spatial/source-run","value":"p2-i55","start":424,"end":446},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i56","type":"spatial/source-run","value":"p2-i56","start":448,"end":453},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i57","type":"spatial/source-run","value":"p2-i57","start":455,"end":471},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i60","type":"spatial/source-run","value":"p2-i60","start":472,"end":518},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i62","type":"spatial/source-run","value":"p2-i62","start":520,"end":565},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i64","type":"spatial/source-run","value":"p2-i64","start":567,"end":613},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i70","type":"spatial/source-run","value":"p2-i70","start":614,"end":648},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i71","type":"spatial/source-run","value":"p2-i71","start":650,"end":661},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i73","type":"spatial/source-run","value":"p2-i73","start":663,"end":715},{"id":"folio-987545ffb087f1ece898-p2-b9-0-italics-p2-i73","type":"style/italics","start":663,"end":715},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i75","type":"spatial/source-run","value":"p2-i75","start":717,"end":745},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i76","type":"spatial/source-run","value":"p2-i76","start":747,"end":764},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i78","type":"spatial/source-run","value":"p2-i78","start":765,"end":813},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i80","type":"spatial/source-run","value":"p2-i80","start":815,"end":817},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i81","type":"spatial/source-run","value":"p2-i81","start":819,"end":831},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i82","type":"spatial/source-run","value":"p2-i82","start":833,"end":849},{"id":"folio-987545ffb087f1ece898-p2-b9-0-p2-i83","type":"spatial/source-run","value":"p2-i83","start":851,"end":866}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":66.32,"width":218.81,"height":241.84},"fontSize":10.91,"lineCount":18,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"These approaches have been generalized to coarser granularities, such as sentence embeddings (Kiros et al., 2015; Logeswaran and Lee, 2018) or paragraph embeddings (Le and Mikolov, 2014). To train sentence representations, prior work has used objectives to rank candidate next sentences (Jernite et al., 2017; Logeswaran and Lee, 2018), left-to-right generation of next sentence words given a representation of the previous sentence (Kiros et al., 2015), or denoising autoencoder derived objectives (Hill et al., 2016). ELMo and its predecessor (Peters et al., 2017, 2018a) generalize traditional word embedding research along a different dimension. They extract context-sensitive features from a left-to-right and a right-to-left language model. The contextual representation of each token is the concatenation of the left-to-right and right-to-left representations."}]},{"id":"folio-987545ffb087f1ece898-p2-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i84","type":"spatial/source-run","value":"p2-i84","start":0,"end":15},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i85","type":"spatial/source-run","value":"p2-i85","start":17,"end":26},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i86","type":"spatial/source-run","value":"p2-i86","start":28,"end":31},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i87","type":"spatial/source-run","value":"p2-i87","start":33,"end":42},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i90","type":"spatial/source-run","value":"p2-i90","start":44,"end":47},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i91","type":"spatial/source-run","value":"p2-i91","start":49,"end":56},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i92","type":"spatial/source-run","value":"p2-i92","start":58,"end":70},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i93","type":"spatial/source-run","value":"p2-i93","start":72,"end":85},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i94","type":"spatial/source-run","value":"p2-i94","start":87,"end":90},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i101","type":"spatial/source-run","value":"p2-i101","start":92,"end":142},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i105","type":"spatial/source-run","value":"p2-i105","start":144,"end":191},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i107","type":"spatial/source-run","value":"p2-i107","start":192,"end":241},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i114","type":"spatial/source-run","value":"p2-i114","start":243,"end":250},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i115","type":"spatial/source-run","value":"p2-i115","start":252,"end":266},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i116","type":"spatial/source-run","value":"p2-i116","start":268,"end":273},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i117","type":"spatial/source-run","value":"p2-i117","start":275,"end":290},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i119","type":"spatial/source-run","value":"p2-i119","start":292,"end":302},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i120","type":"spatial/source-run","value":"p2-i120","start":304,"end":334},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i122","type":"spatial/source-run","value":"p2-i122","start":336,"end":341},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i123","type":"spatial/source-run","value":"p2-i123","start":343,"end":381},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i124","type":"spatial/source-run","value":"p2-i124","start":383,"end":426},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i125","type":"spatial/source-run","value":"p2-i125","start":428,"end":430},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i128","type":"spatial/source-run","value":"p2-i128","start":431,"end":481},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i132","type":"spatial/source-run","value":"p2-i132","start":483,"end":494},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i133","type":"spatial/source-run","value":"p2-i133","start":496,"end":505},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i134","type":"spatial/source-run","value":"p2-i134","start":507,"end":526},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i136","type":"spatial/source-run","value":"p2-i136","start":528,"end":576},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i138","type":"spatial/source-run","value":"p2-i138","start":578,"end":628},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i141","type":"spatial/source-run","value":"p2-i141","start":630,"end":677},{"id":"folio-987545ffb087f1ece898-p2-b11-0-p2-i142","type":"spatial/source-run","value":"p2-i142","start":678,"end":681}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":311.88,"width":218.28,"height":199.5},"fontSize":10.91,"lineCount":15,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"When integrating contextual word embeddings with existing task-specific architectures, ELMo advances the state of the art for several major NLP benchmarks (Peters et al., 2018a) including question answering (Rajpurkar et al., 2016), sentiment analysis (Socher et al., 2013), and named entity recognition (Tjong Kim Sang and De Meulder, 2003). Melamud et al. (2016) proposed learning contextual representations through a task to predict a single word from both left and right context using LSTMs. Similar to ELMo, their model is feature-based and not deeply bidirectional. Fedus et al. (2018) shows that the cloze task can be used to improve the robustness of text generation models."}]},{"id":"folio-987545ffb087f1ece898-p2-b12-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b12-0-p2-i145","type":"spatial/source-run","value":"p2-i145","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p2-b12-0-bold-p2-i145","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p2-b12-0-p2-i146","type":"spatial/source-run","value":"p2-i146","start":4,"end":38},{"id":"folio-987545ffb087f1ece898-p2-b12-0-bold-p2-i146","type":"style/bold","start":4,"end":38}],"metadata":{"folio":{"kind":"heading","frame":{"x":307.28,"y":529.69,"width":203.38,"height":9.82},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"2.2 Unsupervised Fine-tuning Approaches"}]},{"id":"folio-987545ffb087f1ece898-p2-b13-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i148","type":"spatial/source-run","value":"p2-i148","start":0,"end":6},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i149","type":"spatial/source-run","value":"p2-i149","start":8,"end":10},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i150","type":"spatial/source-run","value":"p2-i150","start":12,"end":24},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i151","type":"spatial/source-run","value":"p2-i151","start":26,"end":36},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i152","type":"spatial/source-run","value":"p2-i152","start":38,"end":40},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i153","type":"spatial/source-run","value":"p2-i153","start":42,"end":46},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i156","type":"spatial/source-run","value":"p2-i156","start":48,"end":95},{"id":"folio-987545ffb087f1ece898-p2-b13-0-p2-i162",