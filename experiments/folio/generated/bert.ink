nd":356}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":325.82,"width":218.27,"height":104.65},"fontSize":10.91,"lineCount":8,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"Compared to pre-training, fine-tuning is relatively inexpensive. All of the results in the paper can be replicated in at most 1 hour on a single Cloud TPU, or a few hours on a GPU, starting from the exact same pre-trained model.7 We describe the task-specific details in the corresponding subsections of Section 4. More details can be found in Appendix A.5."}]},{"id":"folio-987545ffb087f1ece898-p5-b14-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b14-0-p5-i113","type":"spatial/source-run","value":"p5-i113","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p5-b14-0-bold-p5-i113","type":"style/bold","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p5-b14-0-p5-i114","type":"spatial/source-run","value":"p5-i114","start":2,"end":12},{"id":"folio-987545ffb087f1ece898-p5-b14-0-bold-p5-i114","type":"style/bold","start":2,"end":12}],"metadata":{"folio":{"kind":"heading","frame":{"x":307.28,"y":442.98,"width":83.02,"height":10.76},"fontSize":11.96,"lineCount":1,"leading":13.51,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4 Experiments"}]},{"id":"folio-987545ffb087f1ece898-p5-b15-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b15-0-p5-i116","type":"spatial/source-run","value":"p5-i116","start":0,"end":46},{"id":"folio-987545ffb087f1ece898-p5-b15-0-p5-i119","type":"spatial/source-run","value":"p5-i119","start":47,"end":68}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":464.06,"width":218.27,"height":23.36},"fontSize":10.91,"lineCount":2,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"In this section, we present BERT fine-tuning results on 11 NLP tasks."}]},{"id":"folio-987545ffb087f1ece898-p5-b16-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b16-0-p5-i126","type":"spatial/source-run","value":"p5-i126","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p5-b16-0-bold-p5-i126","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p5-b16-0-p5-i127","type":"spatial/source-run","value":"p5-i127","start":4,"end":7},{"id":"folio-987545ffb087f1ece898-p5-b16-0-bold-p5-i127","type":"style/bold","start":4,"end":7}],"metadata":{"folio":{"kind":"heading","frame":{"x":307.28,"y":499.27,"width":55.46,"height":9.82},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4.1 GLUE"}]},{"id":"folio-987545ffb087f1ece898-p5-b17-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i134","type":"spatial/source-run","value":"p5-i134","start":0,"end":44},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i136","type":"spatial/source-run","value":"p5-i136","start":46,"end":91},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i138","type":"spatial/source-run","value":"p5-i138","start":92,"end":140},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i140","type":"spatial/source-run","value":"p5-i140","start":142,"end":190},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i144","type":"spatial/source-run","value":"p5-i144","start":192,"end":216},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i149","type":"spatial/source-run","value":"p5-i149","start":218,"end":261},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i155","type":"spatial/source-run","value":"p5-i155","start":263,"end":275},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i156","type":"spatial/source-run","value":"p5-i156","start":277,"end":282},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i157","type":"spatial/source-run","value":"p5-i157","start":284,"end":310},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i160","type":"spatial/source-run","value":"p5-i160","start":312,"end":326},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i161","type":"spatial/source-run","value":"p5-i161","start":328,"end":337},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i162","type":"spatial/source-run","value":"p5-i162","start":339,"end":355},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i163","type":"spatial/source-run","value":"p5-i163","start":357,"end":359},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i165","type":"spatial/source-run","value":"p5-i165","start":360,"end":369},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i166","type":"spatial/source-run","value":"p5-i166","start":371,"end":391},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i167","type":"spatial/source-run","value":"p5-i167","start":393,"end":405},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i168","type":"spatial/source-run","value":"p5-i168","start":407,"end":408},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i169","type":"spatial/source-run","value":"p5-i169","start":410,"end":412},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i170","type":"spatial/source-run","value":"p5-i170","start":414,"end":418},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i172","type":"spatial/source-run","value":"p5-i172","start":420,"end":466},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i176","type":"spatial/source-run","value":"p5-i176","start":467,"end":471},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i177","type":"spatial/source-run","value":"p5-i177","start":473,"end":513},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i179","type":"spatial/source-run","value":"p5-i179","start":515,"end":560},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i180","type":"spatial/source-run","value":"p5-i180","start":562,"end":562},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i189","type":"spatial/source-run","value":"p5-i189","start":564,"end":587},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i190","type":"spatial/source-run","value":"p5-i190","start":588,"end":628},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i193","type":"spatial/source-run","value":"p5-i193","start":629,"end":677},{"id":"folio-987545ffb087f1ece898-p5-b17-0-p5-i201","type":"spatial/source-run","value":"p5-i201","start":679,"end":707}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":516.83,"width":218.28,"height":199.86},"fontSize":10.91,"lineCount":15,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The General Language Understanding Evaluation (GLUE) benchmark (Wang et al., 2018a) is a collection of diverse natural language understanding tasks. Detailed descriptions of GLUE datasets are included in Appendix B.1. To fine-tune on GLUE, we represent the input sequence (for single sentence or sentence pairs) as described in Section 3, and use the final hidden vector $C\\in \\mathbb{R}^{H}$ corresponding to the first input token ([CLS]) as the aggregate representation. The only new parameters introduced during fine-tuning are classification layer weights W ∈ $\\mathbb{R}^{K\\times H}$, where K is the number of labels. We compute a standard classification loss with C and W, i.e., log(softmax$(CW^{T})$)."}]},{"id":"folio-987545ffb087f1ece898-p5-b18-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b18-0-p5-i203","type":"spatial/source-run","value":"p5-i203","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p5-b18-0-p5-i205","type":"spatial/source-run","value":"p5-i205","start":1,"end":51},{"id":"folio-987545ffb087f1ece898-p5-b18-0-p5-i206","type":"spatial/source-run","value":"p5-i206","start":53,"end":108},{"id":"folio-987545ffb087f1ece898-p5-b18-0-p5-i208","type":"spatial/source-run","value":"p5-i208","start":110,"end":127},{"id":"folio-987545ffb087f1ece898-p5-b18-0-p5-i210","type":"spatial/source-run","value":"p5-i210","start":129,"end":129},{"id":"folio-987545ffb087f1ece898-p5-b18-0-p5-i211","type":"spatial/source-run","value":"p5-i211","start":130,"end":171}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":724.3,"width":218.27,"height":40.6},"fontSize":8.97,"lineCount":4,"leading":9.96,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"7For example, the BERT SQuAD model can be trained in around 30 minutes on a single Cloud TPU to achieve a Dev F1 score of 91.0%. 8See (10) in https://gluebenchmark.com/faq."}]},{"id":"folio-987545ffb087f1ece898-p5-b11-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p5-b11-0-p5-i212","type":"spatial/source-run","value":"p5-i212","start":0,"end":3}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":287.86,"y":778.14,"width":21.82,"height":9.86},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4175"}]},{"id":"folio-987545ffb087f1ece898-p6","type":"page-block","properties":{"metadata":{"folio":{"number":6,"width":595.2760009765625,"height":841.8900146484375,"rules":[{"x":72,"y":153.53204345703125,"width":453.54296875,"height":0.8730010986328125}]}}},"children":[{"placementId":"folio-placement-folio-987545ffb087f1ece898-p6-b0-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p6-b0-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p6-b2-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p6-b2-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p6-b3-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p6-b3-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p6-b5-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p6-b5-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p6-b6-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p6-b6-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p6-b7-0","kind":"owned",