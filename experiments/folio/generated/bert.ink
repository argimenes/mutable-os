e":"p8-i228","start":341,"end":347},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i229","type":"spatial/source-run","value":"p8-i229","start":349,"end":353},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i230","type":"spatial/source-run","value":"p8-i230","start":355,"end":359},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i231","type":"spatial/source-run","value":"p8-i231","start":361,"end":364},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i233","type":"spatial/source-run","value":"p8-i233","start":366,"end":370},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i234","type":"spatial/source-run","value":"p8-i234","start":372,"end":373},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i235","type":"spatial/source-run","value":"p8-i235","start":375,"end":412},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i237","type":"spatial/source-run","value":"p8-i237","start":414,"end":419},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i238","type":"spatial/source-run","value":"p8-i238","start":421,"end":428},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i239","type":"spatial/source-run","value":"p8-i239","start":430,"end":433},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i240","type":"spatial/source-run","value":"p8-i240","start":435,"end":437},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i241","type":"spatial/source-run","value":"p8-i241","start":439,"end":443},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i242","type":"spatial/source-run","value":"p8-i242","start":445,"end":447},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i243","type":"spatial/source-run","value":"p8-i243","start":449,"end":458},{"id":"folio-987545ffb087f1ece898-p8-b13-0-p8-i246","type":"spatial/source-run","value":"p8-i246","start":459,"end":510}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":307.28,"y":620.02,"width":218.28,"height":145.31},"fontSize":10.91,"lineCount":11,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"It has long been known that increasing the model size will lead to continual improvements on large-scale tasks such as machine translation and language modeling, which is demonstrated by the LM perplexity of held-out training data shown in Table 6. However, we believe that this is the first work to demonstrate convincingly that scaling to extreme model sizes also leads to large improvements on very small scale tasks, provided that the model has been sufficiently pre-trained. Peters et al. (2018b) presented"}]},{"id":"folio-987545ffb087f1ece898-p8-b10-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p8-b10-0-p8-i247","type":"spatial/source-run","value":"p8-i247","start":0,"end":3}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":287.86,"y":778.25,"width":21.82,"height":9.75},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4178"}]},{"id":"folio-987545ffb087f1ece898-p9","type":"page-block","properties":{"metadata":{"folio":{"number":9,"width":595.2760009765625,"height":841.8900146484375,"rules":[{"x":317.0150146484375,"y":78.8480224609375,"width":198.7879638671875,"height":0.5449981689453125},{"x":317.0150146484375,"y":114.2130126953125,"width":198.7879638671875,"height":0.5449981689453125},{"x":317.0150146484375,"y":149.57904052734375,"width":198.7879638671875,"height":0.5449981689453125},{"x":317.0150146484375,"y":224.9580078125,"width":198.7879638671875,"height":0.8730010986328125},{"x":85.56999969482422,"y":603.3049926757812,"width":191.12698364257812,"height":0.87298583984375},{"x":85.56999969482422,"y":699.7650146484375,"width":191.12698364257812,"height":0.87298583984375}]}}},"children":[{"placementId":"folio-placement-folio-987545ffb087f1ece898-p9-b0-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p9-b0-0"}},{"placementId":"folio-placement-folio-987545ffb087f1ece898-p9-b2-0","kind":"owned","target":{"kind":"local","blockId":"folio-987545ffb087f1ece898-p