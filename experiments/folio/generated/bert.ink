-p13-i158","type":"spatial/source-run","value":"p13-i158","start":96,"end":103},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i159","type":"spatial/source-run","value":"p13-i159","start":105,"end":143},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i161","type":"spatial/source-run","value":"p13-i161","start":144,"end":192},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i162","type":"spatial/source-run","value":"p13-i162","start":194,"end":210},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i163","type":"spatial/source-run","value":"p13-i163","start":212,"end":244},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i166","type":"spatial/source-run","value":"p13-i166","start":246,"end":290},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i168","type":"spatial/source-run","value":"p13-i168","start":291,"end":341},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i170","type":"spatial/source-run","value":"p13-i170","start":343,"end":391},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i172","type":"spatial/source-run","value":"p13-i172","start":393,"end":442},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i175","type":"spatial/source-run","value":"p13-i175","start":443,"end":491},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i178","type":"spatial/source-run","value":"p13-i178","start":492,"end":538},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i180","type":"spatial/source-run","value":"p13-i180","start":540,"end":586},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i182","type":"spatial/source-run","value":"p13-i182","start":587,"end":633},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i183","type":"spatial/source-run","value":"p13-i183","start":634,"end":670},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i186","type":"spatial/source-run","value":"p13-i186","start":672,"end":717},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i189","type":"spatial/source-run","value":"p13-i189","start":719,"end":764},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i191","type":"spatial/source-run","value":"p13-i191","start":766,"end":768},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i192","type":"spatial/source-run","value":"p13-i192","start":770,"end":785},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i193","type":"spatial/source-run","value":"p13-i193","start":787,"end":794},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i194","type":"spatial/source-run","value":"p13-i194","start":796,"end":808},{"id":"folio-987545ffb087f1ece898-p13-b20-0-p13-i195","type":"spatial/source-run","value":"p13-i195","start":810,"end":811}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":538.36,"width":218.27,"height":226.97},"fontSize":10.91,"lineCount":17,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"To generate each training input sequence, we sample two spans of text from the corpus, which we refer to as \"sentences\" even though they are typically much longer than single sentences (but can be shorter also). The first sentence receives the A embedding and the second receives the B embedding. 50% of the time B is the actual next sentence that follows A and 50% of the time it is a random sentence, which is done for the \"next sentence prediction\" task. They are sampled such that the combined length is ≤ 512 tokens. The LM masking is applied after WordPiece tokenization with a uniform masking rate of 15%, and no special consideration given to partial word pieces. We train with batch size of 256 sequences (256 sequences * 512 tokens = 128,000 tokens/batch) for 1,000,000 steps, which is approximately 40"}]},{"id":"folio-987545ffb087f1ece898-p13-b21-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p13-b21-0-p13-i75","type":"spatial/source-run","value":"p13-i75","start":0,"end":5},{"id":"folio-987545ffb087f1ece898-p13-b21-0-p13-i76","type":"spatial/source-run","value":"p13-i76","start":7,"end":10},{"id":"folio-987545ffb087f1ece898-p13-b21-0-p13-i77","