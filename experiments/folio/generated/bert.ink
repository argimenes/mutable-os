i140","type":"spatial/source-run","value":"p6-i140","start":943,"end":950},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i141","type":"spatial/source-run","value":"p6-i141","start":952,"end":972},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i142","type":"spatial/source-run","value":"p6-i142","start":974,"end":988},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i144","type":"spatial/source-run","value":"p6-i144","start":990,"end":1035},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i146","type":"spatial/source-run","value":"p6-i146","start":1037,"end":1082},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i155","type":"spatial/source-run","value":"p6-i155","start":1084,"end":1114},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i158","type":"spatial/source-run","value":"p6-i158","start":1116,"end":1159},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i160","type":"spatial/source-run","value":"p6-i160","start":1160,"end":1209},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i162","type":"spatial/source-run","value":"p6-i162","start":1211,"end":1241},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i163","type":"spatial/source-run","value":"p6-i163","start":1243,"end":1261},{"id":"folio-987545ffb087f1ece898-p6-b3-0-p6-i165","type":"spatial/source-run","value":"p6-i165","start":1263,"end":1310}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":252.12,"width":218.28,"height":376.88},"fontSize":10.91,"lineCount":28,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"We use a batch size of 32 and fine-tune for 3 epochs over the data for all GLUE tasks. For each task, we selected the best fine-tuning learning rate (among 5e-5, 4e-5, 3e-5, and 2e-5) on the Dev set. Additionally, for BERT LARGE we found that finetuning was sometimes unstable on small datasets, so we ran several random restarts and selected the best model on the Dev set. With random restarts, we use the same pre-trained checkpoint but perform different fine-tuning data shuffling and classifier layer initialization.9 Results are presented in Table 1. Both BERT BASE and BERT LARGE outperform all systems on all tasks by a substantial margin, obtaining 4.5% and 7.0% respective average accuracy improvement over the prior state of the art. Note that BERT BASE and OpenAI GPT are nearly identical in terms of model architecture apart from the attention masking. For the largest and most widely reported GLUE task, MNLI, BERT obtains a 4.6% absolute accuracy improvement. On the official GLUE leaderboard10, BERT LARGE obtains a score of 80.5, compared to OpenAI GPT, which obtains 72.8 as of the date of writing. We find that BERT LARGE significantly outperforms BERT BASE across all tasks, especially those with very little training data. The effect of model size is explored more thoroughly in Section 5.2."}]},{"id":"folio-987545ffb087f1ece898-p6-b5-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p6-b5-0-p6-i170","type":"spatial/source-run","value":"p6-i170","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p6-b5-0-bold-p6-i170","type":"style/bold","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p6-b5-0-p6-i171","type":"spatial/source-run","value":"p6-i171","start":4,"end":13},{"id":"folio-987545ffb087f1ece898-p6-b5-0-bold-p6-i171","type":"style/bold","start":4,"end":13}],"metadata":{"folio":{"kind":"heading","frame":{"x":72,"y":643.6,"width":82.73,"height":9.83},"fontSize":10.91,"lineCount":1,"leading":12.33,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"4.2 SQuAD v1.1"}]},{"id":"folio-987545ffb087f1ece898-p6-b6-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i174","type":"spatial/source-run","value":"p6-i174","start":0,"end":2},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i175","type":"spatial/source-run","value":"p6-i175","start":4,"end":11},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i176","type":"spatial/source-run","value":"p6-i176","start":13,"end":20},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i177","type":"spatial/source-run","value":"p6-i177","start":22,"end":30},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i178","type":"spatial/source-run","value":"p6-i178","start":32,"end":38},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i180","type":"spatial/source-run","value":"p6-i180","start":40,"end":54},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i181","type":"spatial/source-run","value":"p6-i181","start":56,"end":56},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i182","type":"spatial/source-run","value":"p6-i182","start":58,"end":67},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i183","type":"spatial/source-run","value":"p6-i183","start":69,"end":75},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i184","type":"spatial/source-run","value":"p6-i184","start":77,"end":81},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i186","type":"spatial/source-run","value":"p6-i186","start":82,"end":110},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i187","type":"spatial/source-run","value":"p6-i187","start":112,"end":121},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i188","type":"spatial/source-run","value":"p6-i188","start":123,"end":124},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i189","type":"spatial/source-run","value":"p6-i189","start":126,"end":129},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i194","type":"spatial/source-run","value":"p6-i194","start":131,"end":136},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i195","type":"spatial/source-run","value":"p6-i195","start":138,"end":142},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i196","type":"spatial/source-run","value":"p6-i196","start":144,"end":144},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i197","type":"spatial/source-run","value":"p6-i197","start":146,"end":153},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i198","type":"spatial/source-run","value":"p6-i198","start":155,"end":157},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i199","type":"spatial/source-run","value":"p6-i199","start":159,"end":159},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i200","type":"spatial/source-run","value":"p6-i200","start":161,"end":167},{"id":"folio-987545ffb087f1ece898-p6-b6-0-p6-i201","type":"spatial/source-run","value":"p6-i201","start":169,"end":172}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":662.39,"width":218.28,"height":50.47},"fontSize":10.91,"lineCount":4,"leading":13.55,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"The Stanford Question Answering Dataset (SQuAD v1.1) is a collection of 100k crowdsourced question/answer pairs (Rajpurkar et al., 2016). Given a question and a passage from"}]},{"id":"folio-987545ffb087f1ece898-p6-b7-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p6-b7-0-p6-i203","type":"spatial/source-run","value":"p6-i203","start":0,"end":0},{"id":"folio-987545ffb087f1ece898-p6-b7-0-p6-i204","type":"spatial/source-run","value":"p6-i204","start":1,"end":56},{"id":"folio-987545ffb087f1ece898-p6-b7-0-p6-i206","type":"spatial/source-run","value":"p6-i206","start":58,"end":64},{"id":"folio-987545ffb087f1ece898-p6-b7-0-p6-i207","type":"spatial/source-run","value":"p6-i207","start":66,"end":113},{"id":"folio-987545ffb087f1ece898-p6-b7-0-p6-i208","type":"spatial/source-run","value":"p6-i208","start":115,"end":160}],"metadata":{"folio":{"kind":"paragraph","frame":{"x":72,"y":724.3,"width":218.29,"height":30.07},"fontSize":8.97,"lineCount":3,"leading":11.7,"family":"serif","align":"left"}}},"inline":[{"kind":"text","text":"9The GLUE data set distribution does not include the Test labels, and we only made a single GLUE evaluation server submission for each of BERTBASE and BERTLARGE."}]},{"id":"folio-987545ffb087f1ece898-p6-b8-0","type":"standoff-editor-block","properties":{"standoffProperties":[{"id":"folio-987545ffb087f1ece898-p6-b8-0-p6-i211","type":"spatial/source-run","value":"p6-i211","start":0,"end