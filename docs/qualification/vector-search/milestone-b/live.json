        },
        {
          "text": "Here's my position: an object remains the same object as long as its history is continuous, even if none of its original material survives. Physical composition is irrelevant to identity.",
          "signals": {
            "rrf": 0.03225806451612903,
            "cosineDistance": 0.48234909772872925,
            "bm25": -9.434875740546442
          },
          "source": {
            "vaultGuid": "f8a5e173-a79e-42f5-ad40-874973df77a6",
