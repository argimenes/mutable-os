      "composition": [
        {
          "id": "new:b1",
          "kind": "paragraph",
          "markup": "Museum interpretations can change because <annotation type=\"style/bold\">new evidence</annotation>, new questions, and new social perspectives alter how people understand the same object. They remain accountable to evidence when those interpretations are still tested against the object itself, its provenance, historical records, and comparable material rather than being treated as mere opinion.",
          "ranges": [],
          "textStyle": null,
          "margins": null
        },
        {
          "id": "new:b2",
          "kind": "paragraph",
          "markup": "To call an object <annotation type=\"style/italics\" id=\"new:s1\">authentic</annotation> usually means it is genuinely what it is claimed to be, with a traceable history and credible relation to its original time, maker, use, or cultural context. That does not always mean perfectly unchanged; an object may still be authentic even if it has aged, been repaired, or been reinterpreted, so long as those claims are honestly supported by evidence.",
          "ranges": [],
          "textStyle": null,
          "margins": null
        }
      ],
      "anchors": [],
      "entities": [],
      "interpretations": [],
      "arguments": [],
      "glosses": [
        {
          "id": "new:g1",
          "target": "new:s1",
          "type": "definition",
          "text": "In museum work, authenticity is an evidence-based judgment about identity and history, not simply a claim that the object looks old or original."
        }
      ],
      "relations": [],
      "suggestions": [],
      "promotionRecommendations": []
    },
