    "prompt": "Why can museum interpretations change while remaining accountable to evidence? Explain briefly, including what it means to call an object authentic.",
    "reasoning": "provider default",
    "maxOutputTokens": 2048,
    "continuity": false,
    "nativeAdmitted": true,
    "repaired": false,
    "response": {
